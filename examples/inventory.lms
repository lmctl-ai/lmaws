# AWS service inventory. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("inventory");
let csv = "service,count\n";
let buckets_rows = cloud.buckets();
let buckets_count = buckets_rows.len();
if (cloud.is_demo()) { check(buckets_count == 3); }
csv = csv + "buckets," + str(buckets_count) + "\n";
let instances_rows = cloud.instances();
let instances_count = instances_rows.len();
if (cloud.is_demo()) { check(instances_count == 3); }
csv = csv + "instances," + str(instances_count) + "\n";
let vpcs_rows = cloud.vpcs();
let vpcs_count = vpcs_rows.len();
if (cloud.is_demo()) { check(vpcs_count == 3); }
csv = csv + "vpcs," + str(vpcs_count) + "\n";
let security_groups_rows = cloud.security_groups();
let security_groups_count = security_groups_rows.len();
if (cloud.is_demo()) { check(security_groups_count == 3); }
csv = csv + "security_groups," + str(security_groups_count) + "\n";
file_write("data/inventory.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/inventory.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'AWS service inventory'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/inventory.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "inventory-aws.dslb");
r = system ${dsl_cli(aws)} --lmcode "inventory-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "inventory-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode "inventory-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/inventory.png");
println(cost_line);
