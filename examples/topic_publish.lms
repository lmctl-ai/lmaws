# Create one SNS topic, publish one tiny message, and tear it down.
mkdir("images"); mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("topic_publish");
let run = cloud.example_run();
let topic = run.topic("sample");
run.put(topic, "message", "lmaws tiny example message");
let created = run.remaining();
let published = 1;
check(created == 1);
run.cleanup();
let cleaned = run.remaining();
check(cleaned == 0);
file_write("data/topic_publish.csv", "phase,count\ncreated," + str(created) + "\npublished," + str(published) + "\ncleaned," + str(cleaned) + "\n");
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/topic_publish.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Tiny topic publish'; set style data histograms; set style fill solid 0.8");
plot.cmd("plot 'data/topic_publish.csv' every ::1 using 2:xtic(1) title 'owned SNS state' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "topic_publish-aws.dslb");
r = system ${dsl_cli(aws)} --lmcode "topic_publish-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "topic_publish-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode "topic_publish-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/topic_publish.png");
println(cost_line);
