      let balance = 0; let surplus = 0; let charged = 0; let used = 0; let used_n = 0; let cpu = 0; let cpu_n = 0;
      for (m in metrics) {
        if (m.instance != id) { continue; }
        if (m.metric == "CPUCreditBalance" && m.average != "") { balance = num(m.average); }
        if (m.metric == "CPUSurplusCreditBalance" && m.average != "") { surplus = num(m.average); }
        if (m.metric == "CPUSurplusCreditsCharged" && m.sum != "") { charged = charged + num(m.sum); }
        if (m.metric == "CPUCreditUsage" && m.sum != "") { used = used + num(m.sum); used_n = used_n + 1; }
        if (m.metric == "CPUUtilization" && m.average != "") { cpu = cpu + num(m.average); cpu_n = cpu_n + 1; }
      }
      let per_hour = used_n == 0 ? 0 : used / used_n;
      let net = spec.earn_per_hour - per_hour;
      push(rows, {kind:"cpu_credits", name:names[id], type:types[id], baseline_pct:spec.baseline_pct, earn_per_hour:spec.earn_per_hour,
        balance:_compute_r(balance, 1), max_balance:spec.max_balance, headroom_pct:_compute_r(100 * balance / spec.max_balance, 1),
        used_per_hour:_compute_r(per_hour, 2), avg_cpu_pct:_compute_r(cpu_n == 0 ? 0 : cpu / cpu_n, 1),
        surplus_balance:_compute_r(surplus, 1), surplus_charged:_compute_r(charged, 2),
        hours_to_empty: net >= 0 ? "accruing" : str(_compute_r(balance / (0 - net), 1))});
    }
  }
  return merge(_compute_save(o, out, {rows:rows, hours:o.hours, synthetic:!o.live, note:"credits from CloudWatch AWS/EC2 hourly statistics; no SSH; surplus credits are billed separately and not covered by Savings Plans"}), {result:result, output_file:out + ".json"});
}

