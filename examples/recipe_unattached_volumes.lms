    report.seconds_to_running = num(running.seconds); report.seconds_to_status_ok = num(running.seconds) + num(checks.seconds);
    report.status_checks = checks.system_status + "/" + checks.instance_status; report.stop_result = stop.status;
    report.seconds_to_terminated = num(down.seconds); report.final_state = down.state;
