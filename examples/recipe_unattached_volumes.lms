fn recipe_spot_prices(options) {
  let o = recipe_normalize(options);
  if (o.preview) { return recipe_preview(o, "spot_prices"); }
  let out = _compute_output(o, "spot_prices");
  let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_spot_prices");
file_write(${out + ".raw.json"}, cloud.spot_prices(${o.types}, ${o.hours}).json());
end _dsl_
  let result = recipe_run(p, o);
  let prices = json_parse(read_file(out + ".raw.json"));
  let cheapest = [];
  for (type in split(o.types, ",")) {
    let best = {}; let n = 0;
    for (row in prices) {
      if (row.type != type) { continue; }
      n = n + 1;
      if (!has_key(best, "price") || num(row.price) < num(best.price)) { best = row; }
    }
    if (n > 0) {
      let od = best.on_demand == "" ? 0 : num(best.on_demand);
      push(cheapest, {kind:"cheapest", type:type, az:best.az, price:num(best.price), on_demand:od, saving_pct: od == 0 ? 0 : _compute_r(100 * (1 - num(best.price) / od), 1), zones:n});
    }
  }
  return merge(_compute_save(o, out, {rows:cheapest, prices:prices, hours:o.hours, synthetic:!o.live, product:"Linux/UNIX"}), {result:result, output_file:out + ".json"});
}

fn recipe_ebs_roots(options) {
  let o = recipe_normalize(options);
  if (o.preview) { return recipe_preview(o, "ebs_roots"); }
  let out = _compute_output(o, "ebs_roots");
  let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_ebs_roots");
file_write(${out + ".volumes.raw.json"}, cloud.volumes().json());
file_write(${out + ".instances.raw.json"}, cloud.ec2_instances("", "").json());
end _dsl_
  let result = recipe_run(p, o);
  let instances = json_parse(read_file(out + ".instances.raw.json"));
  let rows = []; let gib = 0;
  for (v in json_parse(read_file(out + ".volumes.raw.json"))) {
    let owner = _compute_find(instances, "id", get(v, "instance", ""));
    let root = get(owner, "root_device", "") != "" && get(owner, "root_device", "") == get(v, "device", "");
    let size = num(get(v, "size_gib", "0")); gib = gib + size;
    push(rows, {kind:"volume", name:get(v,"name",""), az:get(v,"az",""), size_gib:size, type:get(v,"type",""), state:get(v,"state",""),
      attached_to:get(owner,"name",get(v,"instance","")), root:root, delete_on_termination:get(v,"delete_on_termination",""), monthly_usd:_compute_r(size * 0.08, 2),
      az_lock:"attachable only to instances in " + get(v,"az",""),
      note: get(v,"state","") == "available" ? "unattached: still billed" : (get(v,"delete_on_termination","") == "false" ? "survives instance termination" : "deleted with its instance")});
  }
  return merge(_compute_save(o, out, {rows:rows, total_gib:gib, monthly_usd:_compute_r(gib * 0.08, 2), synthetic:!o.live, note:"EBS volumes live in one Availability Zone; a root kept with DeleteOnTermination=false can only boot an instance launched in that same AZ"}), {result:result, output_file:out + ".json"});
}

fn _spot_pick(prices, subnets, type, skip_az) {
  let best = {};
  for (row in prices) {
    if (row.type != type || row.az == skip_az) { continue; }
    let subnet = {};
    for (s in subnets) { if (s.az == row.az && s.default_vpc == "true" && s.default_for_az == "true" && s.fleet == "false") { subnet = s; } }
    if (!has_key(subnet, "id")) { continue; }
    if (!has_key(best, "price") || num(row.price) < num(best.price)) { best = merge(row, {subnet:subnet.id, vpc:subnet.vpc}); }
  }
  if (has_key(best, "price")) { best.max_price = min(num(best.on_demand), _compute_r(num(best.price) * 1.5, 6)); }
  return best;
}

