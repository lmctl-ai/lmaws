plot.png(${"images/"+name+".png"},900,560);
plot.cmd(${"set datafile separator ','; set title '"+chart_title+"'; unset key; set style data histograms; set style fill solid 0.8; set boxwidth 0.6; set yrange [0:"+str(max_count+1)+"]; set ytics 1; set ylabel 'count of resources'; set grid ytics; set xtics rotate by -30"});
plot.cmd(${"plot 'data/"+name+".csv' every ::1 using 2:xtic(1) lc rgb '#5db7d1'"});
plot.close();
end _dsl_
  let code=temp_file();savedsl(chart,code);let r=system(concat(dsl_cli(chart),["--lmcode",code]),{timeoutMs:120000});remove_file(code);assert(r.code==0);
  println("images/"+name+".png");
}


fn _compute_output(o, name) {
  let out = str(o.output);
  if (o.live && !o.output_explicit) { out = ".lmaws-local/compute/" + name; }
  mkdir(dirname(out), true);
  return out;
}
fn _compute_r(x, digits) { let f = pow(10, digits); return round(x * f) / f; }
fn _compute_save(o, out, report) {
  write_file(out + ".json", json_stringify(report, 2));
  write_csv(out + ".csv", report.rows);
  return report;
}
fn _compute_find(rows, key, value) {
  for (row in rows) { if (str(get(row, key, "")) == value) { return row; } }
  return {};
}

fn recipe_burst_spec(type) {
  let parts = split(type, ".");
  if (len(parts) != 2 || !contains(["t2","t3","t3a","t4g"], parts[0])) { return {burstable:false}; }
  let size = parts[1];
  let table = {nano:[2,5], micro:[2,10], small:[2,20], medium:[2,20], large:[2,30], xlarge:[4,40], "2xlarge":[8,40]};
  if (!has_key(table, size)) { return {burstable:false}; }
  let spec = table[size];
  let earn = spec[0] * spec[1] * 60 / 100;
  return {burstable:true, vcpus:spec[0], baseline_pct:spec[1], earn_per_hour:earn, max_balance:earn * 24};
}

fn recipe_fleet_status(options) {
