      private_ip:get(i,"private_ip",""), public_ip:get(i,"public_ip",""), elastic_ip:get(eip,"public_ip",""), market:get(i,"market",""),
      root_size_gib:get(i,"root_size_gib",""), root_type:get(i,"root_type",""),
      storage_policy: get(i,"root_volume","")=="" ? "no root volume attached" : (keep ? "root kept when the instance terminates" : "root deleted when the instance terminates")});
  }
  return merge(_compute_save(o, out, {rows:recipe_select(rows, o), instance_count:len(rows), synthetic:!o.live, tag_key:o.tag_key, tag_value:o.tag_value, read_only:true}), {result:result, output_file:out + ".json"});
}

fn recipe_cpu_credits(options) {
  let o = recipe_normalize(options);
  if (o.preview) { return recipe_preview(o, "cpu_credits"); }
  let out = _compute_output(o, "cpu_credits");
  let fleet = recipe_fleet_status(merge(o, {output:out + ".fleet", output_explicit:true, top:1000}));
  let ids = []; let names = {}; let types = {};
  for (row in json_parse(read_file(out + ".fleet.instances.raw.json"))) {
    let wanted = o.instance == "" || get(row,"id","") == o.instance || get(row,"name","") == o.instance;
    if (wanted && get(row,"state","") == "running" && get(recipe_burst_spec(get(row,"type","")), "burstable", false) && len(ids) < 20) {
      push(ids, row.id); names[row.id] = get(row,"name","") == "" ? row.id : row.name; types[row.id] = row.type;
    }
