# Synthetic-only: Create and tear down one owned parameter with its run ledger.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_sandbox_parameter.lms
import "../recipes/lib/lifecycle.lms";
let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="parameter";options.output="data/recipe_sandbox_parameter";
let report=recipe_lifecycle(options);
assert(is_array(report.rows));
assert(len(report.rows)==1 && report.rows[0].remaining==0);
report.rows[0].name="owned synthetic parameter";
recipe_picture(report.rows,"Create and tear down one owned parameter with its run ledger","recipe_sandbox_parameter");
