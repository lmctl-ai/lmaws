# Secret metadata redaction: derived from fields in the host rows.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("secrets");
let rows = cloud.secrets();
if (cloud.is_demo()) { check(rows.len() == 3); }
let a_count = rows.count("value", "[redacted]");
let b_count = rows.len() - a_count;
if (cloud.is_demo()) { check(a_count == 3); }
check(b_count == 0);
let csv = "category,count\n[redacted]," + str(a_count) + "\nmissing," + str(b_count) + "\n";
file_write("data/secrets.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/secrets.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Secret metadata redaction'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65");
plot.cmd("plot 'data/secrets.csv' every ::1 using 2:xtic(1) title 'rows' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "secrets-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "secrets-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "secrets-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "secrets-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/secrets.png");
println(cost_line);
