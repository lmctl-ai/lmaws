# Service coverage matrix. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.demo();
let csv = "service,count\n";
let buckets_rows = cloud.buckets();
let buckets_count = buckets_rows.len();
check(buckets_count == 3);
csv = csv + "buckets," + str(buckets_count) + "\n";
let instances_rows = cloud.instances();
let instances_count = instances_rows.len();
check(instances_count == 3);
csv = csv + "instances," + str(instances_count) + "\n";
let vpcs_rows = cloud.vpcs();
let vpcs_count = vpcs_rows.len();
check(vpcs_count == 3);
csv = csv + "vpcs," + str(vpcs_count) + "\n";
let security_groups_rows = cloud.security_groups();
let security_groups_count = security_groups_rows.len();
check(security_groups_count == 3);
csv = csv + "security_groups," + str(security_groups_count) + "\n";
let tables_rows = cloud.tables();
let tables_count = tables_rows.len();
check(tables_count == 3);
csv = csv + "tables," + str(tables_count) + "\n";
let queues_rows = cloud.queues();
let queues_count = queues_rows.len();
check(queues_count == 3);
csv = csv + "queues," + str(queues_count) + "\n";
let topics_rows = cloud.topics();
let topics_count = topics_rows.len();
check(topics_count == 3);
csv = csv + "topics," + str(topics_count) + "\n";
let functions_rows = cloud.functions();
let functions_count = functions_rows.len();
check(functions_count == 3);
csv = csv + "functions," + str(functions_count) + "\n";
let log_groups_rows = cloud.log_groups();
let log_groups_count = log_groups_rows.len();
check(log_groups_count == 3);
csv = csv + "log_groups," + str(log_groups_count) + "\n";
let alarms_rows = cloud.alarms();
let alarms_count = alarms_rows.len();
check(alarms_count == 3);
csv = csv + "alarms," + str(alarms_count) + "\n";
let zones_rows = cloud.zones();
let zones_count = zones_rows.len();
check(zones_count == 3);
csv = csv + "zones," + str(zones_count) + "\n";
let secrets_rows = cloud.secrets();
let secrets_count = secrets_rows.len();
check(secrets_count == 3);
csv = csv + "secrets," + str(secrets_count) + "\n";
let parameters_rows = cloud.parameters();
let parameters_count = parameters_rows.len();
check(parameters_count == 3);
csv = csv + "parameters," + str(parameters_count) + "\n";
let clusters_rows = cloud.clusters();
let clusters_count = clusters_rows.len();
check(clusters_count == 3);
csv = csv + "clusters," + str(clusters_count) + "\n";
let roles_rows = cloud.roles();
let roles_count = roles_rows.len();
check(roles_count == 3);
csv = csv + "roles," + str(roles_count) + "\n";
file_write("data/service_matrix.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/service_matrix.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Service coverage matrix'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/service_matrix.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "service_matrix-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "service_matrix-aws.dslb";
assert(r.code == 0);
savedsl(plot, "service_matrix-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "service_matrix-plot.dslb";
assert(r.code == 0);
println("images/service_matrix.png");
