fn host_run(program,args,timeout_ms) {
  let log=temp_file();
  set_env("LMAWS_LOG_FILE",log);set_env("LMAWS_DEADLINE_MS",timeout_ms>0 ? str(timeout_ms) : "");
  let e=run_lmcode(program,{args:args});
  set_env("LMAWS_LOG_FILE","");set_env("LMAWS_DEADLINE_MS","");
  let logged=read_file(log);remove_file(log);
  if(e.ok) {return {code:0,stdout:logged,stderr:""};}
  return {code:e.phase=="cli" ? 2 : e.phase=="app" ? 4 : 3,stdout:logged,stderr:str(e.code)+": "+str(e.message)};
}
let days = len(ARGV) > 0 ? num(ARGV[0]) : 30;
let top_n = len(ARGV) > 1 ? num(ARGV[1]) : 10;
let cap = len(ARGV) > 2 ? num(ARGV[2]) : 0.25;
mkdir("images");
mkdir("data");
let root = "data"; let image = "images";
if (getenv("LMAWS_SPEND_LIVE", "0") == "1" && getenv("LMAWS_LIVE", "0") == "1") { mkdir(".lmaws-local"); mkdir(".lmaws-local/spend"); root = ".lmaws-local/spend"; image = ".lmaws-local/spend"; }
aws = _lmcode_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let spend = aws.spend("eip_audit", ${days}, ${top_n}, str_to_float(str(${cap})));
spend.write(${root} + "/eip_audit");
end _lmcode_
r = host_run(aws, [], 900000);
let spend_stdout = r.stdout;
if (r.code != 0) { println(r.stdout); println(r.stderr); }
if (r.code != 0) { println(r.stdout); println(r.stderr); }
assert(r.code == 0);
copy_file(root + "/eip_audit/topic_chart.csv", root + "/eip_audit.csv");
plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${image} + "/eip_audit.png", 900, 560);
plot.cmd("set datafile separator ','; set style data histograms; set style fill solid 0.85; set key off; set xtics rotate by -25 font ',10'; set bmargin 7; set grid ytics; plot '" + ${root} + "/eip_audit/topic_chart.csv' using 2:xtic(1) title 'monthly saving USD'");
plot.close();
end _lmcode_
r = host_run(plot, [], 120000);
if (r.code != 0) { println(r.stdout); println(r.stderr); }
assert(r.code == 0);

let estimate_line = "";
for (line in lines(spend_stdout)) {
  if (starts_with(line, "Cost Explorer requests:") || starts_with(line, "CloudWatch metric requests:")) { println(line); }
  if (starts_with(line, "estimated cost: $")) { estimate_line = line; }
}
assert(starts_with(estimate_line, "estimated cost: $"));
println(estimate_line);
