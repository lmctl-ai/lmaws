fn recipe_ami_parameters() {
  return [
    {family:"Ubuntu 24.04", arch:"arm64", parameter:"/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"},
    {family:"Ubuntu 24.04", arch:"x86_64", parameter:"/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"},
    {family:"Amazon Linux 2023", arch:"arm64", parameter:"/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"},
    {family:"Amazon Linux 2023", arch:"x86_64", parameter:"/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"}];
}

