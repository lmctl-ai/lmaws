fn _spot_pick(prices, subnets, type, skip_az) {
  let best = {};
  for (row in prices) {
    if (row.type != type || row.az == skip_az) { continue; }
    let subnet = {};
    for (s in subnets) { if (s.az == row.az && s.default_vpc == "true" && s.default_for_az == "true" && s.fleet == "false") { subnet = s; } }
    if (!has_key(subnet, "id")) { continue; }
    if (!has_key(best, "price") || num(row.price) < num(best.price)) { best = merge(row, {subnet:subnet.id, vpc:subnet.vpc}); }
  }
  if (has_key(best, "price")) { best.max_price = min(num(best.on_demand), _compute_r(num(best.price) * 1.5, 6)); }
  return best;
}

fn recipe_spot_nano_lifecycle(options) {
  let o = recipe_normalize(options);
  if (o.preview) {
    let plan = recipe_preview(o, "spot_nano_lifecycle");
    println("plan: t4g.nano (fallback t3.nano) one-time spot, 8 GiB gp3 root deleted on termination, no public IPv4, new tagged security group without inbound rules, at most 10 minutes, cap $0.05");
    return plan;
  }
  assert(!o.live || (o.apply && o.profile == "lmaws-ec2"));
  let out = _compute_output(o, "spot_nano_lifecycle");
  let p1 = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_spot_plan");
file_write(${out + ".subnets.raw.json"}, cloud.subnets().json());
file_write(${out + ".prices.raw.json"}, cloud.spot_prices("t4g.nano,t3.nano", 3).json());
file_write(${out + ".ami_arm64.raw"}, cloud.public_parameter("/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"));
file_write(${out + ".ami_x86.raw"}, cloud.public_parameter("/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"));
end _dsl_
  recipe_run(p1, o);
  let subnets = json_parse(read_file(out + ".subnets.raw.json"));
  let prices = json_parse(read_file(out + ".prices.raw.json"));
  let arm = trim(read_file(out + ".ami_arm64.raw")); let x86 = trim(read_file(out + ".ami_x86.raw"));
  let first = _spot_pick(prices, subnets, "t4g.nano", "");
  let second = _spot_pick(prices, subnets, "t4g.nano", get(first, "az", "-"));
  let third = _spot_pick(prices, subnets, "t3.nano", "");
  if (!has_key(first, "price")) { first = third; }
  if (!has_key(second, "price")) { second = third; }
  assert(has_key(first, "price") && has_key(third, "price"));
  let ami1 = first.type == "t4g.nano" ? arm : x86; let ami2 = second.type == "t4g.nano" ? arm : x86; let ami3 = x86;
  println("plan:", first.type, first.az, "spot", first.price, "max", first.max_price, "| then:", second.type, second.az, "| then:", third.type, third.az);
  let o2 = merge(o, {timeout_ms:780000});
  let p2 = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_spot_nano_lifecycle");
let spot = cloud.spot_run();
let sg = spot.security_group(${first.vpc});
let inst = spot.launch(${first.type}, ${ami1}, ${first.subnet}, sg.get("id"), ${first.max_price});
file_write(${out + ".launch1.json"}, inst.json());
if (inst.get("status") != "launched") {
  inst = spot.launch(${second.type}, ${ami2}, ${second.subnet}, sg.get("id"), ${second.max_price});
  file_write(${out + ".launch2.json"}, inst.json());
}
if (inst.get("status") != "launched") {
  inst = spot.launch(${third.type}, ${ami3}, ${third.subnet}, sg.get("id"), ${third.max_price});
  file_write(${out + ".launch3.json"}, inst.json());
}
if (inst.get("status") == "launched") {
  let id = inst.get("id");
  file_write(${out + ".running.json"}, spot.wait_state(id, "running", 300).json());
  file_write(${out + ".checks.json"}, spot.wait_status_ok(id, 420).json());
  file_write(${out + ".status.json"}, cloud.instance_status(id).json());
  file_write(${out + ".stop.json"}, spot.stop(id).json());
  file_write(${out + ".terminate.json"}, spot.terminate(id).json());
  file_write(${out + ".terminated.json"}, spot.wait_state(id, "terminated", 300).json());
}
file_write(${out + ".teardown.json"}, spot.teardown().json());
file_write(${out + ".verify.json"}, spot.verify().json());
file_write(${out + ".leftovers.json"}, spot.leftovers().json());
file_write(${out + ".price.raw"}, str(spot.spot_price()));
file_write(${out + ".cost.raw"}, str(spot.estimated_cost()));
file_write(${out + ".denied.raw"}, spot.denied_action());
end _dsl_
  let result = recipe_run(p2, o2);
  let launch = json_parse(read_file(out + ".launch1.json"));
  let attempts = [launch.type + " " + launch.status];
  for (k in ["2", "3"]) { if (file_exists(out + ".launch" + k + ".json")) { launch = json_parse(read_file(out + ".launch" + k + ".json")); push(attempts, launch.type + " " + launch.status); } }
  let launched = launch.status == "launched";
  let verify = json_parse(read_file(out + ".verify.json")); let leftovers = json_parse(read_file(out + ".leftovers.json"));
  let unclean = 0; for (v in verify) { if (v.clean != "true") { unclean = unclean + 1; } }
  let cost = num(trim(read_file(out + ".cost.raw")));
  let report = {rows:[], launched:launched, attempts:attempts, launch_status:launch.status, message:get(launch, "message", ""), type:get(launch,"type",""), az:get(launch,"az",""),
    denied_action:trim(read_file(out + ".denied.raw")), spot_requests:get(json_parse(read_file(out + ".teardown.json")), "spot_requests", ""),
    spot_price_usd_hour:num(trim(read_file(out + ".price.raw"))), estimated_cost_usd:cost, cap_usd:o.cap, unclean:unclean, leftover_count:len(leftovers) + unclean, synthetic:!o.live, public_ipv4:false, root_gib:8};
  if (launched) {
    let running = json_parse(read_file(out + ".running.json")); let checks = json_parse(read_file(out + ".checks.json"));
    let stop = json_parse(read_file(out + ".stop.json")); let down = json_parse(read_file(out + ".terminated.json"));
    report.seconds_to_running = num(running.seconds); report.seconds_to_status_ok = num(running.seconds) + num(checks.seconds);
    report.status_checks = checks.system_status + "/" + checks.instance_status; report.stop_result = stop.status;
    report.seconds_to_terminated = num(down.seconds); report.final_state = down.state;
    report.rows = [{phase:"launch to running", seconds:report.seconds_to_running}, {phase:"status checks ok", seconds:num(checks.seconds)}, {phase:"terminate to terminated", seconds:report.seconds_to_terminated}];
  }
  _compute_save(o, out, report);
  println("attempts:", join(attempts, ", "));
  println("instance:", report.type, report.az, "| launch:", report.launch_status, "| spot $/h:", report.spot_price_usd_hour);
  if (launched) { println("running after", report.seconds_to_running, "s; checks", report.status_checks, "after", report.seconds_to_status_ok, "s; stop:", report.stop_result, "; terminated after", report.seconds_to_terminated, "s"); }
  else { println("not launched:", report.message); }
  println("spot request after teardown:", report.spot_requests);
  if (report.denied_action != "") { println("denied by the session policy:", report.denied_action, "on spot-instances-request/* tagged lmaws_test; ask an administrator to allow it"); }
  println("spot cost (price x minutes + 8 GiB gp3): $" + str(_compute_r(cost, 6)), "| leftovers:", report.leftover_count);
  assert(cost <= o.cap);
  assert(report.leftover_count == 0);
  return merge(report, {result:result, output_file:out + ".json"});
}


fn recipe_compute_chart(name, title, ylabel, header, rows, colors) {
  assert(regex_test(name, "^[a-z][a-z0-9_]*$"));
  mkdir("images"); mkdir("data");
  let data = join(header, ",") + "\n";
  for (row in rows) { data = data + join(row, ",") + "\n"; }
  write_file("data/" + name + ".csv", data);
  let using = "";
  let i = 2;
  while (i <= len(header)) {
    if (using != "") { using = using + ", '' every ::1"; }
    using = using + " using " + str(i) + (i == 2 ? ":xtic(1)" : "") + " title '" + header[i - 1] + "' lc rgb '" + colors[(i - 2) % len(colors)] + "'";
    i = i + 1;
  }
  let chart = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/" + name + ".png"}, 900, 560);
plot.cmd(${"set termoption noenhanced; set datafile separator ','; set title '" + title + "'; set ylabel '" + ylabel + "'; set style data histograms; set style histogram clustered gap 1; set style fill solid 0.85 border -1; set boxwidth 0.9; set grid ytics; set yrange [0:*]; set key top right; set xtics rotate by -25; set bmargin 6; set rmargin 10"});
plot.cmd(${"plot 'data/" + name + ".csv' every ::1" + using});
plot.close();
end _dsl_
  let code = temp_file(); savedsl(chart, code); let r = system(concat(dsl_cli(chart), ["--dsl", code]), {timeoutMs:120000}); remove_file(code); assert(r.code == 0);
  println("images/" + name + ".png");
}

fn recipe_compute_table(name, title, lines_of_text) {
  assert(regex_test(name, "^[a-z][a-z0-9_]*$"));
  mkdir("images");
  let cmds = "set termoption noenhanced; set title '" + title + "' font ',16'; unset border; unset tics; unset key; set xrange [0:1]; set yrange [0:" + str(len(lines_of_text) + 1) + "]";
  let i = 0;
  for (text in lines_of_text) { cmds = cmds + "; set label " + str(i + 1) + " '" + text + "' at 0.04," + str(len(lines_of_text) - i) + " font 'DejaVu Sans Mono,13'"; i = i + 1; }
  let chart = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/" + name + ".png"}, 900, 360);
plot.cmd(${cmds});
plot.cmd("plot -10 notitle");
plot.close();
end _dsl_
  let code = temp_file(); savedsl(chart, code); let r = system(concat(dsl_cli(chart), ["--dsl", code]), {timeoutMs:120000}); remove_file(code); assert(r.code == 0);
  println("images/" + name + ".png");
}

fn recipe_compute_picture(report, task, name) {
  assert(get(report, "synthetic", false));
  let blue = ["#5db7d1", "#f2a541", "#7fc97f", "#c97fbf"];
  if (task == "fleet_status") {
    let rows = []; for (r in report.rows) { push(rows, [r.name + " (" + r.type + ")", num(r.root_size_gib == "" ? "0" : r.root_size_gib), r.state == "running" ? 1 : 0]); }
    recipe_compute_chart(name, "Synthetic fleet: root GiB per instance", "root volume (GiB)", ["instance", "root GiB", "running (1/0)"], rows, blue);
  } else if (task == "cpu_credits") {
    let rows = []; for (r in report.rows) { push(rows, [r.name + " " + r.type, r.balance, r.max_balance]); }
    recipe_compute_chart(name, "Synthetic CPU credits: balance vs 24 h maximum", "credits", ["instance", "balance", "max balance"], rows, blue);
  } else if (task == "eip_map") {
    let rows = []; for (r in report.rows) { push(rows, [r.name + " (" + r.state + ")", r.monthly_usd]); }
    recipe_compute_chart(name, "Synthetic Elastic IPs: monthly cost, idle ones flagged", "USD per month", ["address", "monthly USD"], rows, ["#f2a541"]);
  } else if (task == "ami_lookup") {
    let lines = []; for (r in report.rows) { push(lines, r.family + " " + r.arch + "    " + r.ami); }
    recipe_compute_table(name, "Synthetic latest AMIs from public SSM parameters", lines);
  } else if (task == "spot_prices") {
    let rows = [];
    for (zone in ["a","b","c","d","e","f"]) {
      let row = ["us-east-1" + zone];
      for (type in ["t4g.nano","t3.nano"]) { let found = 0; for (pr in report.prices) { if (pr.type == type && pr.az == "us-east-1" + zone) { found = num(pr.price); } } push(row, found); }
      push(rows, row);
    }
    recipe_compute_chart(name, "Synthetic spot prices per AZ (USD/hour)", "USD per hour", ["zone", "t4g.nano", "t3.nano"], rows, blue);
  } else if (task == "ebs_roots") {
    let rows = []; for (r in report.rows) { push(rows, [r.name + " " + r.az, r.size_gib]); }
    recipe_compute_chart(name, "Synthetic EBS volumes: GiB per volume and AZ", "GiB", ["volume", "size GiB"], rows, ["#7fc97f"]);
  } else if (task == "spot_nano_lifecycle") {
    let rows = [["launch to running", 18], ["status checks ok", 132], ["terminate to terminated", 41]];
    recipe_compute_chart(name, "Synthetic spot nano lifecycle: seconds per phase", "seconds", ["phase", "seconds"], rows, ["#5db7d1"]);
  } else { assert(false); }
  return "images/" + name + ".png";
}

let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="spot_nano_lifecycle";options.output="data/recipe_spot_nano_lifecycle";
let report=recipe_spot_nano_lifecycle(options);
assert(is_array(report.rows));
recipe_compute_picture(report,"spot_nano_lifecycle","recipe_spot_nano_lifecycle");
println(recipe_cost_line(report));
