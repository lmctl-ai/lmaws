# Synthetic-only: Inspect bounded clusters metadata.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_inventory_clusters.lms
import "../recipes/lib/inventory.lms";
let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="clusters";options.output="data/recipe_inventory_clusters";
let report=recipe_inventory(options);
assert(is_array(report.rows));
recipe_picture(report.rows,"Inspect bounded clusters metadata","recipe_inventory_clusters");
