end _lmcode_
  provision_local(read); let rows=json_parse(read_file(output));remove_file(output);assert(len(rows)==1 && rows[0].identity==id,"registry identity does not match lmprov_id");
  let row=rows[0];return {lmprov_id:id,mode:get(row,"mode",get(get(row,"last_receipt",{}),"synthetic",true) ? "demo":"aws"),stage:get(row,"stage",""),history:get(row,"history",[]),history_trimmed:get(row,"history_trimmed",0),config:get(row,"config",{}),last_receipt:get(row,"last_receipt",{}),pending_operation:get(row,"pending_operation","")};
}
fn provision_save_record(id,record,stage,status,receipt,cfg) {
  mkdir(".lmaws-local/provision",true);
  let output=temp_file();let fields=merge(record,{instance_type:cfg.instance_type,volume_gib:cfg.volume_gib,region:cfg.region,ami_id:get(receipt,"ami_id",""),config_hash:get(receipt,"config_hash",sha256(json_stringify(cfg))),instance_id:get(receipt,"instance_id",""),volume_id:get(receipt,"volume_id",""),last_status:get(receipt,"state",get(receipt,"status","")),last_aws_error_code:get(receipt,"error_code",""),last_aws_error_message:get(receipt,"message",""),updated_at:get(receipt,"finished",str(now()))});
  let upsert=_lmcode_ cli="lmfiles" install="github:lmctl-ai/lmfiles@latest";
let db=registry.open(${".lmaws-local/provision/"+id+".mv"},"provision","{}");file_write(${output},db.item_upsert(${json_stringify({id:id,aliases:[{kind:"lmprov_id",namespace:"provision",value:id}]})},${json_stringify(fields)}));db.close();
end _lmcode_
  provision_local(upsert);let up=json_parse(read_file(output));remove_file(output);assert(up.status=="ok");
  if(stage!="") {
    let stage_program=_lmcode_ cli="lmfiles" install="github:lmctl-ai/lmfiles@latest";
let db=registry.open(${".lmaws-local/provision/"+id+".mv"},"provision","{}");db.stage_record(${up.item},${json_stringify({stage:stage,namespace:"provision",status:status,source_revision:up.revision,metadata:{receipt:receipt,config:cfg}})});db.close();
end _lmcode_
    provision_local(stage_program);
  }
