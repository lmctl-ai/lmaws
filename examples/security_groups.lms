# Public exposure audit: derived from fields in the host rows.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("security_groups");
let rows = cloud.security_groups();
if (cloud.is_demo()) { check(rows.len() == 3); }
let a_count = rows.count("public", "true");
let b_count = rows.count("public", "false");
if (cloud.is_demo()) { check(a_count == 1); }
if (cloud.is_demo()) { check(b_count == 2); }
let csv = "category,count\ntrue," + str(a_count) + "\nfalse," + str(b_count) + "\n";
file_write("data/security_groups.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/security_groups.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Public exposure audit'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65");
plot.cmd("plot 'data/security_groups.csv' every ::1 using 2:xtic(1) title 'rows' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "security_groups-aws.dslb");
r = system ${dsl_cli(aws)} --lmcode "security_groups-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "security_groups-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode "security_groups-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/security_groups.png");
println(cost_line);
