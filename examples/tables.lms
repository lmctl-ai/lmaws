# DynamoDB billing posture: derived from fields in the host's deterministic demo rows.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.demo();
let rows = cloud.tables();
let first = rows.at(0);
check(rows.len() == 3);
let a_count = rows.count("billing", "on_demand");
let b_count = rows.len() - a_count;
check(a_count == 3);
check(b_count == 0);
let csv = "category,count\non_demand," + str(a_count) + "\nmissing," + str(b_count) + "\n";
file_write("data/tables.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/tables.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'DynamoDB billing posture'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65");
plot.cmd("plot 'data/tables.csv' every ::1 using 2:xtic(1) title 'demo rows' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "tables-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "tables-aws.dslb";
assert(r.code == 0);
savedsl(plot, "tables-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "tables-plot.dslb";
assert(r.code == 0);
println("images/tables.png");
