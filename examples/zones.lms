# DNS inventory. Demo mode is deterministic and never contacts AWS.
fn host_run(program,args,timeout_ms) {
  let log=temp_file();
  set_env("LMAWS_LOG_FILE",log);set_env("LMAWS_DEADLINE_MS",timeout_ms>0 ? str(timeout_ms) : "");
  let e=run_lmcode(program,{args:args});
  set_env("LMAWS_LOG_FILE","");set_env("LMAWS_DEADLINE_MS","");
  let logged=read_file(log);remove_file(log);
  if(e.ok) {return {code:0,stdout:logged,stderr:""};}
  return {code:e.phase=="cli" ? 2 : e.phase=="app" ? 4 : 3,stdout:logged,stderr:str(e.code)+": "+str(e.message)};
}
mkdir("images");
mkdir("data");
aws = _lmcode_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("zones");
let csv = "service,count\n";
let zones_rows = cloud.zones();
let zones_count = zones_rows.len();
if (cloud.is_demo()) { check(zones_count == 3); }
csv = csv + "zones," + str(zones_count) + "\n";
let vpcs_rows = cloud.vpcs();
let vpcs_count = vpcs_rows.len();
if (cloud.is_demo()) { check(vpcs_count == 3); }
csv = csv + "vpcs," + str(vpcs_count) + "\n";
file_write("data/zones.csv", csv);
end _lmcode_
plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/zones.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'DNS inventory'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/zones.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _lmcode_
r = host_run(aws, [], 120000);
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
r = host_run(plot, [], 120000);
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/zones.png");
println(cost_line);
