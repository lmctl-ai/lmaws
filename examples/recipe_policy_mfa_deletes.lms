fn recipe_policy_builder(options) {
  let o = recipe_normalize(options);
  let task = str(o.task);
  if (o.preview) { return recipe_preview(o, task); }
  if (task != "policy_simulate_probes") {
    o.live = false;
    o.apply = false;
  } else if (o.live) {
    assert(o.profile == "admin");
  }
  let output = str(o.output);
  mkdir(dirname(output), true);
  let out_policy = output + ".policy.json";
  let out_compact = output + ".compact.json";
  let out_lint = output + ".lint.raw.json";
  let out_explain = output + ".explain.raw.json";
  let out_matrix = output + ".matrix.raw.json";
  let out_extra = output + ".extra.raw.json";

  let temp_ledger = "";
  if (task == "policy_from_ledger" && o.ledger_path == "") {
    temp_ledger = output + ".sample_ledger.jsonl";
    write_file(temp_ledger, join([
      "{\"event\":\"cost_header\",\"run_id\":\"rsynth\",\"live\":false}",
      "{\"event\":\"cost_request\",\"service\":\"sts\",\"operation\":\"GetCallerIdentity\"}",
      "{\"event\":\"cost_request\",\"service\":\"s3\",\"operation\":\"ListBuckets\"}",
      "{\"event\":\"cost_request\",\"service\":\"s3\",\"operation\":\"CreateBucket\"}",
      "{\"event\":\"cost_request\",\"service\":\"s3\",\"operation\":\"PutBucketTagging\"}",
      "{\"event\":\"cost_request\",\"service\":\"s3\",\"operation\":\"PutObject\"}",
      "{\"event\":\"cost_request\",\"service\":\"s3\",\"operation\":\"DeleteObject\"}",
      "{\"event\":\"cost_request\",\"service\":\"s3\",\"operation\":\"DeleteBucket\"}",
      "{\"event\":\"cost_resource\",\"state\":\"created\",\"kind\":\"bucket\",\"id\":\"lmaws-demo\",\"name\":\"lmaws-demo\"}",
      "{\"event\":\"cost_request\",\"service\":\"sqs\",\"operation\":\"CreateQueue\"}",
      "{\"event\":\"cost_request\",\"service\":\"sqs\",\"operation\":\"SendMessage\"}",
      "{\"event\":\"cost_request\",\"service\":\"sqs\",\"operation\":\"DeleteQueue\"}",
      "{\"event\":\"cost_resource\",\"state\":\"created\",\"kind\":\"queue\",\"id\":\"lmaws_demo\",\"name\":\"lmaws_demo\"}",
      "{\"event\":\"cost_request\",\"service\":\"dynamodb\",\"operation\":\"CreateTable\"}",
      "{\"event\":\"cost_request\",\"service\":\"dynamodb\",\"operation\":\"PutItem\"}",
      "{\"event\":\"cost_request\",\"service\":\"dynamodb\",\"operation\":\"DeleteTable\"}",
      "{\"event\":\"cost_resource\",\"state\":\"created\",\"kind\":\"table\",\"id\":\"lmaws_demo\",\"name\":\"lmaws_demo\"}"
    ], "\n") + "\n");
    o.ledger_path = temp_ledger;
  }

  let prog = _pb_build_dsl(task, o, out_policy, out_compact, out_lint, out_explain, out_matrix, out_extra);
  let result = recipe_run(prog, o);

  if (temp_ledger != "" && file_exists(temp_ledger)) { remove_file(temp_ledger); }

  let policy_json = read_file(out_policy);
  let compact_json = read_file(out_compact);
  let lint_obj = json_parse(read_file(out_lint));
  let explain_rows = json_parse(read_file(out_explain));
  let matrix_rows = json_parse(read_file(out_matrix));
  remove_file(out_compact);
  remove_file(out_lint);
  remove_file(out_explain);
  remove_file(out_matrix);

  let extra_obj = {};
  let extra_list = [];
  if (file_exists(out_extra)) {
    let raw_extra = read_file(out_extra);
    remove_file(out_extra);
    let parsed = json_parse(raw_extra);
    if (is_array(parsed)) { extra_list = parsed; }
    else { extra_obj = parsed; }
  }

  let snapshot_diff = {};
  if (task == "session_policy" && o.file != "" && file_exists(o.file)) {
    let target_json = read_file(o.file);
    let diff_raw = output + ".diff.raw.json";
    let dp = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_session_policy_diff");
let d = cloud.policy_diff(${target_json}, ${policy_json});
file_write(${diff_raw}, d.json());
end _dsl_
    recipe_run(dp, o);
    let diff_rows = json_parse(read_file(diff_raw));
    remove_file(diff_raw);
    let added = 0; let modified = 0; let removed = 0; let unchanged = 0;
    for (dr in diff_rows) {
      let ch = str(get(dr, "status", get(dr, "change", "")));
      if (ch == "added") { added = added + 1; }
      else if (ch == "modified") { modified = modified + 1; }
      else if (ch == "removed") { removed = removed + 1; }
      else if (ch == "unchanged") { unchanged = unchanged + 1; }
    }
    snapshot_diff = {
      added_count: added,
      modified_count: modified,
      removed_count: removed,
      unchanged_count: unchanged,
      byte_identical: trim(target_json) == trim(policy_json),
      rows: diff_rows
    };
    println("snapshot compare: +" + str(added) + " ~" + str(modified) + " -" + str(removed) + " =" + str(unchanged) + " | byte_identical:", snapshot_diff.byte_identical);
  }

  let rows = matrix_rows;
  if (task == "policy_split_managed" || task == "policy_simulate_probes" || task == "policy_diff_review") {
    rows = extra_list;
  } else if (task == "policy_fit_inline") {
    rows = [
      {metric: "original_chars", chars: num(get(extra_obj, "original_length", "0")), limit: 2048},
      {metric: "compact_chars", chars: num(get(extra_obj, "compact_length", "0")), limit: 2048},
      {metric: "saved_bytes", chars: num(get(extra_obj, "saved_bytes", "0")), limit: 2048},
      {metric: "remaining_inline", chars: num(get(extra_obj, "remaining_bytes", "0")), limit: 2048}
    ];
  } else if (task == "policy_explain_denial") {
    rows = [extra_obj];
  } else if (task == "policy_from_ledger") {
    let acts = split(str(get(extra_obj, "actions", "")), ",");
    let by_svc = {};
    for (act in acts) {
      if (act != "") {
        let parts = split(act, ":");
        let svc = parts[0];
        by_svc[svc] = get(by_svc, svc, 0) + 1;
      }
    }
    rows = [];
    for (svc in keys(by_svc)) {
      push(rows, {service: svc, actions_synthesized: by_svc[svc], observed_calls: num(get(extra_obj, "observed_call_count", "0"))});
    }
  } else if (task == "policy_migrate_json") {
    let intents = split(str(get(extra_obj, "recognized_intents", "")), ",");
    rows = [];
    for (it in intents) {
      if (it != "") {
        push(rows, {intent: str(it), statements: num(get(extra_obj, "statement_count", "0")), compact_length: num(get(extra_obj, "compact_length", "0"))});
      }
    }
  }

  assert(str(get(lint_obj, "valid", "false")) == "true");
  println("policy:", out_policy, "| statements:", get(lint_obj, "statement_count", "0"), "| compact chars:", len(compact_json), "/ 6144");

  let report = {
    task: task,
    policy_file: out_policy,
    compact_length: len(compact_json),
    max_length: 6144,
    inline_limit: 2048,
    fits_inline: len(compact_json) <= 2048,
    fits_managed: len(compact_json) <= 6144,
    statement_count: num(get(lint_obj, "statement_count", "0")),
    lint_valid: str(get(lint_obj, "valid", "false")) == "true",
    lint_summary: str(get(lint_obj, "summary", "")),
    explain: explain_rows,
    matrix: matrix_rows,
    extra: extra_obj,
    extra_rows: extra_list,
    snapshot_diff: snapshot_diff,
    synthetic: !o.live,
    rows: recipe_select(rows, o),
    output_file: output + ".json"
  };
  write_file(output + ".json", json_stringify(report, 2));
  write_csv(output + ".csv", report.rows);
  return merge(report, {result: result});
}


fn _pb_chart(name, title, ylabel, header, rows, colors) {
  assert(regex_test(name, "^[a-z][a-z0-9_]*$"));
  mkdir("images"); mkdir("data");
  let data = join(header, ",") + "\n";
  for (row in rows) { data = data + join(row, ",") + "\n"; }
  write_file("data/" + name + ".csv", data);
  let using = "";
  let i = 2;
  while (i <= len(header)) {
    if (using != "") { using = using + ", '' every ::1"; }
    using = using + " using " + str(i) + (i == 2 ? ":xtic(1)" : "") + " title '" + header[i - 1] + "' lc rgb '" + colors[(i - 2) % len(colors)] + "'";
    i = i + 1;
  }
  let chart = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/" + name + ".png"}, 920, 560);
plot.cmd(${"set termoption noenhanced; set datafile separator ','; set title '" + title + "'; set ylabel '" + ylabel + "'; set style data histograms; set style histogram clustered gap 1; set style fill solid 0.85 border -1; set boxwidth 0.9; set grid ytics; set yrange [0:*]; set key outside top center horizontal; set xtics rotate by -28; set bmargin 7; set rmargin 8"});
plot.cmd(${"plot 'data/" + name + ".csv' every ::1" + using});
plot.close();
end _dsl_
  let code = temp_file(); savedsl(chart, code); let r = system(concat(dsl_cli(chart), ["--dsl", code]), {timeoutMs:120000}); remove_file(code); assert(r.code == 0);
  println("images/" + name + ".png");
}

fn _pb_table(name, title, lines_of_text) {
  assert(regex_test(name, "^[a-z][a-z0-9_]*$"));
  mkdir("images");
  let cmds = "set termoption noenhanced; set title '" + title + "' font ',15'; unset border; unset tics; unset key; set xrange [0:1]; set yrange [0:" + str(len(lines_of_text) + 1) + "]";
  let i = 0;
  for (text in lines_of_text) {
    let safe = replace_all(str(text), "'", "");
    cmds = cmds + "; set label " + str(i + 1) + " '" + safe + "' at 0.03," + str(len(lines_of_text) - i) + " font 'DejaVu Sans Mono,11'";
    i = i + 1;
  }
  let chart = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/" + name + ".png"}, 940, 420);
plot.cmd(${cmds});
plot.cmd("plot -10 notitle");
plot.close();
end _dsl_
  let code = temp_file(); savedsl(chart, code); let r = system(concat(dsl_cli(chart), ["--dsl", code]), {timeoutMs:120000}); remove_file(code); assert(r.code == 0);
  println("images/" + name + ".png");
}

fn recipe_policy_picture(report, task, name) {
  assert(get(report, "synthetic", false));
  let palette = ["#4c9ed9", "#7fc97f", "#f2a541", "#d95f5f"];

  if (task == "policy_fit_inline") {
    let rows = [];
    for (r in report.rows) { push(rows, [r.metric, r.chars, r.limit]); }
    _pb_chart(name, "Inline STS session policy compaction (chars vs 2048 limit)", "characters", ["metric", "chars", "inline_limit"], rows, palette);
    return "images/" + name + ".png";
  }
  if (task == "policy_split_managed") {
    let rows = [];
    for (r in report.rows) {
      push(rows, ["part" + str(r.part) + " (" + str(r.statement_count) + " stmts)", num(r.compact_length), num(r.remaining_bytes)]);
    }
    _pb_chart(name, "Split managed policy parts (compact chars vs remaining of 6144)", "characters", ["part", "compact_chars", "remaining_bytes"], rows, palette);
    return "images/" + name + ".png";
  }
  if (task == "policy_explain_denial") {
    let d = report.rows[0];
    let lines = [
      "Caller        : " + str(get(d, "principal", "")),
      "Action denied : " + str(get(d, "action", "")) + " (" + str(get(d, "action_class", "")) + ")",
      "Resource ARN  : " + str(get(d, "resource", "")),
      "Denial kind   : " + str(get(d, "denial_type", "")),
      "Failed check  : " + substr(str(get(d, "failed_condition", "")), 0, 74),
      "Plain English : " + substr(str(get(d, "plain_english", "")), 0, 74),
      "Builder fix   : " + str(get(d, "builder_snippet", ""))
    ];
    _pb_table(name, "IAM AccessDenied diagnostic and synthesized builder fix", lines);
    return "images/" + name + ".png";
  }
  if (task == "policy_from_ledger") {
    let rows = [];
    for (r in report.rows) { push(rows, [r.service, r.actions_synthesized, r.observed_calls]); }
    _pb_chart(name, "Least-privilege IAM actions synthesized from run ledger", "count", ["service", "actions_synthesized", "total_sdk_calls"], rows, palette);
    return "images/" + name + ".png";
  }
  if (task == "policy_diff_review") {
    let unchanged = 0; let added = 0; let modified = 0; let removed = 0;
    for (dr in report.extra_rows) {
      let ch = str(get(dr, "status", get(dr, "change", "")));
      if (ch == "unchanged") { unchanged = unchanged + 1; }
      else if (ch == "added") { added = added + 1; }
      else if (ch == "modified") { modified = modified + 1; }
      else if (ch == "removed") { removed = removed + 1; }
    }
    let rows = [
      ["unchanged", unchanged],
      ["added", added],
      ["modified", modified],
      ["removed", removed]
    ];
    _pb_chart(name, "IAM policy statement diff review (v1 -> v2)", "statements", ["change", "statements"], rows, ["#4c9ed9"]);
    return "images/" + name + ".png";
  }
  if (task == "policy_simulate_probes") {
    let rows = [];
    for (r in report.rows) {
      let allow_score = r.decision == "allowed" ? 1 : 0;
      let deny_score = r.decision == "explicitDeny" ? 1 : 0;
      let pass_score = r.passed == "true" ? 1 : 0;
      push(rows, [replace_all(str(r.action), ":", "_"), allow_score, deny_score, pass_score]);
    }
    _pb_chart(name, "IAM policy simulator probe matrix (allow / explicitDeny / pass)", "flag (1=yes, 0=no)", ["probe", "allowed", "explicit_deny", "passed"], rows, palette);
    return "images/" + name + ".png";
  }
  if (task == "policy_migrate_json") {
    let ex = report.extra;
    let lines = [
      "Input statements : " + str(get(ex, "statement_count", "")) + " (" + str(get(ex, "compact_length", "")) + " compact chars)",
      "Detected intents : " + str(get(ex, "recognized_intents", ""))
    ];
    for (line in lines(str(get(ex, "builder_program", "")))) {
      if (len(lines) < 12) { push(lines, line); }
    }
    _pb_table(name, "Migrated hand-written IAM JSON -> fluent policy builder", lines);
    return "images/" + name + ".png";
  }

  let by_svc = {};
  for (m in report.matrix) {
    let svc = str(get(m, "service", "global"));
    if (!has_key(by_svc, svc)) {
      by_svc[svc] = {scoped_allow: 0, wildcard_allow: 0, deny_guard: 0};
    }
    let cell = by_svc[svc];
    let cnt = num(get(m, "statement_count", "1"));
    let eff = str(get(m, "effect", "Allow"));
    let scope = str(get(m, "scope", "resource-scoped"));
    if (eff == "Deny") {
      cell.deny_guard = cell.deny_guard + cnt;
    } else if (scope == "wildcard") {
      cell.wildcard_allow = cell.wildcard_allow + cnt;
    } else {
      cell.scoped_allow = cell.scoped_allow + cnt;
    }
    by_svc[svc] = cell;
  }
  let chart_rows = [];
  for (svc in keys(by_svc)) {
    let c = by_svc[svc];
    push(chart_rows, [svc, c.scoped_allow, c.wildcard_allow, c.deny_guard]);
  }
  let chart_title = "Permission matrix (" + str(report.statement_count) + " stmts, " + str(report.compact_length) + "/6144 chars): " + replace_all(task, "_", " ");
  _pb_chart(name, chart_title, "statement x class cells", ["service", "scoped_allow", "read_wildcard", "deny_guard"], chart_rows, ["#7fc97f", "#4c9ed9", "#d95f5f"]);
  return "images/" + name + ".png";
}

let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="policy_mfa_deletes";options.output="data/recipe_policy_mfa_deletes";
let report=recipe_policy_builder(options);
assert(is_array(report.rows));
recipe_policy_picture(report,"policy_mfa_deletes","recipe_policy_mfa_deletes");
println(recipe_cost_line(report));
