# Serverless metadata. Demo mode is deterministic and never contacts AWS.
fn host_run(program,args,timeout_ms) {
  let log=temp_file();
  set_env("LMAWS_LOG_FILE",log);set_env("LMAWS_DEADLINE_MS",timeout_ms>0 ? str(timeout_ms) : "");
  let e=run_lmcode(program,{args:args});
  set_env("LMAWS_LOG_FILE","");set_env("LMAWS_DEADLINE_MS","");
  let logged=read_file(log);remove_file(log);
  if(e.ok) {return {code:0,stdout:logged,stderr:""};}
  return {code:e.phase=="cli" ? 2 : e.phase=="app" ? 4 : 3,stdout:logged,stderr:str(e.code)+": "+str(e.message)};
}
mkdir("images");
mkdir("data");
aws = _lmcode_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("functions");
let csv = "service,count\n";
let functions_rows = cloud.functions();
let functions_count = functions_rows.len();
if (cloud.is_demo()) { check(functions_count == 3); }
csv = csv + "functions," + str(functions_count) + "\n";
let log_groups_rows = cloud.log_groups();
let log_groups_count = log_groups_rows.len();
if (cloud.is_demo()) { check(log_groups_count == 3); }
csv = csv + "log_groups," + str(log_groups_count) + "\n";
file_write("data/functions.csv", csv);
end _lmcode_
plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/functions.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Serverless metadata'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/functions.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _lmcode_
r = host_run(aws, [], 120000);
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
r = host_run(plot, [], 120000);
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/functions.png");
println(cost_line);
