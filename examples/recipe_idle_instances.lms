# Synthetic-only: Flag stopped-instance state for further review; never delete.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_idle_instances.lms
import "../recipes/lib/audits.lms";
let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="idle_instances";options.output="data/recipe_idle_instances";
let report=recipe_idle(options);
assert(is_array(report.rows));
recipe_picture(report.rows,"Flag stopped-instance state for further review; never delete","recipe_idle_instances");
