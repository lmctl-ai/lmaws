# Synthetic-only: Report missing and unknown tag presence without assuming compliance.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_tag_compliance.lms
import "../recipes/lib/audits.lms";
let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="tag_compliance";options.output="data/recipe_tag_compliance";
let report=recipe_compliance(options);
assert(is_array(report.rows));
recipe_picture(report.rows,"Report missing and unknown tag presence without assuming compliance","recipe_tag_compliance");
