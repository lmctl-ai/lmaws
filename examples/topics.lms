# Messaging fanout. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("topics");
let csv = "service,count\n";
let topics_rows = cloud.topics();
let topics_count = topics_rows.len();
if (cloud.is_demo()) { check(topics_count == 3); }
csv = csv + "topics," + str(topics_count) + "\n";
let queues_rows = cloud.queues();
let queues_count = queues_rows.len();
if (cloud.is_demo()) { check(queues_count == 3); }
csv = csv + "queues," + str(queues_count) + "\n";
file_write("data/topics.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/topics.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Messaging fanout'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/topics.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "topics-aws.dslb");
r = system ${dsl_cli(aws)} --lmcode "topics-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "topics-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode "topics-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/topics.png");
println(cost_line);
