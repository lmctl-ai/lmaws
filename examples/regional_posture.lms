# Regional resource posture. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("regional_posture");
let csv = "service,count\n";
let vpcs_rows = cloud.vpcs();
let vpcs_count = vpcs_rows.len();
if (cloud.is_demo()) { check(vpcs_count == 3); }
csv = csv + "vpcs," + str(vpcs_count) + "\n";
let zones_rows = cloud.zones();
let zones_count = zones_rows.len();
if (cloud.is_demo()) { check(zones_count == 3); }
csv = csv + "zones," + str(zones_count) + "\n";
let clusters_rows = cloud.clusters();
let clusters_count = clusters_rows.len();
if (cloud.is_demo()) { check(clusters_count == 3); }
csv = csv + "clusters," + str(clusters_count) + "\n";
file_write("data/regional_posture.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/regional_posture.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Regional resource posture'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/regional_posture.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "regional_posture-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "regional_posture-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "regional_posture-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "regional_posture-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/regional_posture.png");
println(cost_line);
