# Synthetic-only: Plan or apply a shared Fargate stack from an apps registry: ECR, ecs-tasks roles, ACM, ALB with a Host rule per app, one ECS task and service, CloudFront and DNS per host.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_fargate_stack.lms
# Generated standalone example from recipes/lib/fargate.lms
let recipe_budget={reserved_units:0};
fn recipe_env(key,fallback) { let value=getenv(key,""); if(value=="") {return fallback;} return value; }
fn recipe_normalize(options) {
  let defaults = {period:num(recipe_env("LMAWS_RECIPE_PERIOD","30")),top:num(recipe_env("LMAWS_RECIPE_TOP","10")),prefix:recipe_env("LMAWS_RECIPE_PREFIX","lmaws"),policy:recipe_env("LMAWS_RECIPE_POLICY","lmaws_session"),file:recipe_env("LMAWS_RECIPE_FILE",""),region:recipe_env("AWS_REGION",recipe_env("AWS_DEFAULT_REGION","us-east-1")),profile:recipe_env("AWS_PROFILE",recipe_env("AWS_DEFAULT_PROFILE","default")),admin_allowed:false,live:false,apply:false,human_confirmed:false,rollback_file:recipe_env("LMAWS_RECIPE_ROLLBACK_FILE",""),preview:false,output:"data/recipe",task:"queues",role_name:recipe_env("LMAWS_RECIPE_ROLE","lmaws_lambda_exec"),role_spec:recipe_env("LMAWS_RECIPE_ROLE_SPEC",""),cap:num(recipe_env("LMAWS_MAX_COST_USD","0.05")),older_hours:0,filter_prefix:false,output_explicit:false,cap_explicit:recipe_env("LMAWS_MAX_COST_USD","")!="",ledger_dir:recipe_env("LMAWS_LEDGER_DIR",".lmaws-local/recipes/ledgers"),tag_key:"Project",tag_value:"",instance:"",hours:24,types:"t4g.nano,t3.nano",domain:recipe_env("LMAWS_RECIPE_DOMAIN","example.com"),max_gib:num(recipe_env("LMAWS_RECIPE_MAX_GIB","8")),cidr:recipe_env("LMAWS_RECIPE_CIDR","203.0.113.10/32"),from_iso:recipe_env("LMAWS_RECIPE_FROM","2026-01-01T00:00:00Z"),to_iso:recipe_env("LMAWS_RECIPE_TO","2026-01-01T04:00:00Z"),error_text:recipe_env("LMAWS_RECIPE_ERROR",""),ledger_path:recipe_env("LMAWS_RECIPE_LEDGER_PATH",""),probes:recipe_env("LMAWS_RECIPE_PROBES",""),apps:"",stack:"",poc:"",state:"",down:false,timeout_ms:300000};
  let o=merge(defaults,options);
  if(has_key(options,"output") && !has_key(options,"output_explicit")) {o.output_explicit=true;}
  if(has_key(options,"cap") && !has_key(options,"cap_explicit")) {o.cap_explicit=true;}
  assert(is_number(o.period) && o.period>=1 && o.period<=365 && floor(o.period)==o.period, "--period must be a whole number of days 1..365; got "+str(o.period));
  assert(is_number(o.top) && o.top>=1 && o.top<=1000 && floor(o.top)==o.top, "--top must be a whole number 1..1000; got "+str(o.top));
  assert(is_number(o.cap) && o.cap>=0 && o.cap<=0.25, "--cap must be a dollar amount 0..0.25; got "+str(o.cap));
  assert(is_number(o.older_hours) && o.older_hours>=0 && floor(o.older_hours)==o.older_hours, "--older-hours must be a whole number >= 0; got "+str(o.older_hours));
  o.output=replace_all(str(o.output),"\\","/");
