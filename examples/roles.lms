# Role metadata review. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.demo();
let csv = "service,count\n";
let roles_rows = cloud.roles();
let roles_count = roles_rows.len();
check(roles_count == 3);
csv = csv + "roles," + str(roles_count) + "\n";
let identity_rows = cloud.identity();
let identity_count = identity_rows.len();
check(identity_count == 3);
csv = csv + "identity," + str(identity_count) + "\n";
file_write("data/roles.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/roles.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Role metadata review'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/roles.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "roles-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "roles-aws.dslb";
assert(r.code == 0);
savedsl(plot, "roles-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "roles-plot.dslb";
assert(r.code == 0);
println("images/roles.png");
