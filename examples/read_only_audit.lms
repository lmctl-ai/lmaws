# Safety diagram: host inventory is transformed into a redacted report.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("read_only_audit");
let identity = cloud.identity(); let secrets = cloud.secrets(); let roles = cloud.roles();
if (cloud.is_demo()) { check(identity.len() == 3); }
if (cloud.is_demo()) { check(secrets.len() == 3); }
if (cloud.is_demo()) { check(roles.len() == 3); }
file_write("data/read_only_audit.count", "identity=" + str(identity.len()) + ", secrets=" + str(secrets.len()) + ", roles=" + str(roles.len()));
end _dsl_
savedsl(aws, "read_only_audit-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "read_only_audit-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
let audit = read_file("data/read_only_audit.count");
draw = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 560, "#101820");
scene.text(48.0, 74.0, 30.0, "Read-only safety boundary", "#dbe7f3");
scene.text(48.0, 108.0, 16.0, ${audit}, "#9db4c8");
scene.rect(120.0, 220.0, 200.0, 88.0, "#284866");
scene.rect(580.0, 220.0, 200.0, 88.0, "#284866");
scene.text(220.0, 272.0, 17.0, "read-only", "#dbe7f3").set_attr("text-anchor", "middle");
scene.text(680.0, 272.0, 17.0, "redacted CSV", "#dbe7f3").set_attr("text-anchor", "middle");
scene.line(320.0, 264.0, 580.0, 264.0, "#f5c16c", 3.0).set_attr("marker-end", "arrow");
scene.render_png("images/read_only_audit.png", 900, 560, 1);
end _dsl_
savedsl(draw, "read_only_audit-draw.dslb");
r = system ${dsl_cli(draw)} --dsl "read_only_audit-draw.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/read_only_audit.png");
println(cost_line);
