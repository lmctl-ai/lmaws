# Synthetic-only: Dry-run leftover review; discovery never authorizes deletion.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_sweeper.lms
# Generated standalone example from recipes/lib/prefix.lms
let recipe_budget={reserved_units:0};
fn recipe_env(key,fallback) { let value=getenv(key,""); if(value=="") {return fallback;} return value; }
fn recipe_normalize(options) {
  let defaults = {period:num(recipe_env("LMAWS_RECIPE_PERIOD","30")),top:num(recipe_env("LMAWS_RECIPE_TOP","10")),prefix:recipe_env("LMAWS_RECIPE_PREFIX","lmaws"),region:recipe_env("AWS_REGION",recipe_env("AWS_DEFAULT_REGION","us-east-1")),profile:recipe_env("AWS_PROFILE",recipe_env("AWS_DEFAULT_PROFILE","default")),live:false,apply:false,preview:false,output:"data/recipe",task:"queues",cap:num(recipe_env("LMAWS_MAX_COST_USD","0.05")),older_hours:0,filter_prefix:false,output_explicit:false,cap_explicit:recipe_env("LMAWS_MAX_COST_USD","")!="",ledger_dir:recipe_env("LMAWS_LEDGER_DIR",".lmaws-local/recipes/ledgers"),tag_key:"Project",tag_value:"",instance:"",hours:24,types:"t4g.nano,t3.nano",timeout_ms:300000};
  let o=merge(defaults,options);
  if(has_key(options,"output") && !has_key(options,"output_explicit")) {o.output_explicit=true;}
  if(has_key(options,"cap") && !has_key(options,"cap_explicit")) {o.cap_explicit=true;}
  assert(is_number(o.period) && o.period>=1 && o.period<=365 && floor(o.period)==o.period);
  assert(is_number(o.top) && o.top>=1 && o.top<=1000 && floor(o.top)==o.top);
  assert(is_number(o.cap) && o.cap>=0 && o.cap<=0.25);
  assert(is_number(o.older_hours) && o.older_hours>=0 && floor(o.older_hours)==o.older_hours);
  o.output=replace_all(str(o.output),"\\","/");
  o.ledger_dir=replace_all(str(o.ledger_dir),"\\","/");
  assert(regex_test(o.ledger_dir,"^[A-Za-z0-9_./: -]+$"));
  assert(o.profile=="default" || o.profile=="lmaws" || o.profile=="lmaws-ec2");
  assert(is_number(o.hours) && o.hours>=1 && o.hours<=720 && floor(o.hours)==o.hours);
  assert(is_number(o.timeout_ms) && o.timeout_ms>=1000 && o.timeout_ms<=900000);
  assert(regex_test(str(o.tag_key),"^[A-Za-z0-9_.:/=+@ -]{0,128}$") && regex_test(str(o.tag_value),"^[A-Za-z0-9_.:/=+@ -]{0,256}$"));
  assert(regex_test(str(o.types),"^[a-z0-9]+[.][a-z0-9]+(,[a-z0-9]+[.][a-z0-9]+)*$"));
  assert(regex_test(o.region,"^[a-z]{2}(-[a-z]+)+-[0-9]+$"));
  assert(regex_test(o.output,"^[A-Za-z0-9_./: -]+$"));
  assert(is_string(o.prefix) && len(o.prefix)<=128);
  return o;
}
fn recipe_options(argv) {
  let o={}; let i=0;
  while(i<len(argv)) {
    let key=argv[i];
    if(key=="--live") {o.live=true;}
    else if(key=="--apply") {o.apply=true;}
    else if(key=="--preview" || key=="--dry-run") {o.preview=true;}
    else {
      assert(i+1<len(argv));i=i+1;let value=argv[i];
      if(key=="--period" || key=="--days") {o.period=num(value);}
      else if(key=="--top" || key=="--top-n") {o.top=num(value);}
      else if(key=="--cap") {o.cap=num(value);o.cap_explicit=true;}
      else if(key=="--older-hours") {o.older_hours=num(value);}
      else if(key=="--prefix") {o.prefix=value;o.filter_prefix=true;}
      else if(key=="--region") {o.region=value;}
      else if(key=="--profile") {o.profile=value;}
      else if(key=="--output") {o.output=value;o.output_explicit=true;}
      else if(key=="--ledger-dir") {o.ledger_dir=value;}
      else if(key=="--task") {o.task=value;}
      else if(key=="--tag-key") {o.tag_key=value;}
      else if(key=="--tag-value") {o.tag_value=value;}
      else if(key=="--instance") {o.instance=value;}
      else if(key=="--hours") {o.hours=num(value);}
      else if(key=="--types") {o.types=value;}
      else {println("Unknown recipe argument:",key);assert(false);}
    }
    i=i+1;
  }
  return recipe_normalize(o);
}
fn recipe_run(program, options) {
  let o=recipe_normalize(options);
  assert(!o.preview);
  if(o.live) {
    let units=ceil(o.cap*100000000);
    if(recipe_budget.reserved_units+units>25000000) {println("Recipe whole-run cap exceeded; reduce per-recipe caps before another live call.");assert(false);}
    recipe_budget.reserved_units=recipe_budget.reserved_units+units;
  }
  mkdir(dirname(o.output),true);
  let bytecode=temp_file();savedsl(program,bytecode);
  let command=dsl_cli(program);
  let settings={AWS_PROFILE:o.profile,AWS_DEFAULT_PROFILE:o.profile,AWS_REGION:o.region,AWS_DEFAULT_REGION:o.region,LMAWS_LIVE:o.live ? "1":"0",LMAWS_SPEND_LIVE:o.live ? "1":"0",LMAWS_MAX_COST_USD:str(o.cap),LMAWS_LEDGER_DIR:o.ledger_dir,LMAWS_EVIDENCE_DIR:".lmaws-local/recipes/evidence"};
  let previous={};
  for(key in keys(settings)) {previous[key]=getenv(key,"");set_env(key,settings[key]);}
  let argv=concat(command,["--dsl",bytecode]);
  if(getenv("OS","")!="Windows_NT") {let pre=["env"];for(key in keys(settings)) {push(pre,key+"="+str(settings[key]));}argv=concat(pre,argv);}
  else if(o.live) {for(key in keys(settings)) {if(getenv(key,"")!=str(settings[key])) {println("Live recipes on Windows: set "+key+"="+str(settings[key])+" in the parent environment first.");assert(false);}}}
  let r=system(argv,{timeoutMs:o.timeout_ms});
  for(key in keys(previous)) {set_env(key,previous[key]);}
  remove_file(bytecode);
  if(r.code!=0) {println("Recipe host failed; see the host's sanitized diagnostic.");println(r.stderr);}
  let found=false;
  for(line in lines(r.stdout)) {
    if(starts_with(line,"Cost Explorer requests:") || starts_with(line,"CloudWatch metric requests:") || starts_with(line,"CloudWatch metric units:")) {println(line);}
    if(starts_with(line,"estimated cost: $")) {println(line);found=true;}
  }
  if(!found && r.code!=0) {println("estimated cost: $"+str(o.cap)+" (reserved upper bound; host receipt unavailable)");}
  assert(r.code==0);
  assert(found);
  return r;
}
fn recipe_preview(options,task) {
  let o=recipe_normalize(options);
  println(json_stringify({task:task,region:o.region,profile:o.profile,prefix:o.prefix,period:o.period,top:o.top,live:o.live,apply:o.apply,preview:true},2));
  println("estimated cost: $0.00");
  return {rows:[],preview:true};
}
fn recipe_select(rows,options) {
  let o=recipe_normalize(options);let selected=[];
  for(row in rows) {
    if(len(selected)<o.top) {push(selected,row);}
  }
  return selected;
}
fn recipe_cost_line(report) {
  let answer="estimated cost: $0.00";
  let result=get(report,"result",{});
  for(line in lines(str(get(result,"stdout","")))) {
    if(starts_with(line,"estimated cost: $")) {answer=line;}
  }
  return answer;
}
fn recipe_picture(rows,title,name) {
  assert(regex_test(name,"^[a-z][a-z0-9_]*$"));
  mkdir("images");mkdir("data");
  let counts={};let max_count=1;
  for(row in rows) {
    let label=str(get(row,"kind",get(row,"task","matching resources")));
    label=replace_all(label,"_"," ");
    label=regex_replace(label,"[^A-Za-z0-9 .-]","","g");
    counts[label]=get(counts,label,0)+1;
    if(counts[label]>max_count) {max_count=counts[label];}
  }
  let data="label,count\n";
  for(label in keys(counts)) {data=data+label+","+str(counts[label])+"\n";}
  if(len(rows)==0) {data=data+"no matches,0\n";}
  let chart_title="Synthetic recipe: "+replace_all(name,"_"," ");
  write_file("data/"+name+".csv",data);
  let chart=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/"+name+".png"},900,560);
plot.cmd(${"set datafile separator ','; set title '"+chart_title+"'; unset key; set style data histograms; set style fill solid 0.8; set boxwidth 0.6; set yrange [0:"+str(max_count+1)+"]; set grid ytics; set xtics rotate by -30"});
plot.cmd(${"plot 'data/"+name+".csv' every ::1 using 2:xtic(1) lc rgb '#5db7d1'"});
plot.close();
end _dsl_
  let code=temp_file();savedsl(chart,code);let r=system(concat(dsl_cli(chart),["--dsl",code]),{timeoutMs:120000});remove_file(code);assert(r.code==0);
  println("images/"+name+".png");
}


fn recipe_inventory(options) {
  let o = recipe_normalize(options);
  if (o.preview) { return recipe_preview(o, o.task); }
  let output = str(o.output);
  assert(contains(["identity", "buckets", "instances", "vpcs", "security_groups", "tables", "queues", "topics", "functions", "log_groups", "alarms", "zones", "secrets", "parameters", "clusters", "roles"],o.task) || o.task=="all");
  assert(!o.live || (o.task!="identity" && o.task!="roles"));
  let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_inventory");
if ((${o.task} == "identity" || ${o.task} == "all") && !${o.live}) { file_write(${output + ".identity.raw.json"}, cloud.identity().json()); }
if ((${o.task} == "buckets" || ${o.task} == "all")) { file_write(${output + ".buckets.raw.json"}, cloud.buckets().json()); }
if ((${o.task} == "instances" || ${o.task} == "all")) { file_write(${output + ".instances.raw.json"}, cloud.instances().json()); }
if ((${o.task} == "vpcs" || ${o.task} == "all")) { file_write(${output + ".vpcs.raw.json"}, cloud.vpcs().json()); }
if ((${o.task} == "security_groups" || ${o.task} == "all")) { file_write(${output + ".security_groups.raw.json"}, cloud.security_groups().json()); }
if ((${o.task} == "tables" || ${o.task} == "all")) { file_write(${output + ".tables.raw.json"}, cloud.tables().json()); }
if ((${o.task} == "queues" || ${o.task} == "all")) { file_write(${output + ".queues.raw.json"}, cloud.queues().json()); }
if ((${o.task} == "topics" || ${o.task} == "all")) { file_write(${output + ".topics.raw.json"}, cloud.topics().json()); }
if ((${o.task} == "functions" || ${o.task} == "all")) { file_write(${output + ".functions.raw.json"}, cloud.functions().json()); }
if ((${o.task} == "log_groups" || ${o.task} == "all")) { file_write(${output + ".log_groups.raw.json"}, cloud.log_groups().json()); }
if ((${o.task} == "alarms" || ${o.task} == "all")) { file_write(${output + ".alarms.raw.json"}, cloud.alarms().json()); }
if ((${o.task} == "zones" || ${o.task} == "all")) { file_write(${output + ".zones.raw.json"}, cloud.zones().json()); }
if ((${o.task} == "secrets" || ${o.task} == "all")) { file_write(${output + ".secrets.raw.json"}, cloud.secrets().json()); }
if ((${o.task} == "parameters" || ${o.task} == "all")) { file_write(${output + ".parameters.raw.json"}, cloud.parameters().json()); }
if ((${o.task} == "clusters" || ${o.task} == "all")) { file_write(${output + ".clusters.raw.json"}, cloud.clusters().json()); }
if ((${o.task} == "roles" || ${o.task} == "all") && !${o.live}) { file_write(${output + ".roles.raw.json"}, cloud.roles().json()); }
end _dsl_
  let result = recipe_run(p, o);
  let selected = [];
  let task = str(o.task);
  if (task == "all") { for (name in ["identity","buckets","instances","vpcs","security_groups","tables","queues","topics","functions","log_groups","alarms","zones","secrets","parameters","clusters","roles"]) { if (!o.live || (name!="identity" && name!="roles")) { for (row in json_parse(read_file(output + "." + name + ".raw.json"))) { push(selected,row); } } } }
  else { selected = json_parse(read_file(output + "." + task + ".raw.json")); }
  if (o.filter_prefix) { let filtered=[]; for(row in selected) {if(starts_with(str(get(row,"name","")),o.prefix)) {push(filtered,row);}} selected=filtered; }
  selected = recipe_select(selected,o);
  write_file(output + ".json",json_stringify(selected));
  return {"rows":selected,"result":result};
}

fn recipe_prefix_fixture() {
  return [
    {kind:"queue",name:"lmaws_rfixture1xfixture2_events",region:"us-east-1",tagged:"true",count:1},
    {kind:"bucket",name:"lmaws-rfixture1xfixture2-artifacts",region:"us-east-1",tagged:"true",count:1},
    {kind:"table",name:"lmaws_rfixture1xfixture2_items",region:"us-east-1",tagged:"true",count:1},
    {kind:"topic",name:"lmaws_rfixture1xfixture2_notifications",region:"us-east-1",tagged:"true",count:1},
    {kind:"log_group",name:"lmaws_rfixture1xfixture2_logs",region:"us-east-1",tagged:"false",count:1},
    {kind:"parameter",name:"lmaws_rfixture1xfixture2_config",region:"us-east-1",tagged:"unknown",count:1},
    {kind:"queue",name:"customer_events",region:"us-east-1",tagged:"true",count:1}
  ];
}
fn recipe_prefix_search(options) {
  let o=recipe_normalize(options);
  if(o.preview) {return recipe_preview(o,"prefix_search");}
  let rows=[];let execution_result={};
  if(o.live) {
    let all=recipe_inventory(merge(o,{task:"all",top:1000}));execution_result=all.result;
    for(task in ["buckets","instances","vpcs","security_groups","tables","queues","topics","functions","log_groups","alarms","zones","secrets","parameters","clusters"]) {
      for(row in json_parse(read_file(o.output+"."+task+".raw.json"))) {push(rows,row);}
    }
  } else {rows=recipe_prefix_fixture();println("estimated cost: $0.00");}
  let found=[];
  for(row in rows) {
    let name=str(get(row,"name",""));
    let matches=starts_with(name,o.prefix);
    if(o.prefix=="lmaws") {matches=starts_with(name,"lmaws_") || starts_with(name,"lmaws-");}
    if(matches) {push(found,row);}
  }
  let report={rows:recipe_select(found,o),matching_count:len(found),scanned_count:len(rows),region:o.region,profile:o.profile,synthetic:!o.live,scope:"14 supported metadata APIs in one configured region plus global inventories; IAM excluded; not every AWS service or region",cleanup_authorized:false};
  mkdir(dirname(o.output),true);write_file(o.output+".json",json_stringify(report,2));
  write_csv(o.output+".csv",report.rows);
  return merge(report,{result:execution_result});
}
fn recipe_ledger_name(record) {
  let value=str(get(record,"name",get(record,"id","manual review")));
  if(contains(value,"/")) {let parts=split(value,"/");value=parts[len(parts)-1];}
  if(contains(value,":")) {let parts=split(value,":");value=parts[len(parts)-1];}
  return value;
}
fn recipe_leftovers(options) {
  let o=recipe_normalize(options);
  if(o.preview) {return recipe_preview(o,"leftover_report");}
  let rows=[];let execution_result={};
  if(o.live) {
    let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.example("recipe_leftovers");
file_write(${o.output+".ledger.raw.json"},cloud.sweep(${o.older_hours}).json());
end _dsl_
    execution_result=recipe_run(p,o);rows=json_parse(read_file(o.output+".ledger.raw.json"));
  } else {
    rows=[{name:"lmaws_rfixture1xfixture2_events",kind:"queue",state:"active",ledger:"synthetic run ledger",count:1},{name:"lmaws-rfixture1xfixture2-artifacts",kind:"bucket",state:"pending",ledger:"synthetic run ledger",count:1}];println("estimated cost: $0.00");
  }
  let selected=[];
  for(row in rows) {
    if(has_key(row,"record")) {let record=json_parse_safe(row.record,{});row=merge(row,{name:recipe_ledger_name(record),kind:get(record,"kind","unknown"),state:get(record,"state","unknown")});}
    let name=str(get(row,"name","manual review"));
    if(starts_with(name,o.prefix) || name=="manual review" || o.prefix=="lmaws" && (starts_with(name,"lmaws_") || starts_with(name,"lmaws-"))) {push(selected,row);}
  }
  let report={rows:recipe_select(selected,o),leftover_count:len(selected),dry_run:true,synthetic:!o.live,cleanup_authorized:false};
  mkdir(dirname(o.output),true);write_file(o.output+".json",json_stringify(report,2));write_csv(o.output+".csv",report.rows);
  return merge(report,{result:execution_result});
}
fn recipe_sweeper(options) {
  let o=recipe_normalize(options);
  if(o.preview) {return recipe_preview(o,"sweeper");}
  assert(!o.apply);
  return recipe_leftovers(o);
}

let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="sweeper";options.output="data/recipe_sweeper";
let report=recipe_sweeper(options);
assert(is_array(report.rows));
recipe_picture(report.rows,"Dry-run leftover review; discovery never authorizes deletion","recipe_sweeper");
println(recipe_cost_line(report));
