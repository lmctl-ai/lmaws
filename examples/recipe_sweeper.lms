# Synthetic-only: Plan account cleanup; explicit delete checks prefix, tag and run ledger.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_sweeper.lms
# Generated standalone example from recipes/lib/prefix.lms
let recipe_budget={reserved_units:0};
fn recipe_env(key,fallback) { let value=getenv(key,""); if(value=="") {return fallback;} return value; }
fn recipe_normalize(options) {
  let defaults = {period:num(recipe_env("LMAWS_RECIPE_PERIOD","30")),top:num(recipe_env("LMAWS_RECIPE_TOP","10")),prefix:recipe_env("LMAWS_RECIPE_PREFIX","lmaws"),policy:recipe_env("LMAWS_RECIPE_POLICY","lmaws_session"),file:recipe_env("LMAWS_RECIPE_FILE",""),region:recipe_env("AWS_REGION",recipe_env("AWS_DEFAULT_REGION","us-east-1")),profile:recipe_env("AWS_PROFILE",recipe_env("AWS_DEFAULT_PROFILE","default")),live:false,apply:false,preview:false,output:"data/recipe",task:"queues",cap:num(recipe_env("LMAWS_MAX_COST_USD","0.05")),older_hours:0,filter_prefix:false,output_explicit:false,cap_explicit:recipe_env("LMAWS_MAX_COST_USD","")!="",ledger_dir:recipe_env("LMAWS_LEDGER_DIR",".lmaws-local/recipes/ledgers"),tag_key:"Project",tag_value:"",instance:"",hours:24,types:"t4g.nano,t3.nano",domain:recipe_env("LMAWS_RECIPE_DOMAIN","example.com"),max_gib:num(recipe_env("LMAWS_RECIPE_MAX_GIB","8")),cidr:recipe_env("LMAWS_RECIPE_CIDR","203.0.113.10/32"),from_iso:recipe_env("LMAWS_RECIPE_FROM","2026-01-01T00:00:00Z"),to_iso:recipe_env("LMAWS_RECIPE_TO","2026-01-01T04:00:00Z"),error_text:recipe_env("LMAWS_RECIPE_ERROR",""),ledger_path:recipe_env("LMAWS_RECIPE_LEDGER_PATH",""),probes:recipe_env("LMAWS_RECIPE_PROBES",""),timeout_ms:300000};
  let o=merge(defaults,options);
  if(has_key(options,"output") && !has_key(options,"output_explicit")) {o.output_explicit=true;}
  if(has_key(options,"cap") && !has_key(options,"cap_explicit")) {o.cap_explicit=true;}
  assert(is_number(o.period) && o.period>=1 && o.period<=365 && floor(o.period)==o.period);
  assert(is_number(o.top) && o.top>=1 && o.top<=1000 && floor(o.top)==o.top);
  assert(is_number(o.cap) && o.cap>=0 && o.cap<=0.25);
  assert(is_number(o.older_hours) && o.older_hours>=0 && floor(o.older_hours)==o.older_hours);
  o.output=replace_all(str(o.output),"\\","/");
  o.ledger_dir=replace_all(str(o.ledger_dir),"\\","/");
  assert(regex_test(o.ledger_dir,"^[A-Za-z0-9_./: ~-]+$"));
  assert(o.profile=="default" || o.profile=="lmaws" || o.profile=="lmaws-ec2" || o.profile=="admin");
  assert(regex_test(str(o.policy),"^lmaws_[a-z0-9_-]{1,64}$"));
  assert(is_number(o.hours) && o.hours>=1 && o.hours<=720 && floor(o.hours)==o.hours);
  assert(is_number(o.max_gib) && o.max_gib>=1 && o.max_gib<=16384 && floor(o.max_gib)==o.max_gib);
  assert(is_number(o.timeout_ms) && o.timeout_ms>=1000 && o.timeout_ms<=900000);
  assert(regex_test(str(o.tag_key),"^[A-Za-z0-9_.:/=+@ -]{0,128}$") && regex_test(str(o.tag_value),"^[A-Za-z0-9_.:/=+@ -]{0,256}$"));
  assert(regex_test(str(o.types),"^[a-z0-9]+[.][a-z0-9]+(,[a-z0-9]+[.][a-z0-9]+)*$"));
  assert(regex_test(str(o.domain),"^[A-Za-z0-9-]+([.][A-Za-z0-9-]+)+$"));
  assert(regex_test(o.region,"^[a-z]{2}(-[a-z]+)+-[0-9]+$"));
  assert(regex_test(o.output,"^[A-Za-z0-9_./: ~-]+$"));
  assert(is_string(o.prefix) && len(o.prefix)<=128);
  return o;
}
fn recipe_options(argv) {
  let o={}; let i=0;
  while(i<len(argv)) {
    let key=argv[i];
    if(key=="--live") {o.live=true;}
    else if(key=="--apply" || key=="--delete") {o.apply=true;}
    else if(key=="--preview" || key=="--dry-run") {o.preview=true;}
    else {
      assert(i+1<len(argv));i=i+1;let value=argv[i];
      if(key=="--period" || key=="--days") {o.period=num(value);}
      else if(key=="--top" || key=="--top-n") {o.top=num(value);}
      else if(key=="--cap") {o.cap=num(value);o.cap_explicit=true;}
      else if(key=="--older-hours") {o.older_hours=num(value);}
      else if(key=="--prefix") {o.prefix=value;o.filter_prefix=true;}
      else if(key=="--policy" || key=="--policy-name") {o.policy=value;}
      else if(key=="--file" || key=="--policy-file") {o.file=value;}
      else if(key=="--region") {o.region=value;}
      else if(key=="--profile") {o.profile=value;}
      else if(key=="--output") {o.output=value;o.output_explicit=true;}
      else if(key=="--ledger-dir") {o.ledger_dir=value;}
      else if(key=="--task") {o.task=value;}
      else if(key=="--tag-key") {o.tag_key=value;}
      else if(key=="--tag-value") {o.tag_value=value;}
      else if(key=="--instance") {o.instance=value;}
      else if(key=="--hours") {o.hours=num(value);}
      else if(key=="--types") {o.types=value;}
      else if(key=="--domain") {o.domain=value;}
      else if(key=="--max-gib") {o.max_gib=num(value);}
      else if(key=="--cidr") {o.cidr=value;}
      else if(key=="--from") {o.from_iso=value;}
      else if(key=="--to") {o.to_iso=value;}
      else if(key=="--error") {o.error_text=value;}
      else if(key=="--ledger") {o.ledger_path=value;}
      else if(key=="--probes") {o.probes=value;}
      else {println("Unknown recipe argument:",key);assert(false);}
    }
    i=i+1;
  }
  return recipe_normalize(o);
}
fn recipe_run(program, options) {
  let o=recipe_normalize(options);
  assert(!o.preview);
  if(o.live) {
    let units=ceil(o.cap*100000000);
    if(recipe_budget.reserved_units+units>25000000) {println("Recipe whole-run cap exceeded; reduce per-recipe caps before another live call.");assert(false);}
    recipe_budget.reserved_units=recipe_budget.reserved_units+units;
  }
  mkdir(dirname(o.output),true);
  let bytecode=temp_file();savedsl(program,bytecode);
  let command=dsl_cli(program);
  let settings={AWS_PROFILE:o.profile,AWS_DEFAULT_PROFILE:o.profile,AWS_REGION:o.region,AWS_DEFAULT_REGION:o.region,LMAWS_LIVE:o.live ? "1":"0",LMAWS_APPLY:o.apply ? "1":"0",LMAWS_SPEND_LIVE:o.live ? "1":"0",LMAWS_MAX_COST_USD:str(o.cap),LMAWS_LEDGER_DIR:o.ledger_dir,LMAWS_EVIDENCE_DIR:".lmaws-local/recipes/evidence"};
  let previous={};
  for(key in keys(settings)) {previous[key]=getenv(key,"");set_env(key,settings[key]);}
  let cli_args=o.apply ? ["--apply","--dsl",bytecode] : ["--dsl",bytecode];
  let argv=concat(command,cli_args);
  if(getenv("OS","")!="Windows_NT") {let pre=["env"];for(key in keys(settings)) {push(pre,key+"="+str(settings[key]));}argv=concat(pre,argv);}
  else if(o.live) {for(key in keys(settings)) {if(getenv(key,"")!=str(settings[key])) {println("Live recipes on Windows: set "+key+"="+str(settings[key])+" in the parent environment first.");assert(false);}}}
  let r=system(argv,{timeoutMs:o.timeout_ms});
  for(key in keys(previous)) {set_env(key,previous[key]);}
  remove_file(bytecode);
  if(r.code!=0) {println("Recipe host failed; see the host's sanitized diagnostic.");println(r.stderr);}
  let found=false;
  for(line in lines(r.stdout)) {
    if(starts_with(line,"Cost Explorer requests:") || starts_with(line,"CloudWatch metric requests:") || starts_with(line,"CloudWatch metric units:") || starts_with(line,"IAM policy lint:") || starts_with(line,"IAM policy diff") || starts_with(line,"  + ") || starts_with(line,"  ~ ") || starts_with(line,"  - ") || starts_with(line,"  = ")) {println(line);}
    if(starts_with(line,"estimated cost: $")) {println(line);found=true;}
  }
  if(!found && r.code!=0) {println("estimated cost: $"+str(o.cap)+" (reserved upper bound; host receipt unavailable)");}
  assert(r.code==0);
  assert(found);
  return r;
}
fn recipe_preview(options,task) {
  let o=recipe_normalize(options);
  println(json_stringify({task:task,region:o.region,profile:o.profile,prefix:o.prefix,period:o.period,top:o.top,live:o.live,apply:o.apply,preview:true},2));
  println("estimated cost: $0.00");
  return {rows:[],preview:true};
}
fn recipe_select(rows,options) {
  let o=recipe_normalize(options);let selected=[];
  for(row in rows) {
    if(len(selected)<o.top) {push(selected,row);}
  }
  return selected;
}
fn recipe_cost_line(report) {
  let answer="estimated cost: $0.00";
  let result=get(report,"result",{});
  for(line in lines(str(get(result,"stdout","")))) {
    if(starts_with(line,"estimated cost: $")) {answer=line;}
  }
  return answer;
}
fn recipe_picture(rows,title,name) {
  assert(regex_test(name,"^[a-z][a-z0-9_]*$"));
  mkdir("images");mkdir("data");
  let counts={};let max_count=1;
  for(row in rows) {
    let label=str(get(row,"kind",get(row,"task","matching resources")));
    label=replace_all(label,"_"," ");
    label=regex_replace(label,"[^A-Za-z0-9 .-]","","g");
    counts[label]=get(counts,label,0)+1;
    if(counts[label]>max_count) {max_count=counts[label];}
  }
  let data="label,count\n";
  for(label in keys(counts)) {data=data+label+","+str(counts[label])+"\n";}
  if(len(rows)==0) {data=data+"no matches,0\n";}
  let chart_title="Synthetic recipe: "+replace_all(name,"_"," ");
  write_file("data/"+name+".csv",data);
  let chart=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/"+name+".png"},900,560);
plot.cmd(${"set datafile separator ','; set title '"+chart_title+"'; unset key; set style data histograms; set style fill solid 0.8; set boxwidth 0.6; set yrange [0:"+str(max_count+1)+"]; set grid ytics; set xtics rotate by -30"});
plot.cmd(${"plot 'data/"+name+".csv' every ::1 using 2:xtic(1) lc rgb '#5db7d1'"});
plot.close();
end _dsl_
  let code=temp_file();savedsl(chart,code);let r=system(concat(dsl_cli(chart),["--dsl",code]),{timeoutMs:120000});remove_file(code);assert(r.code==0);
  println("images/"+name+".png");
}

fn recipe_discovery(options) {
  let o=recipe_normalize(options);
  if(o.preview) {return recipe_preview(o,o.task);}
  assert(!o.apply || (o.live && o.profile=="lmaws"));
  if(o.live) {
    if(!o.output_explicit) {o.output=".lmaws-local/search/"+o.task;}
    assert(starts_with(o.output,".lmaws-local/"));
  }
  let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.example(${o.task});
if (${o.task} == "find_lmaws_resources") {
  let rows=cloud.find_prefix(${o.prefix});
  rows.csv(${o.output+".csv"});file_write(${o.output+".json"},rows.json());
} else {
  let rows=cloud.cleanup_prefix(${o.prefix},${o.older_hours},${o.apply});
  rows.csv(${o.output+".csv"});file_write(${o.output+".json"},rows.json());
}
end _dsl_
  if(!o.live){o.ledger_dir="data/discovery-ledgers";}
  let result=recipe_run(p,o);let rows=json_parse(read_file(o.output+".json"));
  for(row in rows) {
    if(get(row,"status","")=="delete_failed") {println("Cleanup failed:",json_stringify({name:get(row,"name",""),reason:get(row,"reason","")}));assert(false);}
  }
  return {rows:rows,result:result,output:o.output,output_file:o.output+".json",live:o.live,apply:o.apply};
}
fn recipe_discovery_picture(report,name) {
  let root=report.live ? ".lmaws-local/search":"data";
  let images=report.live ? ".lmaws-local/search/images":"images";
  mkdir(root,true);mkdir(images,true);
  let services={};let ages={"under 24h":0,"24h to 7d":0,"over 7d":0,"unknown":0};let max_count=1;
  let table=[{x:0.01,y:12,text:"NAME | SERVICE | AGE HOURS | RUN TAG | PLAN"}];let i=0;
  for(row in report.rows) {
    let service=str(get(row,"service","unknown"));services[service]=get(services,service,0)+1;
    if(services[service]>max_count) {max_count=services[service];}
    let age=str(get(row,"age_hours",""));let bucket="unknown";
    if(age!="") {let hours=num(age);bucket=hours<24 ? "under 24h":hours<168 ? "24h to 7d":"over 7d";}
    ages[bucket]=ages[bucket]+1;
    if(i<10) {
      let label=str(get(row,"name",""))+" | "+service+" | "+(age=="" ? "unknown":age)+" | "+str(get(row,"run_id",""))+" | "+str(get(row,"status","ok"));
      label=regex_replace(label,"[\\r\\n\\t]"," ","g");label=substr(label,0,130);
      push(table,{x:0.01,y:11-i,text:label});i=i+1;
    }
  }
  if(i==0) {push(table,{x:0.01,y:10,text:"No matching account resources"});}
  let counts=[];for(service in keys(services)) {push(counts,{label:service,count:services[service]});}
  if(len(counts)==0) {push(counts,{label:"no matches",count:0});}
  let age_rows=[];for(bucket in keys(ages)) {push(age_rows,{label:bucket,count:ages[bucket]});}
  write_csv(root+"/"+name+".csv",counts);write_csv(root+"/"+name+"_age.csv",age_rows);write_csv(root+"/"+name+"_table.csv",table);
  let prefix=report.live ? "Account":"Synthetic account";
  let plot=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${images+"/"+name+".png"},1000,560);
plot.cmd(${"set datafile separator ','; set title '"+prefix+" prefix matches by service'; unset key; set style data histograms; set style fill solid 0.8; set yrange [0:"+str(max_count+1)+"]; set grid ytics"});
plot.cmd(${"plot '"+root+"/"+name+".csv' every ::1 using 2:xtic(1) lc rgb '#5db7d1'"});plot.close();
plot.png(${images+"/"+name+"_age.png"},1000,560);
plot.cmd(${"set title '"+prefix+" prefix matches by age'; set yrange [0:*]; set grid ytics"});
plot.cmd(${"plot '"+root+"/"+name+"_age.csv' every ::1 using 2:xtic(1) lc rgb '#e6aa50'"});plot.close();
plot.png(${images+"/"+name+"_table.png"},1300,560);
plot.cmd(${"set termoption noenhanced; set title '"+prefix+" resource names and recovery status'; unset xtics; unset ytics; unset grid; set xrange [0:1]; set yrange [0:13]; unset border"});
plot.cmd(${"plot '"+root+"/"+name+"_table.csv' every ::1 using 1:2:3 with labels left font 'Monospace,10'"});plot.close();
end _dsl_
  let code=temp_file();savedsl(plot,code);let r=system(concat(dsl_cli(plot),["--dsl",code]),{timeoutMs:120000});remove_file(code);assert(r.code==0);
  println(images+"/"+name+".png");println(images+"/"+name+"_age.png");println(images+"/"+name+"_table.png");
}

fn recipe_prefix_search(options) {return recipe_discovery(merge(options,{task:"find_lmaws_resources"}));}
fn recipe_leftovers(options) {return recipe_discovery(merge(options,{task:"leftover_report"}));}
fn recipe_sweeper(options) {return recipe_discovery(merge(options,{task:"sweeper"}));}

let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="sweeper";options.output="data/recipe_sweeper";
let report=recipe_sweeper(options);
assert(is_array(report.rows));
recipe_picture(report.rows,"Plan account cleanup; explicit delete checks prefix, tag and run ledger","recipe_sweeper");
println(recipe_cost_line(report));
