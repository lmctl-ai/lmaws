# Storage inventory. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.demo();
let csv = "service,count\n";
let buckets_rows = cloud.buckets();
let buckets_count = buckets_rows.len();
check(buckets_count == 3);
csv = csv + "buckets," + str(buckets_count) + "\n";
let tables_rows = cloud.tables();
let tables_count = tables_rows.len();
check(tables_count == 3);
csv = csv + "tables," + str(tables_count) + "\n";
let parameters_rows = cloud.parameters();
let parameters_count = parameters_rows.len();
check(parameters_count == 3);
csv = csv + "parameters," + str(parameters_count) + "\n";
file_write("data/buckets.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/buckets.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Storage inventory'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/buckets.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "buckets-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "buckets-aws.dslb";
assert(r.code == 0);
savedsl(plot, "buckets-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "buckets-plot.dslb";
assert(r.code == 0);
println("images/buckets.png");
