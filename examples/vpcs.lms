# Regional network inventory: derived from fields in the host's deterministic demo rows.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.demo();
let rows = cloud.vpcs();
let first = rows.at(0);
check(rows.len() == 3);
let a_count = rows.count("region", "us-east-1");
let b_count = rows.len() - a_count;
check(a_count == 3);
check(b_count == 0);
let csv = "category,count\nus-east-1," + str(a_count) + "\nother," + str(b_count) + "\n";
file_write("data/vpcs.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/vpcs.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Regional network inventory'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65");
plot.cmd("plot 'data/vpcs.csv' every ::1 using 2:xtic(1) title 'demo rows' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "vpcs-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "vpcs-aws.dslb";
assert(r.code == 0);
savedsl(plot, "vpcs-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "vpcs-plot.dslb";
assert(r.code == 0);
println("images/vpcs.png");
