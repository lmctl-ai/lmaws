# Create one on-demand DynamoDB table and write one tiny item.
fn host_run(program,args,timeout_ms) {
  let log=temp_file();
  set_env("LMAWS_LOG_FILE",log);set_env("LMAWS_DEADLINE_MS",timeout_ms>0 ? str(timeout_ms) : "");
  let e=run_lmcode(program,{args:args});
  set_env("LMAWS_LOG_FILE","");set_env("LMAWS_DEADLINE_MS","");
  let logged=read_file(log);remove_file(log);
  if(e.ok) {return {code:0,stdout:logged,stderr:""};}
  return {code:e.phase=="cli" ? 2 : e.phase=="app" ? 4 : 3,stdout:logged,stderr:str(e.code)+": "+str(e.message)};
}
mkdir("images"); mkdir("data");
aws = _lmcode_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("table_items");
let run = cloud.example_run();
let table = run.table("sample");
run.put(table, "pk", "example-item");
let created = run.remaining();
let items = 1;
check(created == 1);
run.cleanup();
let cleaned = run.remaining();
check(cleaned == 0);
file_write("data/table_items.csv", "phase,count\ncreated," + str(created) + "\nitems," + str(items) + "\ncleaned," + str(cleaned) + "\n");
end _lmcode_
plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/table_items.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'On-demand table item'; set style data histograms; set style fill solid 0.8");
plot.cmd("plot 'data/table_items.csv' every ::1 using 2:xtic(1) title 'DDB state' lc rgb '#6fbdb4'");
plot.close();
end _lmcode_
r = host_run(aws, [], 120000);
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
r = host_run(plot, [], 120000);
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/table_items.png");
println(cost_line);
