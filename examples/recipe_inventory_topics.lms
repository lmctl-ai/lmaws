# Synthetic-only: Inspect bounded topics metadata.
# This picture-first example always disables live AWS and apply, even if inherited.
# Run: lmctl https://raw.githubusercontent.com/lmctl-ai/lmaws/main/examples/recipe_inventory_topics.lms
import "../recipes/lib/inventory.lms";
let options=recipe_options(ARGV);
options.live=false;options.apply=false;options.preview=false;options.profile="default";
options.task="topics";options.output="data/recipe_inventory_topics";
let report=recipe_inventory(options);
assert(is_array(report.rows));
recipe_picture(report.rows,"Inspect bounded topics metadata","recipe_inventory_topics");
