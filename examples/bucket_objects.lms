# Create one tiny S3 bucket, write one tiny object, and tear it down.
mkdir("images"); mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("bucket_objects");
let run = cloud.example_run();
let bucket = run.bucket("sample");
run.put(bucket, "tiny.txt", "lmaws tiny example object");
let created = run.remaining();
let objects = 1;
check(created == 1);
run.cleanup();
let cleaned = run.remaining();
check(cleaned == 0);
file_write("data/bucket_objects.csv", "phase,count\ncreated," + str(created) + "\nobjects," + str(objects) + "\ncleaned," + str(cleaned) + "\n");
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/bucket_objects.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Tiny object lifecycle'; set style data histograms; set style fill solid 0.8");
plot.cmd("plot 'data/bucket_objects.csv' every ::1 using 2:xtic(1) title 'owned S3 state' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "bucket_objects-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "bucket_objects-aws.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
let cost_line = "";
for (line in lines(r.stdout)) { if (starts_with(line, "estimated cost: $")) { cost_line = line; } }
assert(starts_with(cost_line, "estimated cost: $"));
savedsl(plot, "bucket_objects-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "bucket_objects-plot.dslb";
if (r.code != 0) { println(r.stderr); println(r.stdout); }
assert(r.code == 0);
println("images/bucket_objects.png");
println(cost_line);
