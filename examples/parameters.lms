# Configuration catalog. Demo mode is deterministic and never contacts AWS.
mkdir("images");
mkdir("data");
aws = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.demo();
let csv = "service,count\n";
let parameters_rows = cloud.parameters();
let parameters_count = parameters_rows.len();
check(parameters_count == 3);
csv = csv + "parameters," + str(parameters_count) + "\n";
let secrets_rows = cloud.secrets();
let secrets_count = secrets_rows.len();
check(secrets_count == 3);
csv = csv + "secrets," + str(secrets_count) + "\n";
file_write("data/parameters.csv", csv);
end _dsl_
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/parameters.png", 900, 560);
plot.cmd("set datafile separator ','; set yrange [0:*]; set title 'Configuration catalog'; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set xtics rotate by -35");
plot.cmd("plot 'data/parameters.csv' every ::1 using 2:xtic(1) title 'demo resources' lc rgb '#f5c16c'");
plot.close();
end _dsl_
savedsl(aws, "parameters-aws.dslb");
r = system ${dsl_cli(aws)} --dsl "parameters-aws.dslb";
assert(r.code == 0);
savedsl(plot, "parameters-plot.dslb");
r = system ${dsl_cli(plot)} --dsl "parameters-plot.dslb";
assert(r.code == 0);
println("images/parameters.png");
