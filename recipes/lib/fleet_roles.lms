# Access: Dry-run plan by default; --live --profile default for read-only discovery; --apply requires --live --profile admin --i-am-the-admin-human and LMAWS_ADMIN_GRANT=1.
# What: Plan, lint, apply (one instance at a time: ops-node-1 then ops-node-2) and roll back least-privilege operational IAM roles (example-ops-role-1, example-ops-role-2) and mandatory permissions boundary (example-ops-boundary) for fleet instances.
# Safety: Agents must never hold or create admin; human admin creates least-privilege roles once.
import "./common.lms";

fn fleet_ops_needs_model() {
  return [
    {operation: "self_stop_watchdog", instances: "ops-node-1,ops-node-2", exact_actions: "ec2:StopInstances", resource_scope: "arn:aws:ec2:us-east-1:${aws:PrincipalAccount}:instance/*", condition_scope: "Project=example-fleet, Role=primary|secondary, Name=ops-node-1|ops-node-2, aws:RequestedRegion=us-east-1"},
    {operation: "fleet_status_and_cpu_monitor", instances: "ops-node-1,ops-node-2", exact_actions: "sts:GetCallerIdentity,ec2:Describe*,cloudwatch:GetMetricData", resource_scope: "*", condition_scope: "StringEqualsIfExists aws:RequestedRegion=us-east-1"},
    {operation: "ssm_public_ami_lookup_and_agent_heartbeat", instances: "ops-node-1,ops-node-2", exact_actions: "ssm:GetParameter,ssm:GetParameters,ssm:UpdateInstanceInformation,ssm:ListInstanceAssociations,ssm:ListAssociations", resource_scope: "arn:aws:ssm:us-east-1::parameter/aws/service/canonical/ubuntu/*, *", condition_scope: "StringEquals aws:RequestedRegion=us-east-1"},
    {operation: "website_deploy_assume_role", instances: "ops-node-1,ops-node-2", exact_actions: "sts:AssumeRole", resource_scope: "arn:aws:iam::${aws:PrincipalAccount}:role/example-static-deploy", condition_scope: "Target role trust policy requires explicit principal ARN"},
    {operation: "s3_static_assets_sync", instances: "ops-node-1,ops-node-2", exact_actions: "s3:ListBucket,s3:GetBucketLocation,s3:GetObject*,s3:PutObject*,s3:DeleteObject*,s3:AbortMultipartUpload", resource_scope: "arn:aws:s3:::example-ops-assets, arn:aws:s3:::example-ops-assets/*", condition_scope: "Locked to example-ops-assets; bucket deletion and policy edits denied"},
    {operation: "codecommit_repo_sync_no_delete", instances: "ops-node-1", exact_actions: "codecommit:GitPull,codecommit:GitPush,codecommit:Get*,codecommit:List*", resource_scope: "arn:aws:codecommit:us-east-1:${aws:PrincipalAccount}:*", condition_scope: "aws:RequestedRegion=us-east-1 + explicit Deny on DeleteRepository,DeleteBranch"},
    {operation: "secrets_manager_read_only", instances: "ops-node-1,ops-node-2", exact_actions: "secretsmanager:ListSecrets,secretsmanager:GetSecretValue,secretsmanager:DescribeSecret,kms:Decrypt", resource_scope: "arn:aws:secretsmanager:us-east-1:${aws:PrincipalAccount}:secret:*, arn:aws:kms:us-east-1:${aws:PrincipalAccount}:key/*", condition_scope: "aws:RequestedRegion=us-east-1 + kms:ViaService=secretsmanager.us-east-1.amazonaws.com"},
    {operation: "cognito_user_pools_non_destructive", instances: "ops-node-1,ops-node-2", exact_actions: "cognito-idp:ListUserPools,DescribeUserPool,ListUsers,AdminGetUser,AdminCreateUser,AdminSetUserPassword", resource_scope: "*", condition_scope: "aws:RequestedRegion=us-east-1, aws:ResourceAccount=${aws:PrincipalAccount} + unconditional Deny on *Delete*,ForgetDevice"},
    {operation: "ec2_origin_and_region_guardrails", instances: "ops-node-1,ops-node-2", exact_actions: "Deny NotAction sts:GetCallerIdentity when Null ec2:SourceInstanceArn=true; Deny NotAction sts:*,s3:*,cloudfront:* when aws:RequestedRegion!=us-east-1", resource_scope: "*", condition_scope: "Prevents off-instance credential use and non-us-east-1 access"}
  ];
}

fn recipe_fleet_roles(options) {
  let o=recipe_normalize(merge(options,{admin_allowed:true}));
  if(o.preview) {return recipe_preview(o,"fleet_roles");}
  let rollback_path=str(get(o,"rollback_file",""));
  let is_rollback=len(rollback_path)>0;
  let apply_requested=(o.apply || is_rollback) && !o.preview;

  if(apply_requested) {
    assert(o.live, "fleet_roles apply/rollback requires --live (LMAWS_LIVE=1)");
    assert(o.apply, "fleet_roles apply/rollback requires --apply");
    assert(o.profile=="admin", "fleet_roles apply/rollback requires --profile admin (AWS_PROFILE=admin)");
    assert(getenv("LMAWS_ADMIN_GRANT","")=="1", "fleet_roles apply/rollback requires LMAWS_ADMIN_GRANT=1 in the environment");
    assert(o.human_confirmed, "fleet_roles apply/rollback requires --i-am-the-admin-human (agents must never hold or create admin)");
  } else if(o.live) {
    assert(o.profile=="default" || o.profile=="admin", "live read-only fleet_roles discovery uses --profile default");
  }

  if(o.live && !o.output_explicit) {
    o.output=".lmaws-local/fleet-roles/fleet_roles";
  }
  if(o.live) {
    assert(!contains(o.output,".."), "output path must not contain ..");
  }

  let output=str(get(o,"output","data/fleet_roles"));
  let plan_raw=output+".plan.raw.json";
  let action_raw=output+".action.raw.json";
  let rollback_out=is_rollback ? rollback_path : output+".rollback.json";
  let human_flag=o.human_confirmed;

  let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.example("recipe_fleet_roles");
let plan_doc=cloud.fleet_roles_plan();
file_write(${plan_raw},plan_doc.json());
if (${apply_requested}) {
  if (${is_rollback}) {
    let rb_doc=cloud.fleet_roles_rollback(${rollback_out},true,${human_flag});
    file_write(${action_raw},rb_doc.json());
  } else {
    let ap_doc=cloud.fleet_roles_apply(true,${human_flag});
    file_write(${action_raw},ap_doc.json());
  }
}
end _dsl_

  let result=recipe_run(p,merge(o,{preview:false,apply:apply_requested}));
  let plan_obj=json_parse(read_file(plan_raw));
  remove_file(plan_raw);
  let action_obj={};
  if(apply_requested) {
    action_obj=json_parse(read_file(action_raw));
    remove_file(action_raw);
  }

  let discovery=json_parse(str(get(plan_obj,"discovery_json","[]")));
  let ops_needs=json_parse(str(get(plan_obj,"ops_needs_json","[]")));
  let role_plans=json_parse(str(get(plan_obj,"role_plans_json","{}")));
  let removed_caps=json_parse(str(get(plan_obj,"removed_capabilities_json","[]")));
  let workflow_impacts=json_parse(str(get(plan_obj,"workflow_impacts_json","[]")));
  let node1_doc=str(get(plan_obj,"node1_policy_json","{}"));
  let node2_doc=str(get(plan_obj,"node2_policy_json","{}"));
  let boundary_doc=str(get(plan_obj,"boundary_policy_json","{}"));
  let trust_doc=str(get(plan_obj,"trust_policy_json","{}"));
  let node1_role=str(get(plan_obj,"node1_role","example-ops-role-1"));
  let node2_role=str(get(plan_obj,"node2_role","example-ops-role-2"));
  let boundary_name=str(get(plan_obj,"boundary_name","example-ops-boundary"));

  let rows=[];
  for(op in ops_needs) {
    push(rows,{kind:"ops_needs_scoped",name:str(get(op,"operation","")),instances:str(get(op,"instances","")),service:str(get(op,"service","")),detail:str(get(op,"resource_scope","")),count:1});
  }
  for(st in get(json_parse(node1_doc),"Statement",[])) {
    push(rows,{kind:"node1_policy_stmt",name:str(get(st,"Sid","")),instances:"ops-node-1",service:str(get(st,"Effect","")),detail:node1_role,count:1});
  }
  for(st in get(json_parse(node2_doc),"Statement",[])) {
    push(rows,{kind:"node2_policy_stmt",name:str(get(st,"Sid","")),instances:"ops-node-2",service:str(get(st,"Effect","")),detail:node2_role,count:1});
  }
  for(st in get(json_parse(boundary_doc),"Statement",[])) {
    push(rows,{kind:"boundary_cap_stmt",name:str(get(st,"Sid","")),instances:"ops-node-1,ops-node-2",service:str(get(st,"Effect","")),detail:boundary_name,count:1});
  }
  for(rc in removed_caps) {
    push(rows,{kind:"removed_admin_service",name:str(get(rc,"service","")),instances:"ops-node-1,ops-node-2",service:str(get(rc,"service","")),detail:str(get(rc,"risk_eliminated","")),count:1});
  }
  for(wi in workflow_impacts) {
    push(rows,{kind:"grant_on_demand_pattern",name:str(get(wi,"workflow","")),instances:"ops-node-1,ops-node-2",service:"grant_on_demand",detail:str(get(wi,"recommended_pattern","")),count:1});
  }

  for(inst in discovery) {
    println("Fleet instance "+str(get(inst,"instance_name",""))+" ("+str(get(inst,"instance_id",""))+", Role="+str(get(inst,"role_tag",""))+"): "+str(get(inst,"current_instance_profile",""))+" -> "+str(get(inst,"target_role_name",""))+" [boundary="+str(get(inst,"target_boundary_name",""))+"]");
  }
  println("Instance-role lint: node1="+str(get(plan_obj,"node1_lint_valid",""))+" ("+str(get(plan_obj,"node1_compact_length",""))+"B), node2="+str(get(plan_obj,"node2_lint_valid",""))+" ("+str(get(plan_obj,"node2_compact_length",""))+"B), boundary="+str(get(plan_obj,"boundary_lint_valid",""))+" ("+str(get(plan_obj,"boundary_compact_length",""))+"B)");
  if(apply_requested) {
    println("Fleet role action: "+str(get(action_obj,"mode",""))+" swap_order="+str(get(action_obj,"swap_order",""))+" rollback_file="+str(get(action_obj,"rollback_file",rollback_out)));
  }

  let report={
    kind: "fleet_roles",
    mode: str(get(plan_obj,"mode","dry_run_plan")),
    principle: "Agents must never hold or create admin; a human admin creates least-privilege roles once.",
    node1_role_name: node1_role,
    node2_role_name: node2_role,
    boundary_name: boundary_name,
    node1_lint_valid: str(get(plan_obj,"node1_lint_valid","false"))=="true",
    node2_lint_valid: str(get(plan_obj,"node2_lint_valid","false"))=="true",
    boundary_lint_valid: str(get(plan_obj,"boundary_lint_valid","false"))=="true",
    node1_compact_bytes: num(str(get(plan_obj,"node1_compact_length","0"))),
    node2_compact_bytes: num(str(get(plan_obj,"node2_compact_length","0"))),
    boundary_compact_bytes: num(str(get(plan_obj,"boundary_compact_length","0"))),
    discovery: discovery,
    role_plans: role_plans,
    operations_needs_model: fleet_ops_needs_model(),
    operations_needs: ops_needs,
    removed_capabilities: removed_caps,
    workflow_impacts: workflow_impacts,
    applied: apply_requested,
    action_result: action_obj,
    synthetic: !o.live,
    rows: rows,
    output_file: output+".json"
  };

  mkdir(dirname(output),true);
  write_file(output+".json",json_stringify(report,2));
  write_file(output+".node1.policy.json",node1_doc);
  write_file(output+".node2.policy.json",node2_doc);
  write_file(output+".boundary.policy.json",boundary_doc);
  write_file(output+".trust.policy.json",trust_doc);
  write_csv(output+".csv",report.rows);
  return merge(report,{result:result});
}
