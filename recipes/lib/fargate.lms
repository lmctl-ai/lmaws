# Access: Write with the admin profile only when applying; the plan (dry run) never changes AWS.
# What: Plan or apply a whole shared Fargate stack from an apps registry: ECR, logs, ecs-tasks roles, security groups, ACM + DNS, ALB with a Host rule and target group per app, ECS task and service, CloudFront and DNS per host.
# Safety: every call goes through the guarded sdk_call (admin profile, LMAWS_ADMIN_GRANT=1, --apply, poc tag on create, state file ownership for update and delete).
import "./common.lms";

fn fg_run(o, p, apply) {
  let settings={AWS_PROFILE:o.profile,AWS_DEFAULT_PROFILE:o.profile,AWS_REGION:o.region,AWS_DEFAULT_REGION:o.region,LMAWS_LIVE:o.live ? "1":"0",LMAWS_APPLY:apply ? "1":"0",LMAWS_MAX_COST_USD:str(o.cap),LMAWS_LEDGER_DIR:o.ledger_dir,LMAWS_EVIDENCE_DIR:".lmaws-local/recipes/evidence"};
  settings.LMAWS_OFFLINE=o.live ? getenv("LMAWS_OFFLINE","") : "1";
  let previous={};
  for(key in keys(settings)) {previous[key]=getenv(key,"");set_env(key,str(settings[key]));}
  let r=host_run(p,apply ? ["--apply"] : [],o.timeout_ms);
  for(key in keys(previous)) {set_env(key,previous[key]);}
  return r;
}

// One guarded mutation (dry run unless apply). Returns {ok, row, err}.
fn fg_call(o, ctx, service, op, input, apply) {
  let raw=o.output+".call.json";
  if(file_exists(raw)) {remove_file(raw);}
  let body=json_stringify(input);
  let p=_lmcode_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.example("recipe_fargate_stack");
let row=cloud.sdk_call(${service},${op},${body},${ctx.poc},${ctx.state},${apply});
file_write(${raw},row.json());
end _lmcode_
  let r=fg_run(o,p,apply);
  for(line in lines(r.stdout)) {if(starts_with(line,"sdk call ")) {println("  "+line);}}
  if(r.code!=0 || !file_exists(raw)) {return {ok:false,row:{},err:str(r.stderr)};}
  return {ok:true,row:json_parse(read_file(raw)),err:""};
}

// One read; returns {ok, data} with the raw JSON response (real ARNs, secrets redacted).
fn fg_read(o, ctx, service, op, input) {
  let raw=o.output+".read.json";
  if(file_exists(raw)) {remove_file(raw);}
  let body=json_stringify(input);
  let p=_lmcode_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.example("recipe_fargate_stack");
file_write(${raw},cloud.sdk_read(${service},${op},${body}));
end _lmcode_
  let r=fg_run(o,p,false);
  if(r.code!=0 || !file_exists(raw)) {return {ok:false,data:{},err:str(r.stderr)};}
  return {ok:true,data:json_parse(read_file(raw)),err:""};
}

fn fg_load(path, fallback) {
  if(!file_exists(path)) {return fallback;}
  return json_parse(read_file(path));
}

// Idempotent step: skip when this exact input was already applied; report drift when the input changed.
fn fg_ensure(o, ctx, label, kind, service, op, input) {
  let sha=sha256(json_stringify(input));
  let known=get(ctx.steps,label,null);
  if(known!=null && known.sha==sha) {
    push(ctx.rows,{name:label,kind:kind,action:"unchanged",detail:"already applied",count:1});
    return known.arn;
  }
  if(known!=null) {
    println("DRIFT "+label+": the registry no longer matches what was applied; change it with a dedicated update step (not done automatically)");
    push(ctx.rows,{name:label,kind:kind,action:"drift",detail:"input changed since apply",count:1});
    return known.arn;
  }
  println("== "+(ctx.apply ? "apply " : "plan ")+label);
  let c=fg_call(o,ctx,service,op,input,ctx.apply);
  assert(c.ok,"step "+label+" failed: "+c.err);
  let arn="pending:"+label;
  if(ctx.apply) {
    let st=fg_load(ctx.state,{resources:[]});
    for(e in st.resources) {if(e.service==service && e.op==op) {arn=str(e.arn)!="" ? str(e.arn) : str(e.name);}}
    ctx.steps[label]={sha:sha,arn:arn};
    mkdir(dirname(ctx.steps_file),true);write_file(ctx.steps_file,json_stringify(ctx.steps,2));
  }
  push(ctx.rows,{name:label,kind:kind,action:ctx.apply ? "created" : "would create",detail:service+":"+op,count:1});
  return arn;
}

fn fg_update(o, ctx, label, kind, service, op, input) {
  println("== "+(ctx.apply ? "apply " : "plan ")+label);
  let c=fg_call(o,ctx,service,op,input,ctx.apply);
  assert(c.ok,"step "+label+" failed: "+c.err);
  push(ctx.rows,{name:label,kind:kind,action:ctx.apply ? "updated" : "would update",detail:service+":"+op,count:1});
}

fn fg_tags(ctx) { return [{Key:"poc",Value:ctx.poc}]; }
fn fg_tags_lower(ctx) { return [{key:"poc",value:ctx.poc}]; }
fn fg_last(text, sep) { let parts=split(text,sep); return parts[len(parts)-1]; }
fn fg_pending(arn) { return starts_with(str(arn),"pending:"); }

fn fg_repo_of_image(image) {
  // account.dkr.ecr.region.amazonaws.com/repo/name:tag -> repo/name
  let rest=substr(image,index_of(image,"/")+1,len(image));
  let at=index_of(rest,":");
  return at>=0 ? substr(rest,0,at) : rest;
}

fn fg_task_definition(ctx, apps, stack) {
  let t=apps.task;
  let containers=[];
  for(s in apps.sidecars) {push(containers,s);}
  for(a in apps.apps) {
    let c=merge(a.container,{name:a.name,image:apps.account+".dkr.ecr."+apps.region+".amazonaws.com/"+a.ecr+":"+a.tag});
    push(containers,c);
  }
  return {family:t.family,cpu:t.cpu,memory:t.memory,networkMode:"awsvpc",requiresCompatibilities:["FARGATE"],
    runtimePlatform:{cpuArchitecture:t.arch,operatingSystemFamily:"LINUX"},executionRoleArn:t.execution_role,taskRoleArn:t.task_role,
    containerDefinitions:containers,tags:fg_tags_lower(ctx)};
}

fn fg_distribution(o, ctx, stack, host, origin_host, cert_arn, enabled) {
  let text=read_file(stack.template);
  text=replace_all(text,"{{env:POC_ORIGIN_SECRET}}","{{env:"+stack.origin_secret_env+"}}");
  text=replace_all(text,"{{HOST}}",host);
  text=replace_all(text,"{{ORIGIN_HOST}}",origin_host);
  text=replace_all(text,"{{ORIGIN_ID}}",ctx.base+"-alb");
  text=replace_all(text,"{{ACM_ARN}}",cert_arn);
  text=replace_all(text,"{{POC}}",ctx.poc);
  text=replace_all(text,"{{CALLER_REF}}",ctx.poc+"-"+sha256(host));
  text=replace_all(text,"{{ENABLED}}",enabled ? "true" : "false");
  return json_parse(text);
}

fn fg_alias_change(ctx, stack, zone, name, type, target, target_zone) {
  return {HostedZoneId:zone,ChangeBatch:{Changes:[{Action:"UPSERT",ResourceRecordSet:{Name:name,Type:type,
    AliasTarget:{HostedZoneId:target_zone,DNSName:target,EvaluateTargetHealth:false}}}]}};
}

fn fg_check(check, d) {
  if(check=="cert_issued") {return get(get(d,"Certificate",{}),"Status","")=="ISSUED";}
  if(check=="dist_deployed") {return get(get(d,"Distribution",{}),"Status","")=="Deployed";}
  return true;
}
fn fg_wait(o, ctx, what, tries, pause_ms, service, op, input, check) {
  if(!ctx.apply) {return true;}
  let i=0;
  while(i<tries) {
    let r=fg_read(o,ctx,service,op,input);
    if(r.ok && fg_check(check,r.data)) {return true;}
    sleep_ms(pause_ms);
    i=i+1;
  }
  println("timed out waiting for "+what);
  return false;
}

fn fg_plan_stack(o, ctx, apps, stack) {
  let base=apps.cluster;
  ctx.base=base;
  let region=apps.region;
  // 1. ECR repositories: one per app, one per sidecar image.
  let repos=[];
  for(a in apps.apps) {push(repos,a.ecr);}
  for(s in apps.sidecars) {push(repos,fg_repo_of_image(s.image));}
  for(repo in repos) {
    fg_ensure(o,ctx,"ecr:"+repo,"ecr_repository","ecr","CreateRepository",{repositoryName:repo,imageScanningConfiguration:{scanOnPush:true},tags:fg_tags_lower(ctx)});
  }
  // 2. Log group and retention.
  let lg=apps.task.log_group;
  fg_ensure(o,ctx,"logs:"+lg,"log_group","logs","CreateLogGroup",{logGroupName:lg,tags:{poc:ctx.poc}});
  fg_ensure(o,ctx,"logs-retention:"+lg,"log_retention","logs","PutRetentionPolicy",{logGroupName:lg,retentionInDays:stack.retention_days});
  // 3. IAM roles for ecs-tasks.
  let trust=json_stringify({Version:"2012-10-17",Statement:[{Effect:"Allow",Principal:{Service:"ecs-tasks.amazonaws.com"},Action:"sts:AssumeRole"}]});
  let exec_role=fg_last(apps.task.execution_role,"/");
  let task_role=fg_last(apps.task.task_role,"/");
  fg_ensure(o,ctx,"role:"+exec_role,"iam_role","iam","CreateRole",{RoleName:exec_role,AssumeRolePolicyDocument:trust,Tags:fg_tags(ctx)});
  fg_ensure(o,ctx,"role:"+task_role,"iam_role","iam","CreateRole",{RoleName:task_role,AssumeRolePolicyDocument:trust,Tags:fg_tags(ctx)});
  fg_ensure(o,ctx,"role-policy:"+exec_role,"iam_attachment","iam","AttachRolePolicy",{RoleName:exec_role,PolicyArn:"arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"});
  // 4. Security groups: ALB accepts only the CloudFront origin-facing prefix list; tasks accept only the ALB.
  let prefix_id="pl-pending";
  let pl=fg_read(o,ctx,"ec2","DescribeManagedPrefixLists",{Filters:[{Name:"prefix-list-name",Values:[stack.cloudfront_prefix_list]}]});
  if(pl.ok && len(get(pl.data,"PrefixLists",[]))>0) {prefix_id=pl.data.PrefixLists[0].PrefixListId;}
  let alb_sg=fg_ensure(o,ctx,"sg:"+base+"-alb","security_group","ec2","CreateSecurityGroup",{GroupName:base+"-alb",Description:"poc="+ctx.poc+" ALB: 443 from CloudFront only",VpcId:stack.vpc_id,TagSpecifications:[{ResourceType:"security-group",Tags:fg_tags(ctx)}]});
  let task_sg=fg_ensure(o,ctx,"sg:"+base+"-task","security_group","ec2","CreateSecurityGroup",{GroupName:base+"-task",Description:"poc="+ctx.poc+" task: app ports from the ALB only",VpcId:stack.vpc_id,TagSpecifications:[{ResourceType:"security-group",Tags:fg_tags(ctx)}]});
  let alb_sg_id=fg_pending(alb_sg) ? "sg-pending-alb" : alb_sg;
  let task_sg_id=fg_pending(task_sg) ? "sg-pending-task" : task_sg;
  fg_ensure(o,ctx,"sg-ingress:alb","security_group_rule","ec2","AuthorizeSecurityGroupIngress",{GroupId:alb_sg_id,IpPermissions:[{IpProtocol:"tcp",FromPort:443,ToPort:443,PrefixListIds:[{PrefixListId:prefix_id,Description:"CloudFront origin-facing"}]}]});
  let perms=[];
  for(a in apps.apps) {push(perms,{IpProtocol:"tcp",FromPort:a.port,ToPort:a.port,UserIdGroupPairs:[{GroupId:alb_sg_id,Description:"ALB to "+a.name}]});}
  fg_ensure(o,ctx,"sg-ingress:task","security_group_rule","ec2","AuthorizeSecurityGroupIngress",{GroupId:task_sg_id,IpPermissions:perms});
  // 5. ACM certificate per host (host + origin host), DNS validation records in Route 53.
  let certs={};
  for(a in apps.apps) {
    for(host in a.hosts) {
      let origin_host="origin-"+host;
      let cert=fg_ensure(o,ctx,"acm:"+host,"acm_certificate","acm","RequestCertificate",{DomainName:host,SubjectAlternativeNames:[origin_host],ValidationMethod:"DNS",Tags:fg_tags(ctx)});
      certs[host]=cert;
      if(ctx.apply) {
        let described=fg_read(o,ctx,"acm","DescribeCertificate",{CertificateArn:cert});
        let tries=0;
        while(tries<30 && (!described.ok || len(get(get(described.data,"Certificate",{}),"DomainValidationOptions",[]))<2 || get(get(get(described.data,"Certificate",{}).DomainValidationOptions[1],"ResourceRecord",{}),"Name","")=="")) {
          sleep_ms(3000);described=fg_read(o,ctx,"acm","DescribeCertificate",{CertificateArn:cert});tries=tries+1;
        }
        assert(described.ok,"cannot describe certificate "+host);
        for(opt in described.data.Certificate.DomainValidationOptions) {
          let rr=opt.ResourceRecord;
          fg_ensure(o,ctx,"dns-validation:"+rr.Name,"route53_record","route53","ChangeResourceRecordSets",{HostedZoneId:stack.zone_id,ChangeBatch:{Changes:[{Action:"UPSERT",ResourceRecordSet:{Name:rr.Name,Type:"CNAME",TTL:300,ResourceRecords:[{Value:rr.Value}]}}]}});
        }
        let issued=fg_wait(o,ctx,"certificate "+host,60,10000,"acm","DescribeCertificate",{CertificateArn:cert},"cert_issued");
        assert(issued,"certificate for "+host+" was not issued in time");
      } else {
        push(ctx.rows,{name:"dns-validation:"+host,kind:"route53_record",action:"would create",detail:"CNAME records from the certificate after it is requested",count:1});
      }
    }
  }
  // 6. ALB, one target group per app, HTTPS listener, Host + header rule per app.
  let alb_name=apps.edge.alb;
  let lb=fg_ensure(o,ctx,"alb:"+alb_name,"load_balancer","elbv2","CreateLoadBalancer",{Name:alb_name,Subnets:stack.subnets,SecurityGroups:[alb_sg_id],Scheme:"internet-facing",Type:"application",Tags:fg_tags(ctx)});
  fg_ensure(o,ctx,"alb-attributes:"+alb_name,"load_balancer_attributes","elbv2","ModifyLoadBalancerAttributes",{LoadBalancerArn:lb,Attributes:[{Key:"idle_timeout.timeout_seconds",Value:"120"}]});
  let tgs={};
  for(a in apps.apps) {
    let tg_name=substr(base+"-"+a.name,0,32);
    let tg=fg_ensure(o,ctx,"tg:"+tg_name,"target_group","elbv2","CreateTargetGroup",{Name:tg_name,Protocol:"HTTP",Port:a.port,VpcId:stack.vpc_id,TargetType:"ip",HealthCheckPath:a.health_path,HealthCheckIntervalSeconds:10,HealthyThresholdCount:2,UnhealthyThresholdCount:2,Matcher:{HttpCode:"200"},Tags:fg_tags(ctx)});
    tgs[a.name]=tg;
    fg_ensure(o,ctx,"tg-attributes:"+tg_name,"target_group_attributes","elbv2","ModifyTargetGroupAttributes",{TargetGroupArn:tg,Attributes:[{Key:"deregistration_delay.timeout_seconds",Value:"30"}]});
  }
  let first_cert=certs[apps.apps[0].hosts[0]];
  let listener=fg_ensure(o,ctx,"listener:443","listener","elbv2","CreateListener",{LoadBalancerArn:lb,Protocol:"HTTPS",Port:443,SslPolicy:stack.ssl_policy,Certificates:[{CertificateArn:first_cert}],
    DefaultActions:[{Type:"fixed-response",FixedResponseConfig:{StatusCode:"403",ContentType:"text/plain",MessageBody:"forbidden"}}],Tags:fg_tags(ctx)});
  let priority=1;
  for(a in apps.apps) {
    for(host in a.hosts) {
      if(certs[host]!=first_cert) {
        fg_ensure(o,ctx,"listener-cert:"+host,"listener_certificate","elbv2","AddListenerCertificates",{ListenerArn:listener,Certificates:[{CertificateArn:certs[host]}]});
      }
      fg_ensure(o,ctx,"rule:"+host,"listener_rule","elbv2","CreateRule",{ListenerArn:listener,Priority:priority,Tags:fg_tags(ctx),Actions:[{Type:"forward",TargetGroupArn:tgs[a.name]}],
        Conditions:[{Field:"host-header",HostHeaderConfig:{Values:[host]}},{Field:"http-header",HttpHeaderConfig:{HttpHeaderName:apps.edge.origin_header,Values:["{{env:"+stack.origin_secret_env+"}}"]}}]});
      priority=priority+1;
    }
  }
  // 7. DNS: origin host -> ALB.
  let alb_dns="alb.pending.example";let alb_zone="ZPENDING";
  if(!fg_pending(lb)) {
    let d=fg_read(o,ctx,"elbv2","DescribeLoadBalancers",{LoadBalancerArns:[lb]});
    if(d.ok) {alb_dns=d.data.LoadBalancers[0].DNSName;alb_zone=d.data.LoadBalancers[0].CanonicalHostedZoneId;}
  }
  for(a in apps.apps) {
    for(host in a.hosts) {
      fg_ensure(o,ctx,"dns-origin:"+host,"route53_record","route53","ChangeResourceRecordSets",fg_alias_change(ctx,stack,stack.zone_id,"origin-"+host+".","A",alb_dns,alb_zone));
    }
  }
  // 8. ECS: cluster, task definition (one task for all apps), service.
  let cluster=fg_ensure(o,ctx,"cluster:"+base,"ecs_cluster","ecs","CreateCluster",{clusterName:base,tags:fg_tags_lower(ctx)});
  let td=fg_task_definition(ctx,apps,stack);
  let td_arn=fg_ensure(o,ctx,"task-definition:"+td.family,"task_definition","ecs","RegisterTaskDefinition",td);
  let lbs=[];
  for(a in apps.apps) {push(lbs,{targetGroupArn:tgs[a.name],containerName:a.name,containerPort:a.port});}
  let svc_known=get(ctx.steps,"service:"+base,null);
  if(svc_known==null) {
    fg_ensure(o,ctx,"service:"+base,"ecs_service","ecs","CreateService",{cluster:base,serviceName:base,taskDefinition:fg_pending(td_arn) ? td.family : td_arn,desiredCount:stack.desired_count,launchType:"FARGATE",
      networkConfiguration:{awsvpcConfiguration:{subnets:stack.subnets,securityGroups:[task_sg_id],assignPublicIp:"ENABLED"}},loadBalancers:lbs,healthCheckGracePeriodSeconds:30,
      deploymentConfiguration:{minimumHealthyPercent:100,maximumPercent:200,deploymentCircuitBreaker:{enable:true,rollback:true}},enableECSManagedTags:true,propagateTags:"SERVICE",tags:fg_tags_lower(ctx)});
  } else if(ctx.last_td!=td_arn && !fg_pending(td_arn)) {
    fg_update(o,ctx,"service-deploy:"+base,"ecs_service","ecs","UpdateService",{cluster:base,service:base,taskDefinition:td_arn,desiredCount:stack.desired_count,forceNewDeployment:true});
  } else {
    push(ctx.rows,{name:"service:"+base,kind:"ecs_service",action:"unchanged",detail:"task definition unchanged",count:1});
  }
  // 9. CloudFront per host + alias records.
  for(a in apps.apps) {
    for(host in a.hosts) {
      let cfg=fg_distribution(o,ctx,stack,host,"origin-"+host,certs[host],true);
      let dist=fg_ensure(o,ctx,"cloudfront:"+host,"cloudfront_distribution","cloudfront","CreateDistributionWithTags",{DistributionConfigWithTags:{DistributionConfig:cfg,Tags:{Items:fg_tags(ctx)}}});
      let cf_domain="d-pending.cloudfront.net";
      if(!fg_pending(dist)) {
        let g=fg_read(o,ctx,"cloudfront","GetDistribution",{Id:fg_last(dist,"/")});
        if(g.ok) {cf_domain=g.data.Distribution.DomainName;}
      }
      for(type in ["A","AAAA"]) {
        fg_ensure(o,ctx,"dns-host:"+host+":"+type,"route53_record","route53","ChangeResourceRecordSets",fg_alias_change(ctx,stack,stack.zone_id,host+".",type,cf_domain+".",stack.cloudfront_zone_id));
      }
    }
  }
}

// Teardown: only what the state file lists, newest first; the host re-checks the live poc tag on every call.
fn fg_teardown(o, ctx, apps, stack) {
  let st=fg_load(ctx.state,{resources:[],records:{}});
  assert(len(st.resources)+len(keys(get(st,"records",{})))>0,"nothing is recorded in "+ctx.state+": nothing to delete");
  let base=apps.cluster;
  // DNS records first (exact live record, content hash checked by the host).
  for(key in keys(get(st,"records",{}))) {
    let parts=split(key,"|");
    let live=fg_read(o,ctx,"route53","ListResourceRecordSets",{HostedZoneId:parts[0],StartRecordName:parts[1],StartRecordType:parts[2],MaxItems:"1"});
    if(live.ok && len(get(live.data,"ResourceRecordSets",[]))>0) {
      fg_update(o,ctx,"delete dns "+parts[1]+" "+parts[2],"route53_record","route53","ChangeResourceRecordSets",{HostedZoneId:parts[0],ChangeBatch:{Changes:[{Action:"DELETE",ResourceRecordSet:live.data.ResourceRecordSets[0]}]}});
    }
  }
  let i=len(st.resources)-1;
  while(i>=0) {
    let e=st.resources[i];
    let name=str(e.name);let arn=str(e.arn);
    if(e.op=="CreateService") {
      fg_update(o,ctx,"scale down "+name,"ecs_service","ecs","UpdateService",{cluster:base,service:name,desiredCount:0});
      fg_update(o,ctx,"delete service "+name,"ecs_service","ecs","DeleteService",{cluster:base,service:name,force:true});
    } else if(e.op=="RegisterTaskDefinition") {
      fg_update(o,ctx,"deregister "+arn,"task_definition","ecs","DeregisterTaskDefinition",{taskDefinition:arn});
    } else if(e.op=="CreateCluster") {
      fg_update(o,ctx,"delete cluster "+name,"ecs_cluster","ecs","DeleteCluster",{cluster:name});
    } else if(e.op=="CreateDistributionWithTags") {
      let id=name;
      let got=fg_read(o,ctx,"cloudfront","GetDistributionConfig",{Id:id});
      if(got.ok) {
        let host=got.data.DistributionConfig.Aliases.Items[0];
        let cfg=fg_distribution(o,ctx,stack,host,"origin-"+host,got.data.DistributionConfig.ViewerCertificate.ACMCertificateArn,false);
        cfg.CallerReference=got.data.DistributionConfig.CallerReference;
        fg_update(o,ctx,"disable distribution "+id,"cloudfront_distribution","cloudfront","UpdateDistribution",{Id:id,IfMatch:got.data.ETag,DistributionConfig:cfg});
        fg_wait(o,ctx,"distribution "+id+" deployed",120,15000,"cloudfront","GetDistribution",{Id:id},"dist_deployed");
        let again=fg_read(o,ctx,"cloudfront","GetDistributionConfig",{Id:id});
        fg_update(o,ctx,"delete distribution "+id,"cloudfront_distribution","cloudfront","DeleteDistribution",{Id:id,IfMatch:again.data.ETag});
      }
    } else if(e.op=="CreateRule") {
      fg_update(o,ctx,"delete rule","listener_rule","elbv2","DeleteRule",{RuleArn:arn});
    } else if(e.op=="CreateListener") {
      fg_update(o,ctx,"delete listener","listener","elbv2","DeleteListener",{ListenerArn:arn});
    } else if(e.op=="CreateLoadBalancer") {
      fg_update(o,ctx,"delete load balancer "+name,"load_balancer","elbv2","DeleteLoadBalancer",{LoadBalancerArn:arn});
      fg_wait(o,ctx,"load balancer deletion",30,10000,"elbv2","DescribeLoadBalancers",{PageSize:1},"any");
    } else if(e.op=="CreateTargetGroup") {
      fg_update(o,ctx,"delete target group "+name,"target_group","elbv2","DeleteTargetGroup",{TargetGroupArn:arn});
    } else if(e.op=="RequestCertificate") {
      fg_update(o,ctx,"delete certificate "+name,"acm_certificate","acm","DeleteCertificate",{CertificateArn:arn});
    } else if(e.op=="CreateSecurityGroup") {
      fg_update(o,ctx,"delete security group "+name,"security_group","ec2","DeleteSecurityGroup",{GroupId:name});
    } else if(e.op=="CreateRole") {
      fg_update(o,ctx,"detach policy "+name,"iam_attachment","iam","DetachRolePolicy",{RoleName:name,PolicyArn:"arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"});
      fg_update(o,ctx,"delete role "+name,"iam_role","iam","DeleteRole",{RoleName:name});
    } else if(e.op=="CreateLogGroup") {
      fg_update(o,ctx,"delete log group "+name,"log_group","logs","DeleteLogGroup",{logGroupName:name});
    } else if(e.op=="CreateRepository") {
      fg_update(o,ctx,"delete repository "+name,"ecr_repository","ecr","DeleteRepository",{repositoryName:name,force:true});
    }
    i=i-1;
  }
}

fn recipe_fargate(options) {
  let o=recipe_normalize(merge(options,{admin_allowed:true}));
  assert(o.apps!="","--apps PATH to the apps registry JSON is required (see fargate/apps.json)");
  assert(o.stack!="","--stack PATH to the stack settings JSON is required (see recipes/fargate_stack.config.json)");
  let apps=json_parse(read_file(o.apps));
  let stack=json_parse(read_file(o.stack));
  let poc=o.poc!="" ? o.poc : (starts_with(apps.cluster,"poc-") ? substr(apps.cluster,4,len(apps.cluster)) : apps.cluster);
  assert(regex_test(poc,"^[a-z0-9][a-z0-9-]{1,40}$"),"--poc must match [a-z0-9][a-z0-9-]{1,40}");
  let state=o.state!="" ? o.state : ".lmaws-local/fargate/"+poc+".state.json";
  let apply=o.apply && o.live && !o.preview;
  if(o.live) {
    assert(o.profile=="admin","the Fargate stack needs --profile admin");assert(getenv("LMAWS_ADMIN_GRANT","")=="1","the Fargate stack needs LMAWS_ADMIN_GRANT=1");
    assert(!contains(state,"..") && regex_test(state,"^[A-Za-z0-9_./~-]+$"),"--state may use letters, digits and _ . / ~ - only");
  }
  stack.template=get(stack,"template","fargate_distribution.template.json");
  let beside=dirname(o.stack)+"/"+fg_last(stack.template,"/");
  if(file_exists(beside)) {stack.template=beside;}
  let steps_file=state+".steps.json";
  let ctx={poc:poc,state:state,apply:apply,rows:[],steps:fg_load(steps_file,{}),steps_file:steps_file,base:apps.cluster,last_td:""};
  let known_td=get(ctx.steps,"task-definition:"+apps.task.family,null);
  if(known_td!=null) {ctx.last_td=known_td.arn;}
  if(o.preview) {
    println(json_stringify({recipe:"fargate_stack",poc:poc,apps:len(apps.apps),state:state,live:o.live,apply:o.apply,down:o.down,preview:true},2));
    println("estimated cost: $0.00");
    return {rows:[],preview:true};
  }
  println((o.down ? "TEARDOWN " : "STACK ")+poc+": "+(apply ? "APPLY" : "PLAN (dry run; pass --live --apply with the admin profile to change AWS)")+", "+str(len(apps.apps))+" app(s)");
  mkdir(dirname(o.output),true);
  if(o.down) {fg_teardown(o,ctx,apps,stack);} else {fg_plan_stack(o,ctx,apps,stack);}
  let report={kind:"fargate_stack",poc:poc,state:state,applied:apply,down:o.down,synthetic:!o.live,rows:ctx.rows,output_file:o.output+".json",result:{stdout:"estimated cost: $0.00"}};
  mkdir(dirname(o.output),true);write_file(o.output+".json",json_stringify(report,2));write_csv(o.output+".csv",ctx.rows);
  return report;
}
