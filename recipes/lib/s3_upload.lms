# Access: Write with default for the conditional PUT; lmaws creates/cleans owned sandboxes.
# What: Import-only offline S3 policy probes and an explicit two-profile upload check.
# When: Verify a changed session document before testing a tiny, non-overwriting upload.
# Run: lmctl recipes/check_s3_upload.lms --policy-file POLICY.json
# Preview: lmctl recipes/check_s3_upload.lms --preview
import "./common.lms";

fn s3_upload_options(argv) {
  let o={profile:"default",file:"",managed_policy:"",own_account:"",bucket:"",key:"probe.txt",run_id:"",allow_leave:false,demo_lifecycle:false,live:false,preview:false,output:"data/check_s3_upload",output_explicit:false};let i=0;
  while(i<len(argv)) {
    let flag=argv[i];
    if(flag=="--live"){o.live=true;}
    else if(flag=="--preview"||flag=="--dry-run"){o.preview=true;}
    else if(flag=="--allow-leave-object"){o.allow_leave=true;}
    else {
      i=i+1;assert(i<len(argv),flag+" needs a value");let v=argv[i];
      if(flag=="--policy-file"||flag=="--file"){o.file=v;}
      else if(flag=="--managed-policy"){o.managed_policy=v;}
      else if(flag=="--account-id"){o.own_account=v;}
      else if(flag=="--bucket"){o.bucket=v;}
      else if(flag=="--key"){o.key=v;}
      else if(flag=="--run-id"){o.run_id=v;}
      else if(flag=="--region"){o.region=v;}
      else if(flag=="--profile"){o.profile=v;}
      else if(flag=="--cap"){o.cap=num(v);}
      else if(flag=="--output"){o.output=v;o.output_explicit=true;}
      else {assert(false,"unknown S3 upload check argument "+flag);}
    }
    i=i+1;
  }
  return recipe_normalize(o);
}
fn s3_upload_fixture_policy() {
  return {Version:"2012-10-17",Statement:[
    {Sid:"UploadToAccountBuckets",Effect:"Allow",Action:["s3:PutObject","s3:AbortMultipartUpload","s3:ListMultipartUploadParts"],Resource:"arn:aws:s3:::*/*",Condition:{StringEquals:{"s3:ResourceAccount":"000000000000"}}},
    {Sid:"DenyS3DeletionAndBucketWrites",Effect:"Deny",Action:["s3:Delete*","s3:CreateBucket","s3:PutBucket*","s3:PutObjectAcl"],Resource:"*"},
    {Sid:"DenyUploadsToOtherAccounts",Effect:"Deny",Action:["s3:PutObject","s3:AbortMultipartUpload"],Resource:"arn:aws:s3:::*/*",Condition:{StringNotEquals:{"s3:ResourceAccount":"000000000000"}}}
  ]};
}
fn s3_upload_account(doc, supplied) {
  if(supplied!=""){assert(regex_test(supplied,"^[0-9]{12}$"),"--account-id must be 12 digits (never printed)");return supplied;}
  let statements=get(json_parse(doc),"Statement",[]);if(!is_array(statements)){statements=[statements];}
  for(statement in statements){let account=get(get(get(statement,"Condition",{}),"StringEquals",{}),"s3:ResourceAccount","");if(is_string(account)&&regex_test(account,"^[0-9]{12}$")){return account;}}
  assert(false,"policy needs an explicit s3:ResourceAccount condition or --account-id for the own-account probe");return "";
}
fn s3_upload_probe_spec(account,bucket,key) {
  let other=account=="111111111111"?"222222222222":"111111111111";let object="arn:aws:s3:::"+bucket+"/"+key;let own={"s3:ResourceAccount":account};let foreign={"s3:ResourceAccount":other};
  return json_stringify([
    {id:"put_own",action:"s3:PutObject",resource:object,context:own,expected:"allowed"},
    {id:"put_foreign",action:"s3:PutObject",resource:object,context:foreign,expected:"explicitDeny"},
    {id:"abort_own",action:"s3:AbortMultipartUpload",resource:object,context:own,expected:"allowed"},
    {id:"abort_foreign",action:"s3:AbortMultipartUpload",resource:object,context:foreign,expected:"explicitDeny"},
    {id:"list_parts_own",action:"s3:ListMultipartUploadParts",resource:object,context:own,expected:"allowed"},
    {id:"delete",action:"s3:DeleteObject",resource:object,context:own,expected:"explicitDeny"},
    {id:"acl",action:"s3:PutObjectAcl",resource:object,context:own,expected:"explicitDeny"},
    {id:"create_bucket",action:"s3:CreateBucket",resource:"arn:aws:s3:::"+bucket,context:own,expected:"explicitDeny"}
  ]);
}
fn recipe_check_s3_upload(options) {
  let o=recipe_normalize(merge({profile:"default",file:"",managed_policy:"",own_account:"",bucket:"",key:"probe.txt",run_id:"",allow_leave:false,demo_lifecycle:false},options));
  assert(o.profile=="default","this recipe checks default; it never accepts admin or another upload identity");
  assert(o.file==""||o.managed_policy=="","choose a policy file or managed policy ARN, not both");
  if(o.preview){return recipe_preview(o,"check_s3_upload");}
  assert(!o.live||o.file!=""||o.managed_policy!="","--live needs an explicit policy file or readable managed policy");
  assert(!o.live||o.region=="us-east-1","live check is bounded to us-east-1");
  assert(!o.live||o.bucket==""||o.allow_leave,"--bucket with --live requires --allow-leave-object");
  if(!o.output_explicit&&(o.file!=""||o.managed_policy!=""||o.live)){o.output=".lmaws-local/check-s3-upload/report";}
  mkdir(dirname(o.output),true);
  let doc=json_stringify(s3_upload_fixture_policy());let result={stdout:"estimated cost: $0.00\n",stderr:"",code:0};
  if(o.file!=""){assert(file_exists(o.file),"policy file not found");doc=read_file(o.file);}
  if(o.managed_policy!="") {
    assert(o.own_account!="","managed-policy probes require --account-id (kept private)");let private_doc=temp_file();
    let getdoc=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.example("check_s3_upload_policy_read");file_write(${private_doc},cloud.policy_document(${o.managed_policy}));
end _dsl_
    let metadata=merge(o,{live:true,apply:false,profile:"default"});result=recipe_run(getdoc,metadata);doc=read_file(private_doc);remove_file(private_doc);
  }
  let account=s3_upload_account(doc,o.own_account);let probe_bucket=o.bucket==""?"lmaws-s3check-probe":o.bucket;let spec=s3_upload_probe_spec(account,probe_bucket,o.key);let raw=temp_file();
  let simulation=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let meter=aws.example("check_s3_upload_policy");check(meter.is_demo());let rows=aws.policy_simulate(${doc},${spec});file_write(${raw},rows.json());
end _dsl_
  let offline=merge(o,{live:false,apply:false,profile:"default"});result=recipe_run(simulation,offline);let evaluated=json_parse(read_file(raw));remove_file(raw);
  let rows=[];let all_expected=true;
  for(probe in evaluated){let passed=str(probe.passed)=="true";if(!passed){all_expected=false;}let row={probe_id:probe.probe_id,action:probe.action,decision:probe.decision,matched_statements:probe.matched_statements,expected:probe.expected,passed:passed,kind:probe.decision=="allowed"?"policy allow":"policy deny",count:1};push(rows,row);println(row.probe_id+" | "+row.decision+" | "+row.matched_statements);}
  println("Policy document simulation only: owner context is supplied; bucket policies, KMS, SCPs and other policy layers can change live authorization.");
  println("Security: the supplied default-session Allow covers every bucket in its account; PutObject can overwrite existing objects without a condition. Restrict buckets/prefixes and require s3:if-none-match. See docs/S3_UPLOAD_CHECK.md.");
  let livecheck={state:"not_run",leftovers:0};let tested=o.live||o.demo_lifecycle;
  if(tested) {
    let run=o.run_id;if(run==""){let clock=str(now());run="c"+substr(clock,0,6)+"a"+substr(clock,6);}
    assert(regex_test(run,"^[a-f0-9]{4,24}$"),"--run-id must be 4..24 hexadecimal digits");
    let key="lmaws-s3check/"+run+".txt";
    if(o.live&&o.bucket!=""){println("WARNING: this leaves one object in the explicitly selected bucket; default cannot delete it. Key: "+key);}
    if(o.live) {
      let journal=".lmaws-local/s3-upload-check/"+run+".json";let live_raw=temp_file();
      let check_upload=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
  let cloud=aws.example("check_s3_upload");check(cloud.is_demo()==${!o.live});let checked=cloud.s3_upload_check(${run},${o.bucket},${o.allow_leave},${journal});file_write(${live_raw},checked.json());
end _dsl_
      let controller=merge(o,{live:o.live,apply:o.live,profile:"lmaws",timeout_ms:300000});result=recipe_run(check_upload,controller);livecheck=json_parse(read_file(live_raw));remove_file(live_raw);
    }else{
      livecheck={state:"clean",demo:"true",leftovers:"0",head_before:"absent",default_put:"passed",present_verified:"true",etag_match:"true",head_after_delete:"absent",bucket_deleted:"true",put_profile:"default",cleanup_profile:"lmaws"};
    }
    for(stage in ["head_before","default_put","present_verified","head_after_delete","bucket_deleted"]){push(rows,{kind:"check "+stage,status:str(get(livecheck,stage,"not_requested")),count:1});}
  }
  let report={synthetic:o.file==""&&o.managed_policy=="",policy_source:o.managed_policy!=""?"managed_policy":(o.file!=""?"provided_file":"synthetic_fixture"),probes_passed:all_expected,rows:rows,live_check:livecheck,live:o.live,output_file:o.output+".json"};
  write_file(report.output_file,json_stringify(report,2));write_csv(o.output+".csv",rows);
  if(tested){println("Upload check state: "+str(get(livecheck,"state","unknown"))+"; leftovers: "+str(get(livecheck,"leftovers","unknown")));if(str(get(livecheck,"object_left","false"))=="true"){println("Object intentionally left; key: "+str(livecheck.key));}if(str(get(livecheck,"first_put_denied","false"))=="true"){println("DENIED: s3:PutObject on "+str(get(livecheck,"denied_resource","selected sandbox object"))+"; no alternate upload identity was tried.");}assert(contains(["clean","left"],str(get(livecheck,"state","unknown"))),"upload verification failed; inspect the private run journal and report; no alternate PUT will be attempted");}
  return merge(report,{result:result});
}

fn recipe_s3_upload_picture(report,name) {
  assert(regex_test(name,"^[a-z][a-z0-9_]*$"));mkdir("images");mkdir("data");let counts={};
  let labels={"policy allow":"Allow own","policy deny":"Deny probes","check head_before":"HEAD absent","check default_put":"PUT guarded","check present_verified":"HEAD verify","check head_after_delete":"DELETE verify","check bucket_deleted":"Bucket gone"};
  for(row in report.rows){let label=get(labels,row.kind,row.kind);let passed=!has_key(row,"status")||contains(["true","absent","passed"],str(row.status));counts[label]=get(counts,label,0)+(passed?1:0);}
  let csv="label,count\n";for(label in keys(counts)){csv=csv+label+","+str(counts[label])+"\n";}write_file("data/"+name+".csv",csv);
  let chart=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/"+name+".png"},900,560);
plot.cmd("set datafile separator ','; set title 'Synthetic: default S3 policy and guarded upload'; unset key; set style data histograms; set style fill solid 0.8; set boxwidth 0.65; set yrange [0:6]; set ytics 1; set ylabel 'Probe/check count'; set grid ytics; set xtics rotate by -15; set bmargin 6");
plot.cmd(${"plot 'data/"+name+".csv' every ::1 using 2:xtic(1) lc rgb '#5db7d1'"});plot.close();
end _dsl_
  let bytecode=temp_file();savedsl(chart,bytecode);let r=system(concat(dsl_cli(chart),["--dsl",bytecode]),120000);remove_file(bytecode);assert(r.code==0);
}
