# Access: Account-level read-only search/plans; delete requires live lmaws profile and apply flag.
# What: Native SDK prefix discovery and ledger-qualified cleanup, not local-ledger-only search.
# When: Locate resources or review old test resources before an explicit cleanup.
# Run: lmctl recipes/prefix_search.lms --prefix lmaws
# Preview: lmctl recipes/sweeper.lms --preview
import "./discovery.lms";
fn recipe_prefix_search(options) {return recipe_discovery(merge(options,{task:"find_lmaws_resources"}));}
fn recipe_leftovers(options) {return recipe_discovery(merge(options,{task:"leftover_report"}));}
fn recipe_sweeper(options) {return recipe_discovery(merge(options,{task:"sweeper"}));}
