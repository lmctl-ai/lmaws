# Access: Write with the admin profile (LMAWS_ADMIN_GRANT=1); synthetic preview by default
# What: Import-only IAM managed-policy lint and grant functions; no provider calls on import.
# When: Lint or update an lmaws_ customer-managed session policy without touching inline 2048-char limits.
# Run: lmctl recipes/grant_session_policy.lms --policy lmaws_session
# Preview: lmctl recipes/grant_session_policy.lms --preview
import "./common.lms";

fn recipe_policy_template() {
  return {
    Version: "2012-10-17",
    Statement: [
      {
        Sid: "Reads",
        Effect: "Allow",
        Action: [
          "sts:GetCallerIdentity",
          "s3:ListAllMyBuckets",
          "ec2:Describe*",
          "sqs:ListQueues",
          "sns:ListTopics",
          "dynamodb:ListTables",
          "logs:DescribeLogGroups",
          "ssm:DescribeParameters",
          "route53:List*",
          "route53:GetHostedZone",
          "route53:GetChange",
          "cloudfront:List*",
          "cloudfront:Get*",
          "acm:ListCertificates",
          "acm:DescribeCertificate",
          "acm:ListTagsForCertificate"
        ],
        Resource: "*"
      },
      {
        Sid: "PublicParams",
        Effect: "Allow",
        Action: "ssm:GetParameter",
        Resource: "arn:aws:ssm:*::parameter/aws/service/*"
      },
      {
        Sid: "NamedTestResources",
        Effect: "Allow",
        Action: ["s3:*", "sqs:*", "sns:*", "dynamodb:*", "ssm:*", "logs:*"],
        Resource: [
          "arn:aws:s3:::lmaws-*",
          "arn:aws:s3:::lmaws-*/*",
          "arn:aws:sqs:*:*:lmaws-*",
          "arn:aws:sqs:*:*:lmaws_*",
          "arn:aws:sns:*:*:lmaws-*",
          "arn:aws:sns:*:*:lmaws_*",
          "arn:aws:dynamodb:*:*:table/lmaws-*",
          "arn:aws:dynamodb:*:*:table/lmaws_*",
          "arn:aws:ssm:*:*:parameter/lmaws-*",
          "arn:aws:ssm:*:*:parameter/lmaws_*",
          "arn:aws:logs:*:*:log-group:lmaws-*",
          "arn:aws:logs:*:*:log-group:lmaws_*"
        ],
        Condition: {StringEquals: {"aws:ResourceAccount": "${aws:PrincipalAccount}"}}
      },
      {
        Sid: "RunTagged",
        Effect: "Allow",
        Action: "ec2:RunInstances",
        Resource: [
          "arn:aws:ec2:*:*:instance/*",
          "arn:aws:ec2:*:*:volume/*",
          "arn:aws:ec2:*:*:network-interface/*",
          "arn:aws:ec2:*:*:spot-instances-request/*"
        ],
        Condition: {Null: {"aws:RequestTag/lmaws_test": "false"}}
      },
      {
        Sid: "Route53Names",
        Effect: "Allow",
        Action: "route53:ChangeResourceRecordSets",
        Resource: "arn:aws:route53:::hostedzone/*",
        Condition: {
          "ForAllValues:StringLike": {
            "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
              "lmaws-*.example.com",
              "_*.lmaws-*.example.com"
            ]
          }
        }
      },
      {
        Sid: "NanoOnly",
        Effect: "Deny",
        Action: "ec2:RunInstances",
        Resource: "arn:aws:ec2:*:*:instance/*",
        Condition: {StringNotEquals: {"ec2:InstanceType": ["t3.nano", "t4g.nano"]}}
      },
      {
        Sid: "SgMustBeTagged",
        Effect: "Deny",
        Action: "ec2:CreateSecurityGroup",
        Resource: "arn:aws:ec2:*:*:security-group/*",
        Condition: {Null: {"aws:RequestTag/lmaws_test": "true"}}
      },
      {
        Sid: "OnlyUsEast1",
        Effect: "Deny",
        NotAction: ["sts:*", "s3:*", "route53:*", "cloudfront:*", "acm:*"],
        Resource: "*",
        Condition: {StringNotEquals: {"aws:RequestedRegion": "us-east-1"}}
      }
    ]
  };
}

fn recipe_policy_document(options) {
  let path = str(get(options, "file", ""));
  if (path != "") {
    assert(file_exists(path));
    return read_file(path);
  }
  return json_stringify(recipe_policy_template(), 2);
}

fn recipe_policy_lint(options) {
  let o = recipe_normalize(options);
  if (o.preview) { return recipe_preview(o, "policy_lint"); }
  o.live = false;
  o.apply = false;
  let output = str(o.output);
  let doc = recipe_policy_document(o);
  let raw = output + ".lint.raw.json";
  let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_policy_lint");
let lint = cloud.iam_policy_lint(${doc});
file_write(${raw}, lint.json());
end _dsl_
  let result = recipe_run(p, o);
  let lint_obj = json_parse(read_file(raw));
  remove_file(raw);
  assert(str(get(lint_obj, "valid", "false")) == "true");
  let statements = json_parse(str(get(lint_obj, "statements", "[]")));
  let rows = [];
  for (stmt in statements) {
    push(rows, {
      sid: str(get(stmt, "sid", "")),
      effect: str(get(stmt, "effect", "")),
      kind: str(get(stmt, "category", "statement")),
      valid: str(get(stmt, "valid", "true")),
      detail: str(get(stmt, "detail", "")),
      count: 1
    });
  }
  let report = {
    valid: str(get(lint_obj, "valid", "false")) == "true",
    compact_length: num(get(lint_obj, "compact_length", "0")),
    max_length: num(get(lint_obj, "max_length", "6144")),
    inline_limit: num(get(lint_obj, "inline_limit", "2048")),
    exceeds_inline_limit: str(get(lint_obj, "exceeds_inline_limit", "false")) == "true",
    version: str(get(lint_obj, "version", "")),
    statement_count: num(get(lint_obj, "statement_count", "0")),
    allow_read_statements: num(get(lint_obj, "allow_read_statements", "0")),
    allow_scoped_statements: num(get(lint_obj, "allow_scoped_statements", "0")),
    deny_statements: num(get(lint_obj, "deny_statements", "0")),
    findings: json_parse(str(get(lint_obj, "findings", "[]"))),
    checks_performed: json_parse(str(get(lint_obj, "checks_performed", "[]"))),
    summary: str(get(lint_obj, "summary", "")),
    synthetic: str(get(o, "file", "")) == "",
    rows: recipe_select(rows, o),
    output_file: output + ".json"
  };
  mkdir(dirname(output), true);
  write_file(output + ".json", json_stringify(report, 2));
  write_csv(output + ".csv", report.rows);
  return merge(report, {result: result});
}

fn recipe_grant_session_policy(options) {
  let o = recipe_normalize(merge(options,{admin_allowed:true}));
  if (o.preview) { return recipe_preview(o, "grant_session_policy"); }
  if (o.apply) {
    assert(o.live);
    assert(o.profile == "admin");
    assert(getenv("LMAWS_ADMIN_GRANT", "") == "1");
  }
  let output = str(o.output);
  let policy_name = str(o.policy);
  let doc = recipe_policy_document(o);
  let put_raw = output + ".put.raw.json";
  let get_raw = output + ".get.raw.json";
  let ver_raw = output + ".versions.raw.json";
  let do_apply = o.live && o.apply;
  let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_grant_session_policy");
let put_res = cloud.iam_policy_put(${policy_name}, ${doc}, ${do_apply});
let get_res = cloud.iam_policy_get(${policy_name});
let ver_rows = cloud.iam_policy_versions(${policy_name});
file_write(${put_raw}, put_res.json());
file_write(${get_raw}, get_res.json());
file_write(${ver_raw}, ver_rows.json());
end _dsl_
  let result = recipe_run(p, o);
  let put_obj = json_parse(read_file(put_raw));
  let get_obj = json_parse(read_file(get_raw));
  let ver_list = json_parse(read_file(ver_raw));
  remove_file(put_raw);
  remove_file(get_raw);
  remove_file(ver_raw);
  let diff_rows = json_parse(str(get(put_obj, "statement_diffs", "[]")));
  let report = {
    policy: policy_name,
    arn: str(get(put_obj, "arn", "")),
    applied: str(get(put_obj, "applied", "false")) == "true",
    action: str(get(put_obj, "action", "dry_run")),
    version_id: str(get(put_obj, "version_id", "")),
    deleted_version_id: str(get(put_obj, "deleted_version_id", "")),
    compact_length: num(get(put_obj, "compact_length", "0")),
    max_length: num(get(put_obj, "max_length", "6144")),
    inline_limit: num(get(put_obj, "inline_limit", "2048")),
    statement_count: num(get(put_obj, "statement_count", "0")),
    lint_valid: str(get(put_obj, "lint_valid", "false")) == "true",
    lint_summary: str(get(put_obj, "lint_summary", "")),
    diff_summary: str(get(put_obj, "diff_summary", "")),
    added_count: num(get(put_obj, "added_count", "0")),
    modified_count: num(get(put_obj, "modified_count", "0")),
    removed_count: num(get(put_obj, "removed_count", "0")),
    unchanged_count: num(get(put_obj, "unchanged_count", "0")),
    policy_exists: str(get(get_obj, "exists", "false")) == "true",
    default_version_id: str(get(get_obj, "default_version_id", "")),
    version_count: num(get(get_obj, "version_count", "0")),
    versions: ver_list,
    synthetic: !o.live,
    rows: recipe_select(diff_rows, o),
    output_file: output + ".json"
  };
  mkdir(dirname(output), true);
  write_file(output + ".json", json_stringify(report, 2));
  write_csv(output + ".csv", report.rows);
  return merge(report, {result: result});
}

fn recipe_session_doctor(options) {
  let o = recipe_normalize(options);
  if (o.preview) { return recipe_preview(o, "session_doctor"); }
  let output = str(o.output);
  let raw = output + ".doctor.raw.json";
  let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("recipe_session_doctor");
let doctor_rows = cloud.session_doctor();
file_write(${raw}, doctor_rows.json());
end _dsl_
  let result = recipe_run(p, o);
  let parsed = json_parse(read_file(raw));
  remove_file(raw);
  let rows = [];
  let profile_rows = [];
  let probe_rows = [];
  let allowed_count = 0;
  let guardrail_deny_count = 0;
  let denied_count = 0;
  for (item in parsed) {
    let row_kind = str(get(item, "kind", "probe"));
    let status = str(get(item, "status", "unknown"));
    if (row_kind == "profile") {
      push(profile_rows, item);
    } else {
      push(probe_rows, item);
      if (status == "allowed") { allowed_count = allowed_count + 1; }
      else if (status == "denied_by_guardrail") { guardrail_deny_count = guardrail_deny_count + 1; }
      else { denied_count = denied_count + 1; }
    }
    push(rows, {
      name: str(get(item, "name", "")),
      profile: str(get(item, "profile", "")),
      session_type: str(get(item, "session_type", "")),
      helper: str(get(item, "helper", "")),
      expiry: str(get(item, "expiry", "")),
      ttl_seconds: num(get(item, "ttl_seconds", "0")),
      method: str(get(item, "method", "")),
      status: status,
      kind: row_kind == "profile" ? "profile_" + status : "probe_" + status,
      detail: str(get(item, "detail", "")),
      count: 1
    });
  }
  let report = {
    active_profile: str(o.profile),
    region: str(o.region),
    profile_count: len(profile_rows),
    probe_count: len(probe_rows),
    allowed_count: allowed_count,
    guardrail_deny_count: guardrail_deny_count,
    denied_count: denied_count,
    profiles: profile_rows,
    probes: probe_rows,
    synthetic: !o.live,
    rows: recipe_select(rows, o),
    output_file: output + ".json"
  };
  mkdir(dirname(output), true);
  write_file(output + ".json", json_stringify(report, 2));
  write_csv(output + ".csv", report.rows);
  return merge(report, {result: result});
}
