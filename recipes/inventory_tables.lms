# Access: Read-only
# What: Inspect bounded tables metadata
# When: Reusable inventory; defaults to synthetic fixtures
# Run: lmctl recipes/inventory_tables.lms --top 10
# Preview: lmctl recipes/inventory_tables.lms --preview (or lmctl script --dry-run recipes/inventory_tables.lms)
# Arguments: --task TASK --period 30 --top 10 --prefix lmaws --region us-east-1 --profile default --output data/inventory_tables [--live]
# Typical-cost: $0.00 displayed; capped request estimate in ledger
# Category: Inventory
# Library: recipes/lib/inventory.lms
# Function: recipe_inventory
# Example: recipe_inventory_tables

import "./lib/inventory.lms";
let options=recipe_options(ARGV);
options.task="tables";
if (!contains(ARGV,"--output")) {options.output="data/inventory_tables";}
let report=recipe_inventory(options);
if (!options.preview) {println("report:",options.output+".json");}
