# Access: Read-only
# What: Find lmaws_ and lmaws- names across supported account inventories
# When: Reusable leftover search and cleanup by prefix; defaults to synthetic fixtures
# Run: lmctl recipes/prefix_search.lms --top 10
# Preview: lmctl recipes/prefix_search.lms --preview (or lmctl script --dry-run recipes/prefix_search.lms)
# Arguments: --task TASK --period 30 --top 10 --prefix lmaws --region us-east-1 --profile default --output data/prefix_search [--live] --ledger-dir .lmaws-local/recipes/ledgers --older-hours 0
# Typical-cost: $0.00 synthetic; live request cap $0.05
# Category: Leftover search and cleanup by prefix
# Library: recipes/lib/prefix.lms
# Function: recipe_prefix_search
# Example: recipe_prefix_search

import "./lib/prefix.lms";
let options=recipe_options(ARGV);
options.task="prefix_search";
if (!contains(ARGV,"--output")) {options.output="data/prefix_search";}
let report=recipe_prefix_search(options);
if (!options.preview) {println("report:",options.output+".json");}
