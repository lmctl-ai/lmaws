  assert(o.profile=="default" || o.profile=="lmaws" || o.profile=="lmaws-ec2" || o.profile=="admin", "--profile must be default (read-only), lmaws (service sandboxes) or lmaws-ec2 (EC2 compute); got "+str(o.profile)+". See docs/PROFILES.md");
  assert(o.profile!="admin" || o.admin_allowed, "the admin profile is only accepted by the IAM grant recipes; use default for read-only recipes");
  assert(regex_test(str(o.policy),"^lmaws_[a-z0-9_-]{1,64}$"), "--policy must match lmaws_[a-z0-9_-]{1,64}; got "+str(o.policy));
  assert(is_number(o.hours) && o.hours>=1 && o.hours<=720 && floor(o.hours)==o.hours, "--hours must be a whole number 1..720; got "+str(o.hours));
  assert(is_number(o.max_gib) && o.max_gib>=1 && o.max_gib<=16384 && floor(o.max_gib)==o.max_gib, "--max-gib must be a whole number 1..16384; got "+str(o.max_gib));
  assert(is_number(o.timeout_ms) && o.timeout_ms>=1000 && o.timeout_ms<=900000, "timeout_ms must be 1000..900000");
  assert(regex_test(str(o.tag_key),"^[A-Za-z0-9_.:/=+@ -]{0,128}$") && regex_test(str(o.tag_value),"^[A-Za-z0-9_.:/=+@ -]{0,256}$"), "--tag-key/--tag-value may use letters, digits, spaces and _ . : / = + @ - only");
  assert(regex_test(str(o.types),"^[a-z0-9]+[.][a-z0-9]+(,[a-z0-9]+[.][a-z0-9]+)*$"), "--types must be comma-separated instance types such as t4g.nano,t3.nano; got "+str(o.types));
  assert(regex_test(str(o.domain),"^[A-Za-z0-9-]+([.][A-Za-z0-9-]+)+$"), "--domain must be a DNS name such as example.com; got "+str(o.domain));
  assert(regex_test(o.region,"^[a-z]{2}(-[a-z]+)+-[0-9]+$"), "--region must look like us-east-1; got "+str(o.region));
  assert(regex_test(o.output,"^[A-Za-z0-9_./: ~-]+$"), "--output may use letters, digits and _ . / : ~ - only");
  assert(is_string(o.prefix) && len(o.prefix)<=128, "--prefix must be a string of at most 128 characters");
  return o;
}
fn recipe_options(argv) {return recipe_options_impl(argv,false);}
fn recipe_grant_options(argv) {return recipe_options_impl(argv,true);}
fn recipe_options_impl(argv,allow_admin) {
  let o={}; let i=0;
  while(i<len(argv)) {
    let key=argv[i];
    if(key=="--live") {o.live=true;}
    else if(key=="--apply" || key=="--delete") {o.apply=true;}
    else if(key=="--i-am-the-admin-human") {o.human_confirmed=true;}
    else if(key=="--preview" || key=="--dry-run") {o.preview=true;}
    else {
      assert(i+1<len(argv), key+" needs a value");i=i+1;let value=argv[i];
      if(key=="--period" || key=="--days") {o.period=num(value);}
      else if(key=="--top" || key=="--top-n") {o.top=num(value);}
      else if(key=="--cap") {o.cap=num(value);o.cap_explicit=true;}
      else if(key=="--older-hours") {o.older_hours=num(value);}
      else if(key=="--prefix") {o.prefix=value;o.filter_prefix=true;}
      else if(key=="--policy" || key=="--policy-name") {o.policy=value;}
      else if(key=="--file" || key=="--policy-file") {o.file=value;}
      else if(key=="--rollback") {o.rollback_file=value;}
      else if(key=="--region") {o.region=value;}
      else if(key=="--profile") {o.profile=value;}
      else if(key=="--output") {o.output=value;o.output_explicit=true;}
      else if(key=="--ledger-dir") {o.ledger_dir=value;}
      else if(key=="--task") {o.task=value;}
      else if(key=="--tag-key") {o.tag_key=value;}
      else if(key=="--tag-value") {o.tag_value=value;}
      else if(key=="--instance") {o.instance=value;}
      else if(key=="--hours") {o.hours=num(value);}
      else if(key=="--types") {o.types=value;}
      else if(key=="--domain") {o.domain=value;}
      else if(key=="--max-gib") {o.max_gib=num(value);}
      else if(key=="--cidr") {o.cidr=value;}
      else if(key=="--from") {o.from_iso=value;}
      else if(key=="--to") {o.to_iso=value;}
      else if(key=="--error") {o.error_text=value;}
      else if(key=="--ledger") {o.ledger_path=value;}
      else if(key=="--probes") {o.probes=value;}
      else {assert(false, "unknown recipe argument "+key+"; the Arguments line at the top of the recipe lists the accepted flags");}
    }
    i=i+1;
  }
  o.admin_allowed=allow_admin;
  return recipe_normalize(o);
}
fn recipe_run(program, options) {
  let o=recipe_normalize(options);
  assert(!o.preview);
  if(o.live) {
    let units=ceil(o.cap*100000000);
    if(recipe_budget.reserved_units+units>25000000) {println("Recipe whole-run cap exceeded; reduce per-recipe caps before another live call.");assert(false);}
    recipe_budget.reserved_units=recipe_budget.reserved_units+units;
  }
  mkdir(dirname(o.output),true);
  let bytecode=temp_file();savedsl(program,bytecode);
  let command=dsl_cli(program);
  let settings={AWS_PROFILE:o.profile,AWS_DEFAULT_PROFILE:o.profile,AWS_REGION:o.region,AWS_DEFAULT_REGION:o.region,LMAWS_LIVE:o.live ? "1":"0",LMAWS_APPLY:o.apply ? "1":"0",LMAWS_SPEND_LIVE:o.live ? "1":"0",LMAWS_MAX_COST_USD:str(o.cap),LMAWS_LEDGER_DIR:o.ledger_dir,LMAWS_EVIDENCE_DIR:".lmaws-local/recipes/evidence"};
  let fleet_config=str(get(o,"fleet_roles_spec",""));
  if(fleet_config!="") {settings.LMAWS_FLEET_ROLES_SPEC=fleet_config;}
  let previous={};
  for(key in keys(settings)) {previous[key]=getenv(key,"");set_env(key,settings[key]);}
  let cli_args=o.apply ? ["--apply","--dsl",bytecode] : ["--dsl",bytecode];
  if(!o.live) {cli_args=concat(["--dry-run"],cli_args);}
  let argv=concat(command,cli_args);
  if(getenv("OS","")!="Windows_NT") {let pre=["env"];for(key in keys(settings)) {push(pre,key+"="+str(settings[key]));}argv=concat(pre,argv);}
  else if(o.live) {for(key in keys(settings)) {if(getenv(key,"")!=str(settings[key])) {println("Live recipes on Windows: set "+key+"="+str(settings[key])+" in the parent environment first.");assert(false);}}}
  let r=system(argv,{timeoutMs:o.timeout_ms});
  for(key in keys(previous)) {set_env(key,previous[key]);}
  remove_file(bytecode);
  if(r.code!=0) {println("Recipe host failed; see the host's sanitized diagnostic.");println(r.stderr);}
  let found=false;
  for(line in lines(r.stdout)) {
    if(starts_with(line,"Cost Explorer requests:") || starts_with(line,"CloudWatch metric requests:") || starts_with(line,"CloudWatch metric units:") || starts_with(line,"IAM policy lint:") || starts_with(line,"IAM policy diff") || starts_with(line,"  + ") || starts_with(line,"  ~ ") || starts_with(line,"  - ") || starts_with(line,"  = ")) {println(line);}
    if(starts_with(line,"estimated cost: $")) {println(line);found=true;}
  }
  if(!found && r.code!=0) {println("estimated cost: $"+str(o.cap)+" (reserved upper bound; host receipt unavailable)");}
  assert(r.code==0, "the lmaws host failed (exit "+str(r.code)+"); its message is printed above. See docs/TROUBLESHOOTING.md");
  assert(found, "the lmaws host printed no cost receipt; check that the installed lmaws release matches this recipe");
  return r;
}
fn recipe_preview(options,task) {
  let o=recipe_normalize(options);
  println(json_stringify({task:task,region:o.region,profile:o.profile,prefix:o.prefix,period:o.period,top:o.top,live:o.live,apply:o.apply,preview:true},2));
  println("estimated cost: $0.00");
  return {rows:[],preview:true};
}
fn recipe_select(rows,options) {
  let o=recipe_normalize(options);let selected=[];
  for(row in rows) {
    if(len(selected)<o.top) {push(selected,row);}
  }
  return selected;
}
fn recipe_cost_line(report) {
  let answer="estimated cost: $0.00";
  let result=get(report,"result",{});
  for(line in lines(str(get(result,"stdout","")))) {
    if(starts_with(line,"estimated cost: $")) {answer=line;}
  }
  return answer;
}
fn recipe_picture(rows,title,name) {
  assert(regex_test(name,"^[a-z][a-z0-9_]*$"));
  mkdir("images");mkdir("data");
  let counts={};let max_count=1;
  for(row in rows) {
    let label=str(get(row,"kind",get(row,"task","matching resources")));
    label=replace_all(label,"_"," ");
    label=regex_replace(label,"[^A-Za-z0-9 .-]","","g");
    counts[label]=get(counts,label,0)+1;
    if(counts[label]>max_count) {max_count=counts[label];}
  }
  let data="label,count\n";
  for(label in keys(counts)) {data=data+label+","+str(counts[label])+"\n";}
  if(len(rows)==0) {data=data+"no matches,0\n";}
  let chart_title="Synthetic: "+regex_replace(str(title),"[^A-Za-z0-9 ,.:()/+-]","","g");
  if(len(chart_title)>80) {chart_title=substr(chart_title,0,77)+"...";}
  write_file("data/"+name+".csv",data);
  let chart=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/"+name+".png"},900,560);
plot.cmd(${"set datafile separator ','; set title '"+chart_title+"'; unset key; set style data histograms; set style fill solid 0.8; set boxwidth 0.6; set yrange [0:"+str(max_count+1)+"]; set ytics 1; set ylabel 'count of resources'; set grid ytics; set xtics rotate by -30"});
plot.cmd(${"plot 'data/"+name+".csv' every ::1 using 2:xtic(1) lc rgb '#5db7d1'"});
plot.close();
end _dsl_
  let code=temp_file();savedsl(chart,code);let r=system(concat(dsl_cli(chart),["--dsl",code]),{timeoutMs:120000});remove_file(code);assert(r.code==0);
  println("images/"+name+".png");
}


fn _spend_topic(options) {
  let task = str(get(options, "task", "spend_detail"));
  if (task == "spend_detail" || task == "all") { return "all"; }
  assert(contains(["ec2_spend","savings_plans","eip_audit","ebs_audit","bandwidth","lambda_spend","dynamodb_spend"], task));
  return task;
}

fn _spend_output(options, topic) {
  let requested = str(get(options, "output", "data/spend/" + topic));
  if (get(options, "live", false)) {
    if(!starts_with(requested,".lmaws-local/spend/") && !get(options,"output_explicit",false)) {requested=".lmaws-local/spend/recipes/"+topic;}
    assert(starts_with(requested, ".lmaws-local/spend/"));
  }
  mkdir(requested, true);
  return requested;
}

fn recipe_spend(options) {
  let o = recipe_normalize(options);
  if(!o.cap_explicit) {o.cap=0.25;}
  let topic = _spend_topic(o);
  if (o.preview) { return recipe_preview(o, topic); }
  assert(o.top<=100);
  if (o.live) { assert(o.profile == "default", "live spend reports use --profile default (read-only billing data)"); }
  let output = _spend_output(o, topic);
  let program = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let spend = aws.spend(${topic}, ${o.period}, ${o.top}, ${o.cap});
spend.write(${output});
end _dsl_
  let result = recipe_run(program, o);
  let report = json_parse(read_file(output + "/report.json"));
  let sections = get(report, "sections", {});
  let rows = get(sections, topic, get(sections, "services", []));
  if (!is_array(rows)) { rows = []; }
  return {"topic":topic,"period":o.period,"top":o.top,"cap":o.cap,"profile":o.profile,"live":o.live,"synthetic":!o.live,"output":output,"output_file":output+"/report.json","rows":rows,"report":report,"result":result};
}

fn recipe_spend_picture(report, name) {
  assert(!get(report, "live", false));
  assert(get(get(report,"report",{}),"metadata.mode","")=="synthetic");
  assert(regex_test(name,"^[a-z][a-z0-9_]*$"));
  let output = str(get(report, "output", "data/spend/all"));
  let chart = output + "/topic_chart.csv";
  assert(file_exists(chart));
  mkdir("images");mkdir("data");copy_file(chart,"data/"+name+".csv");
  let units=report.topic=="savings_plans" ? "coverage (%)":"USD (see report period)";
  let low=0;let high=1;
  for(row in read_csv(chart)) {let value=num(get(row,"value","0"));if(value<low) {low=value;}if(value>high) {high=value;}}
  let range="["+str(low<0 ? low*1.1:0)+":"+str(high*1.15)+"]";
  if(report.topic=="savings_plans") {range="[0:100]";}
  let title="Synthetic spend: "+replace_all(report.topic,"_"," ");
  let plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${"images/" + name + ".png"}, 900, 560);
plot.cmd(${"set datafile separator ','; set title '"+title+"'; set ylabel '"+units+"'; set yrange "+range+"; unset key; set xtics rotate by -30; set bmargin 8; set style data histograms; set style fill solid 0.8; set grid ytics"});
plot.cmd(${"plot '" + chart + "' using 2:xtic(1) lc rgb '#5db7d1'"});
plot.close();
end _dsl_
  let path = temp_file(); savedsl(plot, path);
  let r = system(concat(dsl_cli(plot), ["--dsl", path]), {timeoutMs:120000});
  remove_file(path); assert(r.code == 0);
  println("images/" + name + ".png");
  return "images/" + name + ".png";
}


let options=recipe_options(ARGV);
options.task="lambda_spend";
if (!contains(ARGV,"--output")) {options.output="data/lambda_spend";}
let report=recipe_spend(options);
if (!options.preview) {println("report:",get(report,"output_file",options.output+".json"));println(recipe_cost_line(report));}
