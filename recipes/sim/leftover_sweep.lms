# Access: Write with the lmaws profile (native lmaws host against awssim with EC2 enabled; prefix discovery queries EC2 tags)
# What: Leftover hygiene: untracked lmaws-prefixed resources are discovered, the sweep plan explains why they are not deletable without run-ledger proof, an applied sweep refuses them, and the owner removes them explicitly
# When: Building the cleanup job that runs after failed deploys or crashed test runs
# Emulator: awssim started with FLOCI_SERVICES_EC2_ENABLED=true (default endpoint http://127.0.0.1:4567); the untracked resources are created through the shared lmcloud schema
# Run: lmscript recipes/sim/leftover_sweep.lms --endpoint http://127.0.0.1:4567
# Arguments: --endpoint URL --host PATH --cloud-host PATH --run ID --out DIR
# Cleanup: the recipe deletes the untracked bucket and queue itself after the sweep has refused them
import "./lib/common.lms";

o = sim_options("leftover_sweep", {endpoint: {type: "string", default: getenv("AWSSIM_EC2_ENDPOINT", "http://127.0.0.1:4567"), description: "awssim origin with EC2 enabled"}}, "usage: leftover_sweep.lms [--endpoint URL] [--host PATH] [--cloud-host PATH]");
prefix = "lmaws-sim-orphan-" + o.run;
orphan_bucket = prefix + "-site";
orphan_queue = prefix + "-jobs";
sweep_raw = o.out + "/sweep.json";

orphan = _lmcode_ schema="../../schema/lmcloud.dsl.json";
  cloud.set_endpoint("all", ${o.endpoint});
  lmcode_return_put("bucket", cloud.bucket_create(${orphan_bucket}));
  lmcode_return_put("queue", cloud.queue_create(${orphan_queue}));
end _lmcode_
created = sim_run(orphan, aws_cloud_command(o)).result;
assert(created.bucket && created.queue, "the untracked bucket and queue must be created");

sweep = _lmcode_ cli="lmaws";
let cloud = aws.region("us-east-1");
let found = cloud.find_prefix(${prefix});
let plan = cloud.leftovers(${prefix}, 0);
let applied = cloud.cleanup_prefix(${prefix}, 0, true);
let after = cloud.find_prefix(${prefix});
file_write(${sweep_raw}, "{\"found\":" + found.json() + ",\"plan\":" + plan.json() + ",\"applied\":" + applied.json() + ",\"after\":" + after.json() + "}");
end _lmcode_
sim_run(sweep, aws_native_command(o, "lmaws"));
sw = sim_read_json(sweep_raw);

remove = _lmcode_ schema="../../schema/lmcloud.dsl.json";
  cloud.set_endpoint("all", ${o.endpoint});
  lmcode_return_put("bucket", cloud.bucket_delete(${orphan_bucket}));
  lmcode_return_put("queue", cloud.queue_delete(${orphan_queue}));
end _lmcode_
removed = sim_run(remove, aws_cloud_command(o)).result;

found_names = pluck(sw.found, "name");
assert(contains(found_names, orphan_bucket) && contains(found_names, orphan_queue), "prefix discovery must see both untracked resources: " + json_stringify(found_names));
assert(len(sw.plan) == 2 && len(sw.applied) == 2, "the plan and the applied sweep must cover both resources");
for (row in concat(sw.plan, sw.applied)) {
  assert(getstr(row, "eligible_for_delete") == "false" && getstr(row, "lmaws_test") == "false", "resources without a run ledger must never be eligible: " + json_stringify(row));
}
assert(len(sw.after) == 2, "the applied sweep must leave untracked resources untouched");
assert(removed.bucket && removed.queue, "the owner must still be able to remove them explicitly");
println("discovered: " + join(found_names, ", "));
println("sweep refused both: " + getstr(sw.applied[0], "reason"));
println("owner removed them through the lmcloud schema");
sim_report(o, {endpoint: o.endpoint, host: "lmaws + lmaws cloud", prefix: prefix, sweep: sw, removed: removed});
sim_pass(o);
