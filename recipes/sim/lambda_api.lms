# Access: Write with the lmaws profile (native lmaws host against awssim)
# What: Serverless API pieces for a site: create a Lambda from inline source, give it a function URL, wire an S3 upload notification and a scheduled EventBridge rule, inventory, delete
# When: Prototyping a contact-form or thumbnail handler without a real account (invocation needs a Docker-backed emulator and is not attempted)
# Emulator: awssim (Lambda control plane, S3, EventBridge) on http://127.0.0.1:4566
# Run: lmscript recipes/sim/lambda_api.lms
# Arguments: --endpoint URL --host PATH --run ID --out DIR
# Cleanup: rule, function, bucket and ledger-owned resources are deleted
import "./lib/common.lms";

o = sim_options("lambda_api", {}, "usage: lambda_api.lms [--endpoint URL] [--host PATH]");
fn_name = "lmaws_" + o.run + "_contact";
fn_arn = "arn:aws:lambda:us-east-1:000000000000:function:" + fn_name;
source = "import json\n\ndef handler(event, context):\n    return {\"statusCode\": 200, \"headers\": {\"content-type\": \"application/json\"}, \"body\": json.dumps({\"ok\": True, \"run\": \"" + o.run + "\"})}\n";
raw = o.out + "/lambda.json";

program = _lmcode_ cli="lmaws";
let cloud = aws.region("us-east-1");
let run = cloud.run(${o.run}, ${o.out + "/ledgers"});
let api = cloud.lambda_function(${fn_name}, "lmaws_lambda_exec", "python3.12", "handler.handler", ${source}, 128, 10, ${o.run});
let active = api.wait_active(30);
let url = api.url("site contact form API; bounded scenario with explicit teardown");
let uploads = run.bucket("uploads");
let notification = cloud.s3_notification(uploads.get("name"), ${fn_arn}, "s3:ObjectCreated:*", ${o.run});
let rule = cloud.event_rule(${"lmaws_" + o.run + "_digest"}, "rate(5 minutes)", ${o.run});
let target = rule.target(${fn_arn});
let rule_status = rule.status();
let functions = cloud.functions();
let rule_deleted = rule.delete();
let fn_deleted = api.delete();
run.cleanup();
check(run.remaining() == 0);
file_write(${raw}, "{\"function\":" + api.status().json() + ",\"active\":" + active.json() + ",\"url\":\"" + url + "\",\"notification\":" + notification.json() + ",\"target\":" + target.json() + ",\"rule\":" + rule_status.json() + ",\"functions_before_delete\":" + functions.json() + ",\"rule_deleted\":" + rule_deleted.json() + ",\"function_deleted\":" + fn_deleted.json() + "}");
end _lmcode_

sim_run(program, aws_native_command(o, "lmaws"));
l = sim_read_json(raw);
assert(getstr(l, "active.state") == "Active", "the function must become Active on the emulator");
assert(starts_with(l.url, "http"), "a function URL must be issued: " + l.url);
assert(getstr(l, "notification.state") == "active" && getstr(l, "notification.event") == "s3:ObjectCreated:*", "the upload notification must be attached");
assert(len(filter_by(l.functions_before_delete, "name", fn_name)) == 1, "the function inventory must list the new function");
println(fn_name + " active; URL " + l.url);
println("S3 ObjectCreated -> Lambda on " + getstr(l, "notification.bucket") + "; schedule " + getstr(l, "rule.schedule", "rate(5 minutes)") + " -> Lambda; everything deleted");
sim_report(o, {endpoint: o.endpoint, host: "lmaws", lambda: l});
sim_pass(o);
