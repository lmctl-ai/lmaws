# Access: Write with the lmaws profile (native lmaws host against awssim)
# What: Job queue with a dead-letter queue: owned queues, redrive policy (maxReceiveCount 3), inventory, redrive removal
# When: Hardening background processing for a web site so poison messages stop retrying forever
# Emulator: awssim (SQS) on http://127.0.0.1:4566
# Run: lmscript recipes/sim/sqs_dead_letter.lms
# Arguments: --endpoint URL --host PATH --run ID --out DIR
# Cleanup: run.cleanup() deletes both queues
import "./lib/common.lms";

o = sim_options("sqs_dead_letter", {}, "usage: sqs_dead_letter.lms [--endpoint URL] [--host PATH]");
raw = o.out + "/redrive.json";

program = _lmcode_ cli="lmaws";
let cloud = aws.region("us-east-1");
let run = cloud.run(${o.run}, ${o.out + "/ledgers"});
let jobs = run.queue("jobs");
let dlq = run.queue("jobs-dlq");
let redrive = cloud.sqs_redrive(jobs.get("id"), dlq.get("id"), ${o.run});
let queues = cloud.queues();
let cleared = cloud.sqs_redrive_clear(jobs.get("id"), ${o.run});
run.cleanup();
check(run.remaining() == 0);
file_write(${raw}, "{\"jobs\":" + jobs.json() + ",\"dlq\":" + dlq.json() + ",\"redrive\":" + redrive.json() + ",\"queues_before_cleanup\":" + queues.json() + ",\"cleared\":" + cleared.json() + "}");
end _lmcode_

sim_run(program, aws_native_command(o, "lmaws"));
d = sim_read_json(raw);
assert(getstr(d, "redrive.state") == "active" && getstr(d, "redrive.max_receive_count") == "3", "redrive policy must be active with maxReceiveCount 3");
assert(getstr(d, "cleared.state") == "cleared", "redrive policy must be removable");
assert(len(d.queues_before_cleanup) >= 2, "both queues must appear in the inventory");
println(d.jobs.name + " -> " + d.dlq.name + " after " + getstr(d, "redrive.max_receive_count") + " receives; policy cleared; queues deleted");
sim_report(o, {endpoint: o.endpoint, host: "lmaws", redrive: d});
sim_pass(o);
