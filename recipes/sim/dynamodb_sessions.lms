# Access: Write with the lmaws profile (native lmaws host against awssim)
# What: Web session store on DynamoDB: owned table, put items, conditional create-once writes, TTL expiry attribute, table inventory
# When: Choosing a serverless session or cart store for a site before writing application code
# Emulator: awssim (DynamoDB) on http://127.0.0.1:4566
# Run: lmscript recipes/sim/dynamodb_sessions.lms
# Arguments: --endpoint URL --host PATH --run ID --out DIR
# Cleanup: run.cleanup() deletes the table
import "./lib/common.lms";

o = sim_options("dynamodb_sessions", {}, "usage: dynamodb_sessions.lms [--endpoint URL] [--host PATH]");
raw = o.out + "/sessions.json";
session_json = json_stringify({user: "ann", cart: ["sku-1", "sku-2"], issued: strftime(now(), "%Y-%m-%dT%H:%M:%SZ")});

program = _lmcode_ cli="lmaws";
let cloud = aws.region("us-east-1");
let run = cloud.run(${o.run}, ${o.out + "/ledgers"});
let table = run.table("sessions");
let name = table.get("name");
let ttl = cloud.dynamodb_ttl(name, "expires_at", ${o.run});
let first = cloud.dynamodb_item(name, "sess-ann", ${session_json}, ${o.run});
let second = cloud.dynamodb_item(name, "sess-bob", "{\"user\":\"bob\"}", ${o.run});
let create_once = cloud.dynamodb_item_conditional(name, "sess-carol", "{\"user\":\"carol\"}", "attribute_not_exists(pk)", ${o.run});
let update_existing = cloud.dynamodb_item_conditional(name, "sess-ann", "{\"user\":\"ann\",\"cart\":[]}", "attribute_exists(pk)", ${o.run});
let tables = cloud.tables();
run.cleanup();
check(run.remaining() == 0);
file_write(${raw}, "{\"table\":" + table.json() + ",\"ttl\":" + ttl.json() + ",\"items\":[" + first.json() + "," + second.json() + "," + create_once.json() + "," + update_existing.json() + "],\"tables_before_cleanup\":" + tables.json() + "}");
end _lmcode_

sim_run(program, aws_native_command(o, "lmaws"));
s = sim_read_json(raw);
assert(getstr(s, "ttl.enabled") == "true" && getstr(s, "ttl.attribute") == "expires_at", "TTL must be enabled on expires_at");
assert(len(s.items) == 4 && s.items[2].condition == "attribute_not_exists(pk)" && s.items[3].condition == "attribute_exists(pk)", "conditional writes must be recorded");
assert(len(filter_by(s.tables_before_cleanup, "name", s.table.name)) == 1, "the table inventory must list the owned table");
println("session table " + s.table.name + ": 2 plain items, 1 create-once item, 1 guarded update, TTL on expires_at; table removed");
sim_report(o, {endpoint: o.endpoint, host: "lmaws", sessions: s});
sim_pass(o);
