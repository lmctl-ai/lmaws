# Access: Read-only with the default profile (native lmaws host against awssim)
# What: One read-only snapshot of every supported inventory on the emulator, as JSON and a per-service count CSV
# When: Before and after a sandbox run, or to check what an emulator seeded with --data-dir still holds
# Emulator: awssim on http://127.0.0.1:4566 (EC2 inventories need FLOCI_SERVICES_EC2_ENABLED=true, see ec2_fleet_inventory.lms)
# Run: lmscript recipes/sim/inventory_snapshot.lms
# Arguments: --endpoint URL --host PATH --out DIR
# Cleanup: nothing is created
import "./lib/common.lms";

o = sim_options("inventory_snapshot", {}, "usage: inventory_snapshot.lms [--endpoint URL] [--host PATH]");
raw = o.out + "/inventory.json";

program = _lmcode_ cli="lmaws";
let cloud = aws.region("us-east-1");
check(!cloud.is_demo());
file_write(${raw}, "{\"identity\":" + cloud.identity().json() + ",\"buckets\":" + cloud.buckets().json() + ",\"queues\":" + cloud.queues().json() + ",\"topics\":" + cloud.topics().json() + ",\"tables\":" + cloud.tables().json() + ",\"functions\":" + cloud.functions().json() + ",\"log_groups\":" + cloud.log_groups().json() + ",\"parameters\":" + cloud.parameters().json() + ",\"secrets\":" + cloud.secrets().json() + ",\"roles\":" + cloud.roles().json() + ",\"alarms\":" + cloud.alarms().json() + ",\"zones\":" + cloud.zones().json() + ",\"clusters\":" + cloud.clusters().json() + "}");
end _lmcode_

sim_run(program, aws_native_command(o, "default"));
inv = sim_read_json(raw);
counts = [];
for (kind in keys(inv)) { push(counts, {service: kind, count: len(inv[kind])}); }
write_csv(o.out + "/inventory_counts.csv", counts);
for (row in counts) { println(pad_end(row.service, 14) + str(row.count)); }
assert(len(inv.identity) == 1, "STS must answer with one caller identity");
println("account " + getstr(inv.identity[0], "id") + " on " + o.endpoint + "; counts in " + o.out + "/inventory_counts.csv");
sim_report(o, {endpoint: o.endpoint, host: "lmaws", counts: counts, inventory: inv});
sim_pass(o);
