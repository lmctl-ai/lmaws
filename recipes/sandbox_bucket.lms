# Access: Write with the lmaws profile
# What: Create and tear down one owned bucket with its run ledger
# When: Reusable safe lifecycle sandboxes; defaults to synthetic fixtures
# Run: lmctl recipes/sandbox_bucket.lms --top 10
# Preview: lmctl recipes/sandbox_bucket.lms --preview (or lmctl script --dry-run recipes/sandbox_bucket.lms)
# Arguments: --task TASK --period 30 --top 10 --prefix lmaws --region us-east-1 --profile lmaws --output data/sandbox_bucket [--live] [--apply]
# Typical-cost: Synthetic $0.00; live generally below $0.0001; cap $0.05
# Category: Safe lifecycle sandboxes
# Library: recipes/lib/lifecycle.lms
# Function: recipe_lifecycle
# Example: recipe_sandbox_bucket

import "./lib/lifecycle.lms";
let options=recipe_options(ARGV);
options.task="bucket";
if (!contains(ARGV,"--output")) {options.output="data/sandbox_bucket";}
let report=recipe_lifecycle(options);
if (!options.preview) {println("report:",options.output+".json");}
