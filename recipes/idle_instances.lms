# Access: Read-only
# What: Flag stopped-instance state for further review; never delete
# When: Reusable idle and waste detection; defaults to synthetic fixtures
# Run: lmctl recipes/idle_instances.lms --top 10
# Preview: lmctl recipes/idle_instances.lms --preview (or lmctl script --dry-run recipes/idle_instances.lms)
# Arguments: --task TASK --period 30 --top 10 --prefix lmaws --region us-east-1 --profile default --output data/idle_instances [--live]
# Typical-cost: $0.00 displayed; request cap $0.05
# Category: Idle and waste detection
# Library: recipes/lib/audits.lms
# Function: recipe_idle
# Example: recipe_idle_instances

import "./lib/audits.lms";
let options=recipe_options(ARGV);
options.task="idle_instances";
if (!contains(ARGV,"--output")) {options.output="data/idle_instances";}
let report=recipe_idle(options);
if (!options.preview) {println("report:",options.output+".json");}
