# Access: Write with the lmaws profile
# What: Select a disposable queue/topic/table/bucket/parameter/log-group lifecycle
# When: Reusable safe lifecycle sandboxes; defaults to synthetic fixtures
# Run: lmctl recipes/lifecycle.lms --task queue --top 10
# Preview: lmctl recipes/lifecycle.lms --preview (or lmctl script --dry-run recipes/lifecycle.lms)
# Arguments: --task TASK --period 30 --top 10 --prefix lmaws --region us-east-1 --profile lmaws --output data/lifecycle [--live] [--apply]
# Typical-cost: Synthetic $0.00; live generally below $0.0001; cap $0.05
# Category: Safe lifecycle sandboxes
# Library: recipes/lib/lifecycle.lms
# Function: recipe_lifecycle
# Example: recipe_lifecycle

import "./lib/lifecycle.lms";
let options=recipe_options(ARGV);
if (!contains(ARGV,"--task")) {options.task="queue";}
if (!contains(ARGV,"--output")) {options.output="data/lifecycle";}
let report=recipe_lifecycle(options);
if (!options.preview) {println("report:",options.output+".json");}
