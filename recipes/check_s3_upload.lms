# Preview: lmctl recipes/check_s3_upload.lms --preview
# Arguments: --policy-file POLICY.json [--bucket NAME --key KEY] [--managed-policy ARN --account-id ID] [--live --run-id HEX] [--allow-leave-object] [--cap 0.05] [--output PRIVATE_PATH]
# Typical-cost: $0.00 offline; tiny live S3 request estimate, cap $0.05
# Category: Identity and access posture
# Library: recipes/lib/s3_upload.lms
# Function: recipe_check_s3_upload
# Example: recipe_check_s3_upload
# Generated standalone entry; reusable source: recipes/lib/s3_upload.lms
