      let controller=merge(o,{live:o.live,apply:o.live,profile:"lmaws",timeout_ms:300000});result=recipe_run(check_upload,controller);livecheck=json_parse(read_file(live_raw));remove_file(live_raw);
    }else{
      livecheck={state:"clean",demo:"true",leftovers:"0",head_before:"absent",default_put:"passed",present_verified:"true",etag_match:"true",head_after_delete:"absent",bucket_deleted:"true",put_profile:"default",cleanup_profile:"lmaws"};
    }
