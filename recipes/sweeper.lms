# Access: Read-only
# What: Dry-run leftover review; discovery never authorizes deletion
# When: Reusable leftover search and cleanup by prefix; defaults to synthetic fixtures
# Run: lmctl recipes/sweeper.lms --top 10
# Preview: lmctl recipes/sweeper.lms --preview (or lmctl script --dry-run recipes/sweeper.lms)
# Arguments: --task TASK --period 30 --top 10 --prefix lmaws --region us-east-1 --profile default --output data/sweeper [--live] --ledger-dir .lmaws-local/recipes/ledgers --older-hours 0
# Typical-cost: $0.00 synthetic; live request cap $0.05
# Category: Leftover search and cleanup by prefix
# Library: recipes/lib/prefix.lms
# Function: recipe_sweeper
# Example: recipe_sweeper

import "./lib/prefix.lms";
let options=recipe_options(ARGV);
options.task="sweeper";
if (!contains(ARGV,"--output")) {options.output="data/sweeper";}
let report=recipe_sweeper(options);
if (!options.preview) {println("report:",options.output+".json");}
