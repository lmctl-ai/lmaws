# Generated by compare/generate.py. Uses Python 3, curl and AWS CLI for independent verification.
write_file("comparison-main.tf", "terraform {\n  required_version = \">= 1.6.0\"\n  required_providers {\n    aws = {\n      source  = \"hashicorp/aws\"\n      version = \"= 5.100.0\"\n    }\n  }\n}\nprovider \"aws\" { region = \"us-east-1\" }\ndata \"aws_dynamodb_tables\" \"all\" {}\noutput \"example_id\" { value = \"buckets\" }\noutput \"estimated_cost\" { value = \"$0.00\" }\noutput \"resource_count\" { value = length(data.aws_dynamodb_tables.all.names) }\noutput \"comparison_note\" { value = \"AWS provider 5.100.0 has no aws_s3_buckets or SSM parameter-list data source; only DynamoDB portion is represented.\" }\n\noutput \"comparison\" { value = { buckets = null, parameters = null, tables = length(data.aws_dynamodb_tables.all.names) } }\n");
if (env("LMAWS_COMPARE_RUNTIME") != null && env("LMAWS_COMPARE_RUNTIME") != "") { write_file("compare-runtime.py", read_file(env("LMAWS_COMPARE_RUNTIME"))); } else {
download = system(["curl", "--fail", "--location", "--silent", "--show-error", "--max-time", "45", "https://raw.githubusercontent.com/lmctl-ai/lmaws/main/compare/runtime.py"], 60000);
assert(download.code == 0);
write_file("compare-runtime.py", download.stdout);
}
if (env("LMAWS_COMPARE_VERIFIER") != null && env("LMAWS_COMPARE_VERIFIER") != "") { write_file("verify_absence.py", read_file(env("LMAWS_COMPARE_VERIFIER"))); } else {
